{% doc %}
  @prompt
    create a text content section for following content"Freshness with a Purpose
    
    At Gulf Fruits, we believe in delivering more than just fruits and vegetables — we deliver care, hope, and togetherness. This October, Breast Cancer Awareness Month, every box we send carries a message of strength and early detection.
    
    🌸 Why Breast Cancer Awareness Matters
    
    Breast cancer affects millions of women worldwide, and early detection can save lives. By spreading awareness, we stand united in supporting women, families, and communities in the fight against breast cancer." make it high standard design mobile responsive

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-text-content-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-text-content-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-text-content-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    line-height: 1.2;
    margin: 0;
    font-family: inherit;
  }

  .ai-text-content-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    font-weight: {{ block.settings.subheading_weight }};
    color: {{ block.settings.subheading_color }};
    line-height: 1.4;
    margin: 0;
    font-family: inherit;
  }

  .ai-text-content-body-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    line-height: {{ block.settings.line_height }};
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-text-content-body-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px 0;
  }

  .ai-text-content-body-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-text-content-highlight-{{ ai_gen_id }} {
    background-color: {{ block.settings.highlight_background }};
    color: {{ block.settings.highlight_text_color }};
    padding: {{ block.settings.highlight_padding }}px;
    border-radius: {{ block.settings.highlight_border_radius }}px;
    border-left: 4px solid {{ block.settings.highlight_accent_color }};
    margin: {{ block.settings.content_spacing }}px 0;
  }

  .ai-text-content-highlight-icon-{{ ai_gen_id }} {
    display: inline-block;
    margin-right: 8px;
    font-size: 1.2em;
  }

  @media screen and (max-width: 768px) {
    .ai-text-content-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.7 }}px 16px;
    }

    .ai-text-content-wrapper-{{ ai_gen_id }} {
      gap: {{ block.settings.content_spacing | times: 0.8 }}px;
    }

    .ai-text-content-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.85 }}px;
    }

    .ai-text-content-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }

    .ai-text-content-body-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size | times: 0.95 }}px;
    }

    .ai-text-content-highlight-{{ ai_gen_id }} {
      padding: {{ block.settings.highlight_padding | times: 0.8 }}px;margin: {{ block.settings.content_spacing | times: 0.8 }}px 0;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-text-content-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 12px;
    }

    .ai-text-content-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.75 }}px;
    }

    .ai-text-content-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }
  }
{% endstyle %}<div class="ai-text-content-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-text-content-wrapper-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-text-content-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.body_text != blank %}
      <div class="ai-text-content-body-{{ ai_gen_id }}">
        {{ block.settings.body_text }}
      </div>
    {% endif %}

    {% if block.settings.show_highlight and block.settings.highlight_text != blank %}
      <div class="ai-text-content-highlight-{{ ai_gen_id }}">
        {% if block.settings.highlight_icon != blank %}
          <span class="ai-text-content-highlight-icon-{{ ai_gen_id }}">
            {{ block.settings.highlight_icon }}
          </span>
        {% endif %}
        {% if block.settings.highlight_subheading != blank %}
          <h3 class="ai-text-content-subheading-{{ ai_gen_id }}">
            {{ block.settings.highlight_subheading }}
          </h3>
        {% endif %}
        <div class="ai-text-content-body-{{ ai_gen_id }}">
          {{ block.settings.highlight_text }}
        </div>
      </div>
    {% endif %}
  </div>
</div>

