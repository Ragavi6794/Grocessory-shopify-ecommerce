{% doc %}
  @prompt
    4 image block with clickable option to add link. in web 4 image blockes placed in a row. in mobile 2+2 format. add a hover effect light weightimage should be changeble for each block. space and width, height adjustment need., hover effect should seperate from ech image. not whole block
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.spacing }}px;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-image-grid-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-image-grid-link-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    height: {{ block.settings.image_height }}px;
    text-decoration: none;
  }

  .ai-image-grid-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .ai-image-grid-img-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform {{ block.settings.hover_duration }}s ease, opacity {{ block.settings.hover_duration }}s ease;
  }

  .ai-image-grid-item-{{ ai_gen_id }}:hover .ai-image-grid-img-{{ ai_gen_id }} {
    transform: scale({{ block.settings.hover_scale }});
    opacity: {{ block.settings.hover_opacity }};
  }

  .ai-image-grid-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-grid-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .ai-image-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.spacing_mobile }}px;
    }

    .ai-image-grid-link-{{ ai_gen_id }} {
      height: {{ block.settings.image_height_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-image-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% for i in (1..4) %}
    {% liquid
      assign image_key = 'image_' | append: i
      assign link_key = 'link_' | append: i
      assign image = block.settings[image_key]
      assign link = block.settings[link_key]
    %}

    <div class="ai-image-grid-item-{{ ai_gen_id }}">
      {% if link != blank %}
        <a href="{{ link }}" class="ai-image-grid-link-{{ ai_gen_id }}">
      {% else %}
        <div class="ai-image-grid-link-{{ ai_gen_id }}">
      {% endif %}
        <div class="ai-image-grid-wrapper-{{ ai_gen_id }}">
          {% if image %}
            <img
              src="{{ image | image_url: width: 800 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
              class="ai-image-grid-img-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-image-grid-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% if link != blank %}
        </a>
      {% else %}
        </div>
      {% endif %}
    </div>
  {% endfor %}
</div>

