{%- liquid
  assign product_form_id = 'productQuickViewForm-' | append: section.id | append: '-' | append: product.id
-%}
<sht-atc-frm class="product__form dialog--animate w-100">
  {%- form 'product', product, id: product_form_id, class: 'form form__fields', novalidate: 'novalidate' -%}
    {% if product.metafields.custom.product_quantity != blank %}
      <input type="hidden" name="properties[weight]" value="{{ product.metafields.custom.product_quantity }}">
    {% endif %}
    <div class="form__field">
      <input type="hidden" class="form__control" name="id" value="{{ product.selected_or_first_available_variant.id }}" disabled>
    </div>
    <div class="d-flex fd-column">
      <div class="js-product-form-error-wrapper" data-type="error-wrapper" role="alert" hidden>
        <span class="d-flex middle-xs mb-12">
          <span class="js-product-form-error-message" data-type="error-message"></span>
        </span>
      </div>
      <div class="plp-atc-btn d-flex mt-5">
        <button
          type="submit"
          name="add"
          aria-label="{{ 'products.product.add_to_cart' | t }}"
          class="js-product-form-submit-btn btn btn-cart product__cart w-100 quick-add-button btn-secondary btn-small btn-icon icon"
          {% if product.selected_or_first_available_variant.available == false %}
            disabled
          {% endif %}
        >
          <span class="plp-add-to-cart-span  p-relative d-flex middle-xs center-xs ta-center gap-8">
            {%- if product.selected_or_first_available_variant.available -%}
              <span class="js-product-form-submit-btn-text quick-add-wrapper">
                <span class="quick-add-label"> {{ 'products.product.quick_buy_label' | t }} </span>
                <span class="add-to-cart-span d-none">{% render 'icon-cart', size: 16 %}</span>
              </span>
            {%- endif -%}
          </span>
        </button>
      </div>
    </div>
  {%- endform -%}
</sht-atc-frm>

 {% render 'js-loader', files: "component-quickadd.js" | split: ', ' %}

