.mobile-bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.1);
  z-index: 1000;
    border-radius: 20px 20px 0 0;
  transition: all 0.5s ease, opacity 0.5s ease, transform 0.5s ease;
  padding: 0;
  opacity: 1;
  transform: translateY(0);
}

.mobile-bottom-nav.hidden {
  opacity: 0;
  transform: translateY(100%);
  pointer-events: none;
}

.mobile-bottom-nav.fade-out {
  opacity: 0;
  transform: translateY(20px);
}

.nav-item.active {
    border-top: 4px solid #FE006B;
}
.nav-item .header__icon.header__icon--cart , .nav-acc-item ,.nav-icon-home{
  display: flex;
  flex-direction: column;
}
.nav-item.active span.nav-label {
  color: #FE006B;
}
.nav-icon path {
  fill: black;
}
.nav-item.active .nav-icon path , .nav-item.active svg path {
  fill:  #FE006B;
  stroke: #FE006B;
}
.mobile-bottom-nav.at-footer {
  position: relative;
  bottom: auto;
  margin-top: 20px;
}

.nav-container {
  display: flex;
  justify-content: space-around;
  align-items: center;
  max-width: 100%;
  padding: 0 20px;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
  transition: transform 0.2s ease;
  min-width: 60px;
  padding: 10px;
}

.nav-item:hover {
  transform: translateY(-2px);
}

.nav-icon {
  margin-bottom: 4px;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  transition: all 0.2s ease;
}

.nav-icon img {
  width: 24px;
  height: 24px;
  object-fit: contain;
}

.nav-item:hover .nav-icon {
  background: #e9ecef;
}

.nav-label {
  font-size: 12px;
  font-weight: 500;
  color: #333;
  text-align: center;
}


/* Hide on desktop */
@media (min-width: 768px) {
  .mobile-bottom-nav {
    display: none;
  }
}

/* Mobile specific adjustments */
@media (max-width: 767px) {
  #ui-datepicker-div {
    z-index: 10 !important;
  }
  .sht-drawer.active .drawer__wrapper {
    margin-right: 0 !important;
  }
  .Avada-Faqs_Button {
    bottom: 165px  !important;;
  }
  /* Body when cart is open */
  body:has(#shtCartDrawer.active[aria-hidden="false"]) {
    overflow: hidden !important;
  }
  body:has(#ui-datepicker-div[style*="display: block"]) div#mobileBottomNav {
    display: none;
  }
  body:has(#shtCartDrawer[aria-hidden="true"]:not(.active)) {
    overflow: auto;
  }
  body:has(#menuDrawer.active ) {
    overflow: hidden !important;
  }
  body:has(#menuDrawer:not(.active)) {
    overflow: auto;
  }
  button.hmburger-menu {
    display: none !important;
  }

  .header__logo .header-logo {
    margin: 0;
  }
  .Avada-Faqs_Popup {
    z-index: 1001 !important;
  }
  
  .AvadaJoy-Launcher__Button {
    opacity: 0;
  }
  body {
    overflow-y: visible !important;
    padding-bottom: 90px !important;
    overflow-x: hidden;
  }
  body.nav-at-footer {
    padding-bottom: 0; /* Remove padding when nav is at footer */
  }
  .header__icons .header__icon.header__icon--cart {
    display: none;
  }
  
  /* Hide mobile navigation when cart drawer is open */
  #shtCartDrawer:not([aria-hidden="true"]) ~ .mobile-bottom-nav,
  #shtCartDrawer.active ~ .mobile-bottom-nav {
    opacity: 0;
    visibility: hidden;
    transform: translateY(100%);
    transition: all 0.3s ease;
  }
  
  /* Hide mobile navigation when menu drawer is open */
  #menuDrawer[aria-hidden="false"] ~ .mobile-bottom-nav,
  #menuDrawer.active ~ .mobile-bottom-nav {
    opacity: 0;
    visibility: hidden;
    transform: translateY(100%);
    transition: all 0.3s ease;
  }
  
  /* Show mobile navigation when cart drawer is closed */
  #shtCartDrawer[aria-hidden="true"] ~ .mobile-bottom-nav,
  #shtCartDrawer:not(.active) ~ .mobile-bottom-nav {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition: all 0.3s ease;
  }
  
  /* Show mobile navigation when menu drawer is closed */
  #menuDrawer[aria-hidden="true"] ~ .mobile-bottom-nav,
  #menuDrawer:not(.active) ~ .mobile-bottom-nav {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition: all 0.3s ease;
  }
}

/* Hide mobile navigation when menu drawer is open - using body class approach */
body:has(#menuDrawer[aria-hidden="false"]) .mobile-bottom-nav,
body:has(#menuDrawer.active) .mobile-bottom-nav {
  opacity: 0 !important;
  visibility: hidden !important;
  transform: translateY(100%) !important;
  transition: all 0.3s ease;
}

/* Hide mobile navigation when cart drawer is open - using body class approach */
body:has(#shtCartDrawer:not([aria-hidden="true"])) .mobile-bottom-nav,
body:has(#shtCartDrawer.active) .mobile-bottom-nav {
  opacity: 0 !important;
  visibility: hidden !important;
  transform: translateY(100%) !important;
  transition: all 0.3s ease;
}

