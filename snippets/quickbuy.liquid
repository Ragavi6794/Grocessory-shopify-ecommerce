<sht-dialog-quickbuy class="sht-dialog dialog__quickbuy bg-transparent color-{{ settings.color_scheme_drawer_popover }} d-flex no-focus-visible end-sm bottom-xs center-xs p-fixed left-0 top-0 h-100 w-100 o-auto zi-9" id="dialogQuickBuy" hidden tabindex="-1">
  <div class="dialog js-dialog-container disable-scrollbars oy-scroll" role="dialog" aria-labelledby="dialogQuickBuyTitle" aria-modal="true">
    <div class="dialog__header d-flex between-xs middle-xs p-sticky top-0">
      <h3 class="h5 m-zero">
        {{ 'products.product.variant_picker' | t }}
      </h3>
      <button type="button" aria-label="{{- "accessibility.close_modal" | t -}}" class="dialog__btn js-dialog-close-btn btn btn-icon btn-small icon btn-secondary">
        {%- render 'icon-close', size: 20 -%}
      </button>
    </div>
    <div class="dialog__body js-dialog-body">
    </div>
  </div>
</sht-dialog-quickbuy>

