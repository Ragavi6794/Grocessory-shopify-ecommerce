<script>
// Address Modal Functions
function openAddressModal() {
  document.getElementById('addressModal').style.display = 'block';
  clearForm();
  hideMessages();
}

function closeAddressModal() {
  document.getElementById('addressModal').style.display = 'none';
  clearForm();
  hideMessages();
}

function clearForm() {
  const form = document.querySelector('.address-form');
  const inputs = form.querySelectorAll('input, select');
  inputs.forEach(input => {
    if (input.type === 'checkbox') {
      input.checked = false;
    } else if (input.id === 'addressCountryNew') {
      // Keep the hidden country field value as "AE"
      input.value = 'AE';
    } else {
      input.value = '';
    }
  });
  hideValidationErrors();
}

function hideMessages() {
  document.getElementById('successMessage').style.display = 'none';
  document.getElementById('errorMessage').style.display = 'none';
}

function hideValidationErrors() {
  const errors = document.querySelectorAll('.field-error');
  errors.forEach(error => error.style.display = 'none');
}

function showError(message) {
  const errorDiv = document.getElementById('errorMessage');
  const errorText = document.getElementById('errorText');
  errorText.textContent = message;
  errorDiv.style.display = 'block';
  document.getElementById('successMessage').style.display = 'none';
}

function showSuccess(message) {
  const successDiv = document.getElementById('successMessage');
  successDiv.textContent = message;
  successDiv.style.display = 'block';
  document.getElementById('errorMessage').style.display = 'none';
}

function validateForm() {
  let isValid = true;
  hideValidationErrors();

  // Get current language
  const isArabic = '{{ localization.language.iso_code }}' === 'ar';

  // Required fields validation with translatable messages
  const requiredFields = [
    { 
      id: 'addressFirstNameNew', 
      errorId: 'firstNameError', 
      message: isArabic ? 'الاسم الأول مطلوب' : 'First name is required' 
    },
    { 
      id: 'addressLastNameNew', 
      errorId: 'lastNameError', 
      message: isArabic ? 'اسم العائلة مطلوب' : 'Last name is required' 
    },
    { 
      id: 'addressPhoneNew', 
      errorId: 'phoneError', 
      message: isArabic ? 'رقم الهاتف مطلوب' : 'Phone number is required' 
    },
    { 
      id: 'addressVillaFlatNew', 
      errorId: 'villaFlatError', 
      message: isArabic ? 'عنوان الفيلا/الشقة مطلوب' : 'Villa/Flat address is required' 
    },
    { 
      id: 'addressAddress1New', 
      errorId: 'address1Error', 
      message: isArabic ? 'عنوان الشارع مطلوب' : 'Address is required' 
    },
    { 
      id: 'addressProvinceNew', 
      errorId: 'provinceError', 
      message: isArabic ? 'الولاية مطلوبة' : 'State is required' 
    },
    { 
      id: 'addressCityNew', 
      errorId: 'cityError', 
      message: isArabic ? 'المدينة مطلوبة' : 'City is required' 
    }
  ];

  requiredFields.forEach(field => {
    const input = document.getElementById(field.id);
    const error = document.getElementById(field.errorId);
    
    if (!input.value.trim()) {
      error.textContent = field.message;
      error.style.display = 'block';
      isValid = false;
    }
  });

  // Phone validation with translatable message
  const phone = document.getElementById('addressPhoneNew').value.trim();
  const phoneError = document.getElementById('phoneError');
  const phonePattern = /^(50|52|54|55|56|58)\s?\d{7}$/;
  
  if (phone && !phonePattern.test(phone)) {
    phoneError.textContent = isArabic ? 
      'يرجى إدخال رقم هاتف محمول صالح في الإمارات (مثال: 50 1234567)' : 
      'Please enter a valid UAE mobile number (e.g., 50 1234567)';
    phoneError.style.display = 'block';
    isValid = false;
  }

  return isValid;
}

async function saveAddressViaAPI() {
  console.log('🔥 Address Modal Debug: Function called - saveAddressViaAPI()');
  console.log('🕐 Address Modal Debug: Timestamp:', new Date().toISOString());
  
  if (!validateForm()) {
    console.log('🚫 Address Modal Debug: Form validation failed');
    return;
  }

  console.log('✅ Address Modal Debug: Form validation passed');

  const saveBtn = document.getElementById('saveBtn');
  const saveText = document.getElementById('saveButtonText');
  const saveSpinner = document.getElementById('saveButtonSpinner');
  
  console.log('🎯 Address Modal Debug: Button elements found:', {
    saveBtn: !!saveBtn,
    saveText: !!saveText,
    saveSpinner: !!saveSpinner
  });
  
  // Show loading state
  saveBtn.disabled = true;
  saveText.style.display = 'none';
  saveSpinner.style.display = 'inline';
  hideMessages();

  console.log('🚀 Address Modal Debug: Starting address creation...');
  console.log('🌐 Address Modal Debug: Current page URL:', window.location.href);
  console.log('🍪 Address Modal Debug: Document cookies:', document.cookie);
  console.log('👤 Address Modal Debug: Customer logged in check:', typeof customer !== 'undefined');

  try {
    // Get form data
    const addressData = {
      firstName: document.getElementById('addressFirstNameNew').value.trim(),
      lastName: document.getElementById('addressLastNameNew').value.trim(),
      company: '',
      phone: '+971' + document.getElementById('addressPhoneNew').value.trim(),
      address1: document.getElementById('addressVillaFlatNew').value.trim(),
      address2: document.getElementById('addressAddress1New').value.trim(),
      city: document.getElementById('addressCityNew').value.trim(),
      province: document.getElementById('addressProvinceNew').value.trim(),
      zip: '',
      country: document.getElementById('addressCountryNew').value,
      isDefault: document.getElementById('setDefaultAddress').checked
    };

    console.log('📋 Address Modal Debug: Form data collected:', addressData);
    console.log('📋 Address Modal Debug: Form data validation:');
    console.log('  - First Name:', addressData.firstName ? '✓' : '✗', `"${addressData.firstName}"`);
    console.log('  - Last Name:', addressData.lastName ? '✓' : '✗', `"${addressData.lastName}"`);
    console.log('  - Phone:', addressData.phone ? '✓' : '✗', `"${addressData.phone}"`);
    console.log('  - Address1:', addressData.address1 ? '✓' : '✗', `"${addressData.address1}"`);
    console.log('  - City:', addressData.city ? '✓' : '✗', `"${addressData.city}"`);
    console.log('  - Province:', addressData.province ? '✓' : '✗', `"${addressData.province}"`);
    console.log('  - Country:', addressData.country ? '✓' : '✗', `"${addressData.country}"`);
    console.log('  - ZIP:', addressData.zip ? '✓' : '✗', `"${addressData.zip}"`);
    console.log('  - Default:', addressData.isDefault ? 'Yes' : 'No');
    console.log('  - Checkbox element:', document.getElementById('setDefaultAddress'));
    console.log('  - Checkbox checked property:', document.getElementById('setDefaultAddress').checked);
    console.log('  - Checkbox value being sent:', addressData.isDefault ? '1' : '0');

    // Check if customer is logged in
    console.log('🔍 Address Modal Debug: Shopify object check:');
    console.log('  - window.Shopify exists:', !!window.Shopify);
    console.log('  - window.Shopify.shop exists:', !!(window.Shopify && window.Shopify.shop));
    console.log('  - Shopify shop value:', window.Shopify ? window.Shopify.shop : 'N/A');
    
    if (!window.Shopify || !window.Shopify.shop) {
      console.error('❌ Address Modal Debug: Shopify object not found');
      showError('Shopify integration error. Please refresh the page.');
      return;
    }

    console.log('✅ Address Modal Debug: Shopify object validated successfully');

    // Prepare form data for submission
    const formData = new URLSearchParams({
      'form_type': 'customer_address',
      'utf8': '✓',
      'address[first_name]': addressData.firstName,
      'address[last_name]': addressData.lastName,
      'address[company]': '',
      'address[phone]': addressData.phone,
      'address[address1]': addressData.address1,
      'address[address2]': addressData.address2,
      'address[city]': addressData.city,
      'address[province]': addressData.province,
      'address[zip]': '',
      'address[country]': addressData.country
    });

    // Only add default parameter if checkbox is checked
    if (addressData.isDefault) {
      formData.append('address[default]', '1');
    }

    console.log('📤 Address Modal Debug: Form data prepared for submission');
    console.log('📤 Address Modal Debug: Request URL: /account/addresses');
    console.log('📤 Address Modal Debug: Request method: POST');
    console.log('📤 Address Modal Debug: Form data string:', formData.toString());
    console.log('📤 Address Modal Debug: Form data entries:');
    for (const [key, value] of formData.entries()) {
      console.log(`    ${key}: "${value}"`);
    }

    // Use Shopify's customer address creation endpoint
    console.log('🌐 Address Modal Debug: Making fetch request...');
    console.log('🕐 Address Modal Debug: Request start time:', new Date().toISOString());
    
    const response = await fetch('/account/addresses', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json, text/html, */*'
      },
      body: formData
    });

    console.log('🕐 Address Modal Debug: Response received time:', new Date().toISOString());
    console.log('📥 Address Modal Debug: Response status:', response.status);
    console.log('📥 Address Modal Debug: Response status text:', response.statusText);
    console.log('📥 Address Modal Debug: Response OK:', response.ok);
    console.log('📥 Address Modal Debug: Response type:', response.type);
    console.log('📥 Address Modal Debug: Response URL:', response.url);
    console.log('📥 Address Modal Debug: Response redirected:', response.redirected);
    console.log('📥 Address Modal Debug: Response headers:', Object.fromEntries(response.headers.entries()));

    if (response.ok) {
      console.log('✅ Address Modal Debug: Response status is OK (200-299)');
      const responseText = await response.text();
      console.log('📄 Address Modal Debug: Response text length:', responseText.length);
      console.log('📄 Address Modal Debug: Response content type:', response.headers.get('content-type'));
      console.log('📄 Address Modal Debug: Full response text:', responseText);
      
      // Check if response contains any error indicators
      const containsError = responseText.toLowerCase().includes('error');
      const containsInvalid = responseText.toLowerCase().includes('invalid');
      const containsFailed = responseText.toLowerCase().includes('failed');
      const containsSuccess = responseText.toLowerCase().includes('success');
      const containsAddress = responseText.toLowerCase().includes('address');
      
      console.log('🔍 Address Modal Debug: Response content analysis:');
      console.log('  - Contains "error":', containsError);
      console.log('  - Contains "invalid":', containsInvalid);
      console.log('  - Contains "failed":', containsFailed);
      console.log('  - Contains "success":', containsSuccess);
      console.log('  - Contains "address":', containsAddress);
      
      // Get current language for success message
      const isArabic = '{{ localization.language.iso_code }}' === 'ar';
      const successMessage = isArabic ? 'تمت إضافة العنوان بنجاح!' : 'Address added successfully!';
      showSuccess(successMessage);
      
      // Wait 2 seconds then close modal and refresh page
      setTimeout(() => {
        console.log('🔄 Address Modal Debug: Timeout triggered after 2 seconds');
        console.log('🔄 Address Modal Debug: Closing modal and refreshing page');
        console.log('🔄 Address Modal Debug: About to call closeAddressModal()');
        closeAddressModal();
        console.log('🔄 Address Modal Debug: About to call window.location.reload()');
        window.location.reload();
      }, 2000);
      
    } else {
      const errorText = await response.text();
      console.error('❌ Address Modal Debug: HTTP Error:', response.status, response.statusText);
      console.error('❌ Address Modal Debug: Error response:', errorText);
      
      // Try to parse error message from response
      let errorMessage = 'Failed to add address. Please try again.';
      
      // Check if response contains HTML with error messages
      if (errorText.includes('error') || errorText.includes('Error')) {
        const parser = new DOMParser();
        const doc = parser.parseFromString(errorText, 'text/html');
        const errorElements = doc.querySelectorAll('.errors, .error, .field-error, [class*="error"]');
        
        if (errorElements.length > 0) {
          const errors = Array.from(errorElements).map(el => el.textContent.trim()).filter(text => text);
          if (errors.length > 0) {
            errorMessage = `Address creation failed: ${errors.join(', ')}`;
          }
        }
      }
      
      // Check for specific error conditions
      if (response.status === 401) {
        errorMessage = 'Please log in to add addresses.';
      } else if (response.status === 403) {
        errorMessage = 'Permission denied. Please log in again.';
      } else if (response.status === 422) {
        errorMessage = 'Invalid address data. Please check all fields.';
      } else if (response.status === 429) {
        errorMessage = 'Too many requests. Please wait and try again.';
      }
      
      showError(errorMessage);
    }

  } catch (error) {
    console.error('❌ Address Modal Debug: Network/JavaScript error:', error);
    console.error('❌ Address Modal Debug: Error stack:', error.stack);
    
    let errorMessage = 'An error occurred. Please try again.';
    
    if (error.name === 'TypeError' && error.message.includes('fetch')) {
      errorMessage = 'Network error. Please check your connection and try again.';
    } else if (error.name === 'SyntaxError') {
      errorMessage = 'Invalid response from server. Please try again.';
    }
    
    showError(errorMessage);
  } finally {
    // Reset button state
    console.log('🔄 Address Modal Debug: Resetting button state');
    saveBtn.disabled = false;
    saveText.style.display = 'inline';
    saveSpinner.style.display = 'none';
  }
}

// Add debugging function to check customer login status
function checkCustomerStatus() {
  console.log('👤 Address Modal Debug: Customer status check');
  console.log('👤 Customer object:', typeof customer !== 'undefined' ? customer : 'undefined');
  console.log('👤 Shopify object:', typeof Shopify !== 'undefined' ? Shopify : 'undefined');
  console.log('👤 Current URL:', window.location.href);
  console.log('👤 Cookies:', document.cookie);
}

// Close modal when clicking outside of it
window.onclick = function(event) {
  const modal = document.getElementById('addressModal');
  if (event.target === modal) {
    closeAddressModal();
  }
}

// Close modal with Escape key
document.addEventListener('keydown', function(event) {
  if (event.key === 'Escape') {
    const modal = document.getElementById('addressModal');
    if (modal.style.display === 'block') {
      closeAddressModal();
    }
  }
});
</script>