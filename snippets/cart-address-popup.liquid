<!-- Address Modal -->
<div id="addressModal" class="address-modal">
  <div class="address-modal-content">
    <div class="address-modal-header">
      {% if localization.language.iso_code == "ar" %}
        <h3>إضافة عنوان جديد</h3>
        {% else %}
        <h3>Add New Address</h3>
      {% endif %}
      <span class="close-modal" onclick="closeAddressModal()">&times;</span>
    </div>
    
    <div id="successMessage" class="success-message">
      {% if localization.language.iso_code == "ar" %}
        تمت إضافة العنوان بنجاح!
      {% else %}
        Address added successfully!
      {% endif %}

    </div>
    
    <div id="errorMessage" class="error-message-modal">
      <span id="errorText"></span>
    </div>
    
    <div class="address-form d-flex fw-wrap r-gap-24 r-gap-md-32">
      <div class="clm" style="--w-md:6">
        <label for="addressFirstNameNew" class="field__label d-block mb-8 fw-700">
          {% if localization.language.iso_code == "ar" %}
            الاسم الأول
          {% else %}
            First Name
          {% endif %}
          <span class="ml-4 color-error">*</span></label>
        <input class="field__text field--focus field--hover w-100" type="text" id="addressFirstNameNew" autocomplete="given-name" placeholder="{% if localization.language.iso_code == "ar" %}الاسم الأول{% else %}First Name{% endif %}" required/>
        <div class="field-error" id="firstNameError" style="display: none;">
          {% if localization.language.iso_code == "ar" %}
            الاسم الأول مطلوب
          {% else %}
            First name is required
          {% endif %}
        </div>
      </div>
      
      <div class="clm" style="--w-md:6">
        <label for="addressLastNameNew" class="field__label d-block mb-8 fw-700">
          {% if localization.language.iso_code == "ar" %}
          اسم العائلة
          {% else %}
            Last Name
          {% endif %}  
        <span class="ml-4 color-error">*</span></label>
        <input class="field__text field--focus field--hover w-100" type="text" id="addressLastNameNew" autocomplete="family-name" placeholder="{% if localization.language.iso_code == "ar" %}اسم العائلة{% else %}Last Name{% endif %}" required/>
        <div class="field-error" id="lastNameError" style="display: none;">
          {% if localization.language.iso_code == "ar" %}
            اسم العائلة مطلوب
          {% else %}
            Last name is required
          {% endif %}  
        </div>
      </div>
      
      
      <div class="clm" style="--w-md:6">
        <label for="addressPhoneNew" class="field__label d-block mb-8 fw-700">
          {% if localization.language.iso_code == "ar" %}
            رقم الهاتف
          {% else %}
            Phone Number
          {% endif %} 
          <span class="ml-4 color-error">*</span></label>
        <div class="phone-input-wrapper" style="display: flex; align-items: center;">
          <span class="phone-prefix" style="background: #f8f9fa; border: 1px solid #ddd; border-right: none; padding: 10px 12px; border-radius: 4px 0 0 4px; font-weight: 500;">+971</span>
          <input class="field__text field--focus field--hover" style="border-radius: 0 4px 4px 0; flex: 1;" type="tel" id="addressPhoneNew" autocomplete="tel" placeholder="50 1234567" pattern="^(50|52|54|55|56|58)\s?\d{7}$" title="Please enter a valid UAE mobile number" required/>
        </div>
        <div class="field-error" id="phoneError" style="display: none;">
          {% if localization.language.iso_code == "ar" %}
             يرجى إدخال رقم هاتف محمول صالح في الإمارات (مثال: 50 1234567)
          {% else %}
           Please enter a valid UAE mobile number (e.g., 50 1234567)
          {% endif %}        
        </div>
      </div>
      
      <div class="clm" style="--w-md:6">
        <label for="addressVillaFlatNew" class="field__label d-block mb-8 fw-700">
          {% if localization.language.iso_code == "ar" %}
            عنوان الفيلا/الشقة
          {% else %}
            Villa/Flat Address
          {% endif %}   
        <span class="ml-4 color-error">*</span></label>
        <input class="field__text field--focus field--hover w-100" type="text" id="addressVillaFlatNew" autocomplete="address-line1" placeholder="{% if localization.language.iso_code == "ar" %}عنوان الفيلا/الشقة{% else %}Villa/Flat Address{% endif %}" required/>
        <div class="field-error" id="villaFlatError" style="display: none;">Villa/Flat address is required</div>
      </div>
      
      <div class="clm" style="--w-md:6">
        <label for="addressAddress1New" class="field__label d-block mb-8 fw-700">
          {% if localization.language.iso_code == "ar" %}
            عنوان الشارع
          {% else %}
            Street Address
          {% endif %}  
          <span class="ml-4 color-error">*</span></label>
        <input class="field__text field--focus field--hover w-100" type="text" id="addressAddress1New" autocomplete="address-line2" placeholder="{% if localization.language.iso_code == "ar" %}عنوان الشارع{% else %}Street Address{% endif %}" required/>
        <div class="field-error" id="address1Error" style="display: none;">Address is required</div>
      </div>
      
      <div class="clm" style="--w-md:6">
        <label for="addressCityNew" class="field__label d-block mb-8 fw-700">
          {% if localization.language.iso_code == "ar" %}
            المدينة
          {% else %}
              Area
            {% endif %}
          <span class="ml-4 color-error">*</span></label>
        <input class="field__text field--focus field--hover w-100" type="text" id="addressCityNew" autocomplete="address-level2" placeholder="{% if localization.language.iso_code == "ar" %}المدينة{% else %}Area{% endif %}" required/>
        <div class="field-error" id="cityError" style="display: none;">City is required</div>
      </div>

      <!-- Hidden country field with default UAE value -->
      <input type="hidden" id="addressCountryNew" value="AE" />
      
      <div class="clm" style="--w-md:6">
        <label for="addressProvinceNew" class="field__label d-block mb-8 fw-700">
          {% if localization.language.iso_code == "ar" %}
            الولاية / المحافظة
          {% else %}
            State/Province
          {% endif %}   
        <span class="ml-4 color-error">*</span></label>
        <select class="field__text field--focus field--hover w-100" id="addressProvinceNew" autocomplete="address-level1" required>
          <option value="" selected disabled>  
            {% if localization.language.iso_code == "ar" %}
              اختر الإمارة
            {% else %}
              Select State
            {% endif %}
           </option>
          <option value="Dubai">
            {% if localization.language.iso_code == "ar" %}
              دبي
            {% else %}
              Dubai
            {% endif %}
          </option>
          <option value="Abu Dhabi">
            {% if localization.language.iso_code == "ar" %}
              أبوظبي
            {% else %}
              Abu Dhabi
            {% endif %}
          </option>
        </select>
        <div class="field-error" id="provinceError" style="display: none;">State is required</div>
      </div>
      
      <div class="clm" style="--w-xs:12">
        <label class="custom-checkbox-label d-flex align-items-center c-pointer">
          <input type="checkbox" id="setDefaultAddress" class="custom-checkbox-input">
          <span class="custom-checkbox"></span>
          <span class="checkbox-text">
            {% if localization.language.iso_code == "ar" %}
              تعيين كعنوان افتراضي
            {% else %}
              Set as default address
            {% endif %}
          </span>
        </label>
      </div>
      
      <div class="clm d-flex end-md gap-12 fd-column-reverse fd-row-md" style="--w-xs:12">
        <button class="btn btn-large btn-secondary" type="button" onclick="closeAddressModal()">
          {% if localization.language.iso_code == "ar" %}
           إلغاء 
          {% else %}
            Cancel
          {% endif %}
        </button>
        <button class="btn btn-large btn-primary" id="saveBtn" type="button" onclick="saveAddressViaAPI()">
          <span id="saveButtonText">
          {% if localization.language.iso_code == "ar" %}
           إضافة العنوان
          {% else %}
            Add Address
          {% endif %}
          </span>
          <span id="saveButtonSpinner" style="display: none;">Adding...</span>
        </button>
      </div>
    </div>
  </div>
</div>

