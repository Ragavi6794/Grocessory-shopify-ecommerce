{%- comment -%}
{% render 'card-product',
  product: block.settings.product,
  show_vendor: true,
  show_color_swatch: true,
  show_sale_badge: true,
  enable_quick_buy: true,
  enable_quick_view: true,
  show_product_attributes: true,
  enable_product_card_desc: true,
  enable_card_compare: true,
  item_per_row: 1,
  ratio: '100',
  card_content_inner: boolean
%}
{%- endcomment -%}
{%- liquid
  assign section_id = section.id | md5 | truncate: 12, ""
  assign random_number =  "now" | date: "%N" | append: section_id | append: product.id

  assign product_image_id =  random_number | prepend: 'cardProductImage-'
  assign product_link_class =  random_number | prepend: 'js-card-product-link-'
  assign image_width = image_width | default: '750, 950, 1024, 1200, 1400, 1600, 1800, 2000'

  assign sizes = "(min-width: 361px) calc(100vw/2), calc(100vw/3)"
  assign product_placeholder = 'product-1' | placeholder_svg_tag: 'media placeholder w-100 h-100'
  assign product_image = product_placeholder

  assign product_img_first_classes = 'media img-first w-100 h-100 ' | append: settings.image_fit_type
  assign product_img_second_classes = 'media img-second w-100 h-100 opacity-0 ' | append: settings.image_fit_type

  assign product_image = product.featured_media | image_url: width: product.featured_media.width | image_tag: widths: image_width, sizes: sizes, alt: product.title, class: product_img_first_classes, id: product_image_id
  assign secondary_image_class = ' card'

  if product.media[1] != nil and show_second_image
    assign product_image_second = product.media[1] | image_url: width: product.featured_image.width | image_tag: widths: image_width, sizes: sizes, alt: product.title, class: product_img_second_classes
    assign secondary_image_class = ' card--2-images'
     capture secondary_image
      render 'image', image_item: product_image_second, image_classes: ' w-100 h-100', image_wrap_classes: 'product__image-second p-absolute top-0 left-0 w-100 h-100', ratio: ratio
     endcapture
  endif

  assign product_card_style = 'card--' | append:  settings.product_card_style

  if settings.product_card_style == 'card'
    assign product_card_scheme = 'card--border corner-radius-s background color-' | append: settings.card_color_scheme
  endif

  if is_predective_search
    assign product_card_scheme = ''
  endif

  assign product_card_media_background = settings.product_card_media_background
  if is_featured_product_list == true
    assign product_card_style = 'card--card'
    assign product_card_scheme = 'card--border corner-radius-s background color-' | append: color_scheme_featured_product_list
    assign enable_product_card_desc = false
    assign product_card_media_background = featured_products_card_media_background
  endif
-%}
<div class="product-card__wrapper {{ product_card_scheme }} js-product-card-wrapper d-grid gap-16 flex-1 h-100 w-100" data-product-id="{{ product.variants.first.id }}" data-handle="{{ product.handle }}" data-inventory-quantity="{{ product.variants.first.inventory_quantity | default: 9999 }}">
  {% if enable_card_compare %}
    <button class="maw-fit-content btn btn-small pd-0 bg-transparent gap-8 no-js-hidden btn-add-to-compare js-btn-add-to-compare btn-compare--horizontal d-none" aria-label="{{ "products.product.add_to_compare" | t }}" aria-haspopup="true" type="button" data-product-id="{{ product.id }}" data-product-url="{{ product.url | split: "?" | first | replace: "&_pos=", "" | replace: "&_fid=", "" | replace: "&_ss=", "" }}">
      <span class="icon btn btn-secondary btn-icon btn-small icon-plus flex-auto">
        {% render 'icon-plus', size: 16 %}
      </span>
      <span class="icon btn btn-primary btn-icon btn-small icon-check flex-auto">
        {% render 'icon-check' size: 16, %}
      </span>
      {{ 'products.product.add_to_compare' | t }}
    </button>
  {% endif %}
  <div class="product product-card {{ product_card_style }} {{ secondary_image_class }} {{ secondary_card_classes }} w-100 p-relative" style="{{ card_style }}">
      <div class="card__badge prominent-badge product__badge p-absolute d-flex bottom-xs fd-column zi-1 tt-up hide-empty">
        {%- if product.compare_at_price != null and product.compare_at_price > product.price and show_sale_badge == true -%}
          <span class="badge badge--sale d-inline-block fw-700 color-{{ settings.color_scheme_sale_badge }}">
            <span class="d-inline-block">
              {%- liquid
                assign save_amount =  product.compare_at_price | minus: product.price | times: 1.0 | divided_by: product.compare_at_price | times: 100 | round
                if product.has_only_default_variant
                  echo 'products.product.card.save_percent' | t: save_amount: save_amount
                else
                  assign save_amount = 0
                  for variant in product.variants
                    assign saving = variant.compare_at_price | minus: variant.price | times: 1.0 | divided_by: variant.compare_at_price | times: 100 | round
                    assign save_amount = saving | at_least: save_amount
                  endfor
                  echo 'products.product.card.save_percent_up_to' | t: save_amount: save_amount
                endif
              -%}
            </span>
          </span>
        {%- endif -%}
       
        {%- if product.available == false -%}
          <span class="badge badge--oos d-inline-block fw-700 color-{{ settings.color_scheme_sold_out_badge }}">
            <span class="d-inline-block">
              {{- 'products.product.sold_out' | t -}}
            </span>
          </span>
        {%- endif -%}
      </div>
      {{ show_current_product_badge }}


      <div class="card__media card__media--{{- settings.product_card_style }} p-relative o-hidden corner-radius-s" style="background-color: {{ product_card_media_background }}">
        <a href="{{- product.url | within: collection | default: '#' -}}" class="d-block w-100 h-100 pe-no-link zi-1 p-absolute {{ product_link_class }}" aria-label="{{ product.title | escape }}"></a>
          <div>
            {% comment %} {% if product.tags contains "Pre-Order-Item" %}
              <p id="pre-order-badge-plp">Pre-Order</p>
            {% endif %} {% endcomment %}

            {% assign possible_badges = "Pre-Order-Item,Seasonal,By Air,Flash Sale,Must Buy,Offer,Organic,Ramadan,Ripe,Ripe at Home,Sanitized,Winter,Diwali" | split: "," %}

            <div class="product-badges">
              {% for badge_tag in possible_badges %}
                {% if product.tags contains badge_tag %}
                  <p class="product-promo-badge promo-{{ badge_tag | replace: ' ', '-' }}">
                    {% if badge_tag == "Pre-Order-Item" %}
                      Pre-Order
                    {% else %}
                      {{ badge_tag }}
                    {% endif %}
                  </p>
                {% endif %}
              {% endfor %}

                {%- comment -%} ✅ Render custom "badge:" tags dynamically {%- endcomment -%}
                {% for tag in product.tags %}
                  {% if tag contains "badge:" %}
                    {% assign badge_label = tag | split: "badge:" | last | strip %}
                    {% assign badge_class = badge_label | replace: ' ', '-' | downcase %}
                    <p class="product-promo-badge promo-{{ badge_class }}">
                      {{ badge_label }}
                    </p>
                  {% endif %}
                {% endfor %}
            </div>

            <style>

              .card__media .product-badges {
                display: flex;
                gap: 5px;
                flex-direction: column;
                align-items: flex-end;
                position: absolute;
                right: 5px;
                top: 5px;
                border-radius:10px;

              }
            </style>
          </div>
        {%- render 'image', image_item: product_image, image_wrap_classes: 'product__image-first', ratio: ratio, image_classes: 'h-100' -%}
        {{- secondary_image -}}
        {% render 'quick-add-form', section: section, product: product %}
            <div class="quantity-selector hidden">      
        <button class="electro-btn minus">−</button>
        <span class="quantity">1</span>
        <button class="electro-btn plus">+</button>
    </div>
        <div class="product__buttons p-absolute hide-empty zi-1 d-flex gap-4">
          <div class="{{ enable_quick_view | default: ' d-none' | replace: 'true', '' }}">
            <button class="no-js-hidden btn-quickbuy btn btn-secondary btn-icon icon btn-small" aria-label="{{ "products.product.card.quick_shop" | t }}" aria-haspopup="true" type="button" data-product-url="{{ product.url | split: "?" | first }}?view=quick-view" onclick="window.dialogQuickShop.showModal(this);">
              {%- render 'icon-show', size: 16 -%}
            </button>
          </div>
       {% comment %}
          {%- unless enable_quick_buy == false or product.selected_or_first_available_variant.available == false -%}
            {%- if product.has_only_default_variant -%}
              {% render 'quick-add-form', section: section, product: product %}
            {%- else -%}
              <button class="btn btn-secondary btn-cart btn-small btn-icon icon no-js-hidden" aria-label="{{ "products.product.quick_buy" | t }}" aria-haspopup="true" type="button" data-product-url="{{ product.url | split: "?" | first }}?view=quick-buy" onclick="window.dialogQuickBuy.showModal(this);">
                {% render 'icon-cart', size: 16 %}
              </button>
            {%- endif -%}
          {%- endunless -%}
          {% endcomment %}
          
        </div>
      </div>
      <div class="card__content w-100 wb-break-word">
           <a href="{{- product.url | within: collection | default: '#' -}}" class="" aria-label="{{ product.title | escape }}">
        <div class="card__info">
          {% assign countryMeta = product.metafields.custom.odoo_country %}
          {% if countryMeta != blank %}
            <div class="color-light subtext mb-4 product-country-flag" data-country="{{ countryMeta }}">
              {% if countryMeta == 'United Arab Emirates' %}
                UAE
              {% else %}
                <span>{{- countryMeta -}}</span>
              {% endif %}
            </div>
          {% endif %}
          <div class="color-light subtext mb-4 {{ show_vendor | default: 'd-none' | replace: 'true', '' }}">
            <span class="visually-hidden">{{- 'accessibility.vendor' | t -}}</span>
            <span>{{- product.vendor -}}</span>
          </div>
          <h3 class="card__heading fw-700 m-zero mb-4">
            <a href="{{- product.url | within: collection -}}" class="{{ product_link_class }}">{{- product.title -}}</a>
          </h3>
          {%- if product.metafields.custom.product_quantity -%}
            <div class="product-quantity">
              {{ product.metafields.custom.product_quantity}}
            </div>         
          {%- endif -%}
           <a href="{{- product.url | within: collection | default: '#' -}}" class="" aria-label="{{ product.title | escape }}">
            <div class="card__price-wrapper mb-12">
              {%- liquid
                render 'product-price' product: product, target: product, price_class: 'd-block', card_product_price: true, content_align: content_align, unit_price: unit_price
              -%}
              <div class="prominent-badge product__badge d-none zi-1 tt-up hide-empty">
                {%- if product.compare_at_price != null and product.compare_at_price > product.price and show_sale_badge == true -%}
                  <span class="badge badge--sale d-inline-block fw-700 color-{{ settings.color_scheme_sale_badge }}">
                    <span class="d-inline-block">
                      {%- liquid
                        assign save_amount =  product.compare_at_price | minus: product.price | times: 1.0 | divided_by: product.compare_at_price | times: 100 | round
                        if product.has_only_default_variant
                          echo 'products.product.card.save_percent' | t: save_amount: save_amount
                        else
                          assign save_amount = 0
                          for variant in product.variants
                            assign saving = variant.compare_at_price | minus: variant.price | times: 1.0 | divided_by: variant.compare_at_price | times: 100 | round
                            assign save_amount = saving | at_least: save_amount
                          endfor
                          echo 'products.product.card.save_percent_up_to' | t: save_amount: save_amount
                        endif
                      -%}
                    </span>
                  </span>
                {%- endif -%}
                {%- if product.available == false and show_sold_out_badge == true -%}
                  <span class="badge badge--oos d-inline-block fw-700 color-{{ settings.color_scheme_sold_out_badge }}">
                    <span class="d-inline-block">
                      {{- 'products.product.sold_out' | t -}}
                    </span>
                  </span>
                {%- endif -%}
              </div>
            </div>
          </a>
          <div class='wk_cashback' product_id='{{ product.id }}' product_metafield = '{{ card_product.metafields.wk_wallet_management.product_cashback }}' ></div>
          {%- liquid
            if show_color_swatch == true
              render 'card-product-color-swatch', product: product, product_image_id: product_image_id, product_link_class: product_link_class, vs_class: vs_class
            endif
          -%}
          <div class="color-{{ settings.color_scheme_product_attributes }}">
            {%- liquid
              if show_product_attributes == true
                render 'product-attributes', product: product, namespace_keys: settings.product_attributes_metafield_namespace, att_style: att_style
              endif
            -%}
          </div>

          {%- if enable_product_card_desc -%}
            <div class="product-card-desc mb-12">
              {{- product.description -}}
            </div>
          {%- endif -%}

          {% if enable_card_compare %}
            <button class="btn btn-small pd-0 bg-transparent gap-8 no-js-hidden btn-add-to-compare js-btn-add-to-compare" aria-label="{{ "products.product.add_to_compare" | t }}" aria-haspopup="true" type="button" data-product-id="{{ product.id }}" data-product-url="{{ product.url | split: "?" | first | replace: "&_pos=", "" | replace: "&_fid=", "" | replace: "&_ss=", "" }}">
              <span class="icon btn btn-secondary btn-icon btn-small icon-plus flex-auto">
                {% render 'icon-plus', size: 16 %}
              </span>
              <span class="icon btn btn-primary btn-icon btn-small icon-check flex-auto">
                {% render 'icon-check' size: 16, %}
              </span>
              {{ 'products.product.add_to_compare' | t }}
            </button>
          {% endif %}

          {{- featured_product_list_view_details -}}
          {{- product_specifications -}}
        </div>

        </a>
        <div class="card__info--horizontal">
          {%- if enable_product_card_desc -%}
            <div class="product-card-desc mb-12">
              {{- product.description -}}
            </div>
          {%- endif -%}
          <div class="card-product__buttons card-product__buttons--vertical hide-empty gap-8 fw-wrap mt-12">
            <div class="product__quickbuy w-100 {{ enable_quick_view | default: ' d-none' | replace: 'true', '' }}">
              <button class="no-js-hidden btn w-100 btn-secondary btn-small" aria-label="{{ "products.product.card.quick_shop" | t }}" aria-haspopup="true" type="button" data-product-url="{{ product.url | split: "?" | first }}?view=quick-view" onclick="window.dialogQuickShop.showModal(this);">
                {{ 'products.product.quick_view' | t }}
                {%- render 'icon-show', size: 16, class: 'ml-8' -%}
              </button>
            </div>
            {%- unless enable_quick_buy == false or product.selected_or_first_available_variant.available == false -%}
              {% comment %}{%- if product.has_only_default_variant -%}{% endcomment %}
                
             {% comment %} {%- else -%}
                <button class="btn btn-secondary w-100 btn-small no-js-hidden" aria-label="{{ "products.product.quick_buy" | t }}" aria-haspopup="true" type="button" data-product-url="{{ product.url | split: "?" | first }}?view=quick-buy" onclick="window.dialogQuickBuy.showModal(this);">
                  {{ 'products.product.quick_buy' | t }}
                  {% render 'icon-cart', size: 16, class: 'ml-8' %}
                </button>
              {%- endif -%}{% endcomment %}
            {%- endunless -%}
          </div>

          <div class="product-card_pproduct" data-product-id="{{ product.variants.first.id }}">

          </div>



<style>
.hidden {
    display: none !important;
}

.card__info--horizontal{
      background: black;
    color: white;
    border-radius: 4px;
}
</style>

          
