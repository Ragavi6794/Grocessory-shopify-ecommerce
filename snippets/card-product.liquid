<script>
// Horizontal drag/swipe carousel for product card images
(function() {
  'use strict';

  class ProductImageCarousel {
    constructor(card) {
      this.card = card;
      this.mediaContainer = card.querySelector('.card__media');
      if (!this.mediaContainer) return;

      this.startX = 0;
      this.currentX = 0;
      this.isDragging = false;
      this.isSwipeHandled = false;
      this.swipeThreshold = 50; // Minimum swipe distance in pixels

      this.init();
    }

    init() {
      // Touch events
      this.mediaContainer.addEventListener('touchstart', this.handleTouchStart.bind(this), { passive: true });
      this.mediaContainer.addEventListener('touchmove', this.handleTouchMove.bind(this), { passive: true });
      this.mediaContainer.addEventListener('touchend', this.handleTouchEnd.bind(this));

      // Mouse events
      this.mediaContainer.addEventListener('mousedown', this.handleMouseDown.bind(this));
      this.mediaContainer.addEventListener('mousemove', this.handleMouseMove.bind(this));
      this.mediaContainer.addEventListener('mouseup', this.handleMouseUp.bind(this));
      this.mediaContainer.addEventListener('mouseleave', this.handleMouseLeave.bind(this));
    }

    handleTouchStart(e) {
      this.startX = e.touches[0].clientX;
      this.isSwipeHandled = false;
    }

    handleTouchMove(e) {
      if (!this.startX) return;
      this.currentX = e.touches[0].clientX;
    }

    handleTouchEnd(e) {
      if (!this.startX) return;

      const diffX = this.currentX - this.startX;
      
      if (Math.abs(diffX) > this.swipeThreshold && !this.isSwipeHandled) {
        this.isSwipeHandled = true;
        
        if (diffX > 0) {
          // Swiped right - show first image
          this.card.classList.remove('show-second-image');
        } else {
          // Swiped left - show second image
          this.card.classList.add('show-second-image');
        }
      }

      this.startX = 0;
      this.currentX = 0;
    }

    handleMouseDown(e) {
      this.isDragging = true;
      this.startX = e.clientX;
      this.mediaContainer.classList.add('is-dragging');
      e.preventDefault();
    }

    handleMouseMove(e) {
      if (!this.isDragging) return;
      this.currentX = e.clientX;
    }

    handleMouseUp(e) {
      if (!this.isDragging) return;

      const diffX = this.currentX - this.startX;
      
      if (Math.abs(diffX) > this.swipeThreshold) {
        if (diffX > 0) {
          // Dragged right - show first image
          this.card.classList.remove('show-second-image');
        } else {
          // Dragged left - show second image
          this.card.classList.add('show-second-image');
        }
      }

      this.isDragging = false;
      this.startX = 0;
      this.currentX = 0;
      this.mediaContainer.classList.remove('is-dragging');
    }

    handleMouseLeave(e) {
      if (this.isDragging) {
        this.isDragging = false;
        this.mediaContainer.classList.remove('is-dragging');
      }
    }
  }

  // Initialize carousels
  const initProductImageCarousels = () => {
    const productCards = document.querySelectorAll('.card--2-images');
    productCards.forEach(card => {
      if (!card.dataset.carouselInitialized) {
        new ProductImageCarousel(card);
        card.dataset.carouselInitialized = 'true';
      }
    });
  };

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductImageCarousels);
  } else {
    initProductImageCarousels();
  }

  // Re-initialize on AJAX content load
  document.addEventListener('shopify:section:load', initProductImageCarousels);
})();
</script>

        </div>
