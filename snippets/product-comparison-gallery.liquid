  <div id="productGalleryCarousel-{{ sectionID }}" data-section-id="{{ blockID }}">
    <div class="product-slideshow__items js-product-slideshow js-carousel-items progress-indicator-fw d-flex" role="list" aria-label="{{ 'accessibility.slider' | t }}">
      {%-liquid
        assign product_media_index = 1
        assign featured_media = 'image' | placeholder_svg_tag: 'placeholder media d-block w-100 h-100 of-cover'
        if product.selected_or_first_available_variant.featured_media != null
          assign featured_media = product.selected_or_first_available_variant.featured_media
          assign is_first_image = true
          render 'product-comparison-image', xr_button: true, section: section, media: featured_media, is_first_image: is_first_image, product: product, place_holder: place_holder, product_media_index: product_media_index, is_first_item: true, hide_variant_image: hide_variant_image, ratio: ratio, media_background: settings.product_comparison_image_background, sectionID: sectionID, blockID: blockID
        else
          render 'image', image_item: featured_media, image_wrap_classes: "w-100", image_classes: "h-100 w-100", ratio: ratio
        endif

        for media in product.media
          unless media.id == product.selected_or_first_available_variant.featured_media.id
            if forloop.first and is_first_image == false
              assign is_first_image = true
            else
              assign is_first_image = false
            endif

            assign product_media_index = product_media_index | plus: 1
            render 'product-comparison-image', xr_button: true, section: section, media: media, is_first_image: is_first_image, product: product, place_holder: place_holder, product_media_index: product_media_index, is_first_item: forloop.first, hide_variant_image: hide_variant_image, ratio: ratio, media_background: settings.product_comparison_image_background, sectionID: sectionID, blockID: blockID
          endunless
        endfor
      -%}
    </div>
  </div>
