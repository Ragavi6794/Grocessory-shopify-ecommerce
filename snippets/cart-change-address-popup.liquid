  min-height: 300px;       /* feel solid; adjust if needed */
  max-height: 70vh;        /* prevent full-screen overflow */
}

/* Scrollable list area with inner radius and subtle border */
.popup-address-list-wrapper {
  flex: 1 1 auto;
  overflow: auto;
  padding: 12px;
  border-radius: 12px;          
  background: #FFF2F2;
