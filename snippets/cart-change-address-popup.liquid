</script>

<script>
  (function() {
    var popup, overlay, triggers;
    var __scrollY = 0;

    function lockBody() {
      __scrollY = window.scrollY || document.documentElement.scrollTop || 0;
      document.body.style.top = '-' + __scrollY + 'px';
      document.body.classList.add('modal-open');
    }

    function unlockBody() {
      document.body.classList.remove('modal-open');
      document.body.style.top = '';
      window.scrollTo(0, __scrollY || 0);
    }

    function initAddressPopup() {
      popup = document.getElementById('addressChangingPopup');

      // dark background overlay
      overlay = document.getElementById('addressPopupOverlay');

      // all "change address" triggers (same id reused, so use querySelectorAll)
      triggers = document.querySelectorAll('#address-changing-popup');

      if (!popup || !overlay) return;

      // attach to all "change address" buttons
      triggers.forEach(function(t) {
        t.addEventListener('click', openAddressPopup);
      });

      overlay.addEventListener('click', closeAddressPopup);
      document.addEventListener('keydown', handleEscKey);
    }

    function openAddressPopup() {
      if (!popup || !overlay) return;
      popup.classList.add('active');
      overlay.classList.add('active');
      lockBody();
    }

    function closeAddressPopup() {
      if (!popup || !overlay) return;
      popup.classList.remove('active');
      overlay.classList.remove('active');
      unlockBody();
    }

    function handleEscKey(e) {
      if (e.key === 'Escape' || e.key === 'Esc') {
        closeAddressPopup();
      }
    }

    // Prevent background scroll on iOS while allowing inner modal scroll
    function bindIOSGuards() {
      var modalRoot = document.getElementById('addressChangingPopup');
      var modalContent = modalRoot ? modalRoot.querySelector('.address-changing-popup-content') : null;
      if (!modalRoot) return;

      // Stop touchmove outside content when modal active
      document.addEventListener('touchmove', function (e) {
        if (!modalRoot.classList.contains('active')) return;
        if (modalContent && modalContent.contains(e.target)) return; // allow inside content
        e.preventDefault();
      }, { passive: false });

      // Contain scroll within modal content
      if (modalContent) {
        modalContent.addEventListener('touchmove', function () {
          // just ensuring listener is non-passive and allowed
        }, { passive: false });
      }
    }

    // keep visual selected state without relying on :has()
    function bindSelectionClass() {
      var container = document.getElementById('addressChangingPopup');
      if (!container) return;
      container.addEventListener('change', function (ev) {
        var t = ev.target;
        if (!(t && t.matches && t.matches('input[name="available_shipping_address"]'))) return;
        // remove from all labels
        container.querySelectorAll('.popup-address-card-label.is-selected').forEach(function(lbl){
          lbl.classList.remove('is-selected');
        });
        // add to current
        var lbl = t.closest('.popup-address-card-label');
        if (lbl) lbl.classList.add('is-selected');
      });
    }

    // expose if you want to call from elsewhere
    window.openAddressPopup = openAddressPopup;
    window.closeAddressPopup = closeAddressPopup;

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function(){
        initAddressPopup();
        bindSelectionClass();
        bindIOSGuards();
      });
    } else {
      initAddressPopup();
      bindSelectionClass();
      bindIOSGuards();
    }
  })();

  // Close modal when clicking outside of it
  window.onclick = function(event) {
    const overlay = document.getElementById('addressPopupOverlay');
    if (event.target === overlay) {
      if (typeof window.closeAddressPopup === 'function') closeAddressPopup();
    }
  };

  // Global handler used by inline onclick="deliverHere()"
  function deliverHere() {
    const selected = document.querySelector('#addressChangingPopup input[name="available_shipping_address"]:checked');
    if (!selected) {
      alert("Please select an address");
      return;
    }

    // Get data from selected address
    const name = selected.dataset.name || '';
    const address1 = selected.dataset.address1 || '';
    const address2 = selected.dataset.address2 || '';
    const city = selected.dataset.city || '';
    const province = selected.dataset.province || '';
    const phone = selected.dataset.phone || '';
    const email = selected.dataset.email || '';

    console.log('Selected address:', { name, address1, address2, city, province, phone, email });


    // Validate phone number
    if (!phone || phone.trim() === '' || phone === 'null' || phone === 'undefined') {
      alert('⚠️ Phone number is missing in this address. Please update your address with a valid phone number before proceeding.');
      console.warn('deliverHere blocked: Phone number is missing');
      return;
    }
    if (!province || province == 'Sharjah' || province == 'Ajman') {
      alert('⚠️ Sorry,Currently our products are available for delivery only in Dubai and Abu Dhabi.');
      return;
    }

    // Find the default card
    const card = document.querySelector(".address-default-card");
    if (!card) {
      console.error('address-default-card not found');
      return;
    }

    const addressLeft = card.querySelector(".default-address-details-left");
    const addressRight = card.querySelector(".default-address-details-right");
    if (!addressLeft || !addressRight) {
      console.error('default-address-details-left or default-address-details-right not found');
      return;
    }

    // Get all paragraphs in address-left
    const leftParas = addressLeft.querySelectorAll("p");
    console.log('Found paragraphs in default-address-details-left:', leftParas.length);

    // Update name (first paragraph with strong tag)
    const nameStrong = leftParas[0]?.querySelector("strong");
    if (nameStrong) {
      nameStrong.textContent = name;
      console.log('Updated name:', name);
    }

    // Update address1 (second paragraph)
    if (leftParas[1]) {
      leftParas[1].textContent = address1;
      console.log('Updated address1:', address1);
    }

    // Handle address2
    let cityParaIndex = 2;
    if (leftParas.length >= 5) {
      if (address2 && address2 !== "") {
        leftParas[2].textContent = address2;
        leftParas[2].style.display = "block";
        console.log('Updated address2:', address2);
      } else {
        leftParas[2].textContent = "";
        leftParas[2].style.display = "none";
        console.log('Hid address2');
      }
      cityParaIndex = 3;
    } else {
      if (address2 && address2 !== "") {
        const newPara = document.createElement('p');
        newPara.textContent = address2;
        leftParas[1].insertAdjacentElement('afterend', newPara);
        console.log('Created and added address2:', address2);
        cityParaIndex = 3;
      }
    }

    // Update city, province
  
    if (leftParas[cityParaIndex]) {
      leftParas[cityParaIndex].textContent = `${city}, ${province}`;
      document.getElementById("location-view-ld").textContent = province;
      console.log('Updated city/province:', `${city}, ${province}`);
    }

    // Update phone and email in address-right
    const infoBlocks = addressRight.querySelectorAll(".info-block");
    console.log('Found default-address-contact-blocks:', infoBlocks.length);

    if (infoBlocks[0]) {
      const phoneParas = infoBlocks[0].querySelectorAll("p");
      if (phoneParas[1]) {
        phoneParas[1].textContent = phone;
        console.log('Updated phone:', phone);
      }
    }

    if (infoBlocks[1]) {
      const emailParas = infoBlocks[1].querySelectorAll("p");
      if (emailParas[1]) {
        emailParas[1].textContent = email;
        console.log('Updated email:', email);
      }
    }

    // Update the radio button data attributes and trigger change
    const defaultCardRadio = card.querySelector('input[name="shipping_address"]');
    if (defaultCardRadio) {
      defaultCardRadio.value = selected.value;
      defaultCardRadio.setAttribute('data-name', name);
      defaultCardRadio.setAttribute('data-address1', address1);
      defaultCardRadio.setAttribute('data-address2', address2);
      defaultCardRadio.setAttribute('data-city', city);
      defaultCardRadio.setAttribute('data-province', province);
      defaultCardRadio.setAttribute('data-phone', phone);
      defaultCardRadio.setAttribute('data-email', email);
      defaultCardRadio.checked = true;

      // Set flag to prevent deliveryType change handler (if it exists in parent scope)
      if (typeof window.isAddressChanging !== 'undefined') {
        window.isAddressChanging = true;
        console.log('isAddressChanging:', window.isAddressChanging);
      }

      // Trigger change event to update location display (requires jQuery)
      if (window.jQuery) {
        jQuery(defaultCardRadio).trigger('change');
      } else if (typeof Event === 'function') {
        defaultCardRadio.dispatchEvent(new Event('change', { bubbles: true }));
      }
      console.log('Updated radio button data attributes');
      
      // Clear flag after a short delay
      setTimeout(function() {
        if (typeof window.isAddressChanging !== 'undefined') {
          window.isAddressChanging = false;
        }
      }, 100);
    }

    // Show/hide the Default badge based on whether the selected address is the original default
    const modalRoot = document.getElementById('addressChangingPopup');
    const originalDefaultId = modalRoot ? modalRoot.getAttribute('data-default-id') : null;
    const defaultBadge = card.querySelector('.default-badge');
    if (defaultBadge) {
      if (originalDefaultId && selected.value === originalDefaultId) {
        defaultBadge.style.display = 'inline-flex';
      } else {
        defaultBadge.style.display = 'none';
      }
    }

    // Close popup
    if (typeof window.closeAddressPopup === 'function') {
      window.closeAddressPopup();
    }
      let dataCity = province;
    if (dataCity != ''){
      $('#ld_delivery_areas_div .ld_content_box_row').each(function(){
        let ld_radio_label_content = $(this).find('.ld_radio_label_content').text().trim();
        if(dataCity == ld_radio_label_content){
          $(this).find('.ld_input_radio').trigger('click');
          $(this).css('display', 'block').siblings().css('display', 'none');
        }
      });    
    }
     // Disable save button until selections
    $("#datepicker").val('');
    $("#local_delivery ").val('');
    $("#timeDiv").addClass("ld_hidden");
    $("#date-view-ld").text('Not selected');   
    $("#timeslot-view-ld").text('Not selected');           
    $(".checkout-button-ctrl").prop("disabled", true); 
    $(".wk_pay_wallet.oncartpage").hide();            
    $("#save-timeslot").prop("disabled", true);   
    
    // Clear any previous error messages
    $("#checkoutButtonError").text('').hide();

    // made timeslot null
    resetLocalDeliverySelection();
    $(".open-modal-btn").removeClass("non_deliverable-address");
    $(".non_deliverable_message").css('display', 'none');
    console.log('Address update complete');

    // Sync delivery data to cart metafields after address is confirmed
    if (window.CartMetafields) {
      window.CartMetafields.syncDeliveryData();
    }
  }

  // expose globally for inline onclick
  window.deliverHere = deliverHere;
</script> 
