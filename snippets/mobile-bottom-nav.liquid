{% assign is_home = false %}
{% assign is_user = false %}
{% assign is_cart = false %}
{% assign is_rewards = false %}

{% if template == 'index' %}
  {% assign is_home = true %}
{% elsif template contains 'customers' %}
  {% assign is_user = true %}
{% elsif template == 'cart' %}
  {% assign is_cart = true %}
{% elsif template contains 'reward' or page.handle contains 'reward' %}
  {% assign is_rewards = true %}
{% endif %}


<!-- Mobile Bottom Navigation -->
<div class="mobile-bottom-nav" id="mobileBottomNav">
  <div class="nav-container">
    <div class="nav-item {% if is_home %}active{% endif %} ">
        {% if localization.language.iso_code == "ar" %}
           <a class="nav-icon-home" href="/ar" >  
            {% else %}
          <a class="nav-icon-home" href="/" >  
        {% endif %}
