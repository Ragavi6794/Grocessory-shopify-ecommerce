            <span class="nav-label">المستخدم</span>
          {% else %}
            <span class="nav-label">User</span>
          {% endif %}
          
        </a>
    </div>
    <div id="cart-nav-icon" class="nav-item {% if is_cart %}active{% endif %}">

        <div class="header__icon header__icon--cart">
          {%- liquid
            capture header_cart_status
              render 'header-cart-status', cart: cart
            endcapture
          -%}
          <a role="button" href="{{ routes.cart_url }}" onclick="event.preventDefault();try { window.shtCartDrawer.openDrawer(this); } catch(err) { window.location.assign('{{ routes.cart_url }}');}" aria-haspopup="true" aria-expanded="false" aria-controls="shtCartDrawer" class="header-cart-status js-header-cart-status-btn btn btn-plain btn-large btn-icon p-relative" id="mobileHeaderCartStatus">
            {{ header_cart_status }}
          </a>
          {% if localization.language.iso_code == "ar" %}
            <span class="nav-label">السلة </span>
          {% else %}
            <span class="nav-label">Cart</span>
          {% endif %}

      </div>
    </div>
  </div>
</div>


<script>
// Call the mobile navigation function
document.addEventListener('DOMContentLoaded', function() {
  initializeMobileNavigation();
});
</script>
