        <span class="nav-label">المكافآت</span>  
      {% else %}
        <span class="nav-label">Rewards</span>
      {% endif %}
    </div>
    
    <div class="nav-item {% if is_user %}active{% endif %}">
        {%- if customer -%}
        <a class="nav-acc-item" aria-label="{{ 'customer.account_fallback' | t }}" href="{{ routes.account_url }}" aria-label="{{ customer.first_name }}" title="{{ customer.first_name }}">
        {%- else -%}
        <a class="nav-acc-item" aria-label="{{ 'customer.log_in' | t }}" href="{{ routes.account_login_url }}">
        {%- endif -%}
          <div class="nav-icon">
            <svg width="21" height="20" viewBox="0 0 21 20" fill="none" xmlns="http://www.w3.org/2000/svg">
