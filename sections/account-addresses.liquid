        phoneInput.setCustomValidity('Invalid phone number format.');
      } else {
        validationMessage.style.display = 'none';
        phoneInput.setCustomValidity('');
      }
    });
  });
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {
  const cityInput = document.getElementById("addressCityNew");
  const zipInput = document.getElementById("addressZipNew");
  const phoneInput = document.getElementById("addressPhoneNew");
  const firstNameInput = document.getElementById("addressFirstNameNew");
  const lastNameInput = document.getElementById("addressLastNameNew");
  const address1Input = document.getElementById("addressAddress1New");
  const address2Input = document.getElementById("addressAddress2New");

  function validateWhitespace(event) {
    if (event.target.value.trim() === "") {
      event.target.setCustomValidity("This field cannot be empty or just spaces.");
    } else {
      event.target.setCustomValidity("");
    }
  }

  function restrictPhoneInput(event) {
    event.target.value = event.target.value.replace(/\D/g, ""); // Allow only numbers
  }

  function restrictNameInput(event) {
    event.target.value = event.target.value.replace(/[^A-Za-z\s]/g, ""); // Allow only letters and spaces
    validateWhitespace(event); // Ensure it's not empty or only spaces
  }

  function restrictZipInput(event) {
    event.target.value = event.target.value.replace(/\D/g, ""); // Allow only numbers
  }

  // Apply validations
  cityInput.addEventListener("input", validateWhitespace);
  zipInput.addEventListener("input", restrictZipInput);
  phoneInput.addEventListener("input", restrictPhoneInput);
  firstNameInput.addEventListener("input", restrictNameInput);
  lastNameInput.addEventListener("input", restrictNameInput);
  address1Input.addEventListener("input", validateWhitespace);
  address2Input.addEventListener("input", validateWhitespace);
});



document.addEventListener("DOMContentLoaded", function () {
  const provinceSelect = document.getElementById("addressProvinceNew");

  function addDefaultOption() {
    if (provinceSelect) {
      // Check if the default option is already added
      if (!provinceSelect.querySelector("option[value='']")) {
        const defaultOption = document.createElement("option");
        defaultOption.value = "";
        defaultOption.textContent = provinceSelect.getAttribute("data-default") || "Please Select Provience";
        defaultOption.disabled = true;
        defaultOption.selected = true;

        provinceSelect.prepend(defaultOption);
      }
    }
  }

  // Run when the page loads
  addDefaultOption();

  // Observe changes in the select field (in case options are dynamically added)
  const observer = new MutationObserver(() => {
    addDefaultOption();
  });

  observer.observe(provinceSelect, { childList: true });
});

</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const select = document.getElementById('addressCountryNew');
    if (select) {
      for (let option of select.options) {
        if (option.text.trim() === 'United Arab Emirates') {
          option.selected = true;
          break;
        }
      }
    }
  });
</script>