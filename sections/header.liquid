<script>
  //search
    document.addEventListener("DOMContentLoaded", function () {
  const searchBox = document.querySelector(".header-search-fullbox-mobile");
  const searchTrigger = document.querySelector(".js-search-open-trigger");
  const closeIcon = document.querySelector(".icon-close");

  searchTrigger.addEventListener("click", function () {
    searchBox.classList.add("active");
    closeIcon.classList.remove("d-none"); // Show close button
  });

  closeIcon.addEventListener("click", function () {
    searchBox.classList.remove("active");
    closeIcon.classList.add("d-none"); // Hide close button
  });
});

</script>

