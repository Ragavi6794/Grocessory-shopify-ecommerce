<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>



<script>
$(document).ready(function() {

 const daysOfWeek = ["sun", "mon", "tue", "wed", "thu", "fri", "sat"];
let nowString =  '{{ "now" | date: "%Y-%m-%dT%H:%M:%S" }}';
// console.log(nowString)
  var date = new  Date(nowString)
  // console.log(date)
  // console.log(date.getHours())
  
// let now = new Date(nowString);
     // const currentDate = new Date();
     // const currentDayIndex = currentDate.getDay();
     // const currentDayName = daysOfWeek[currentDayIndex];
     // const currentMonthIndex = currentDate.getMonth();
     // const currentMonthName = currentDate.toLocaleString('default', { month: 'short' });
     // const currentYear= currentDate.getFullYear();

  
      var delivery_zones_data = {{shop.metafields.delivery_zones | json}};
      // console.log(delivery_zones_data )

     if (typeof delivery_zones_data === 'object' && !Array.isArray(delivery_zones_data)) {
      delivery_zones_data = Object.values(delivery_zones_data);  
    }

// --------------Functions-----------


  function locationDetails(locationId){
      const location_details = delivery_zones_data.find(function(option){ return option.id == locationId; });
       return location_details
    }

    function getValidSlots(todayDelivery) {
    let now = new Date(nowString);
    let currentMinutes = now.getHours() * 60 + now.getMinutes();

    return todayDelivery.delivery_slots.filter(slot => {
        let [startHour, startMin] = slot.start_fmt.split(":").map(Number);
        let slotStartMinutes = startHour * 60 + startMin;
        let bookingDeadline = slotStartMinutes - slot.offset_minutes; // Calculate the latest time an order can be placed
  
        return currentMinutes <= bookingDeadline; // Slot is valid if current time is before or equal to the booking deadline
    });
}

  
function getNextDeliverySlot(allowable_days) {
    let now = new Date(nowString);
    let todayIndex = now.getDay(); 
    let currentTime = now.getHours() * 60 + now.getMinutes();

    let deliveryDays = allowable_days.sort((a, b) => a.day - b.day); // Sort days in order
     // console.log("delivery days allowable ", deliveryDays )
  
  function formatDate(date) {
        let options = { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' };
        return date.toLocaleDateString('en-US', options);
    }
  // function getValidSlots(dayDelivery) {
  //       return dayDelivery.delivery_slots.filter(slot => {
  //           let [startHour, startMin] = slot.start_fmt.split(":").map(Number);
  //           let startMinutes = startHour * 60 + startMin;
  //           return startMinutes > currentTime;
  //       });
  //   }



    let todayDelivery = allowable_days.find(day => day.day === todayIndex);
  
    if (todayDelivery) {
        let validSlots = getValidSlots(todayDelivery);
        if (validSlots.length > 0) {
            return {
                date: formatDate(now),
                slot: validSlots[0] // Pick the nearest valid slot
            };
        }
    }
    for (let day of deliveryDays) {
        if (day.day > todayIndex) { // Future days
            if (day.delivery_slots.length > 0) {
                let nextDeliveryDate = new Date(nowString);
                let daysToAdd = day.day - todayIndex;
                nextDeliveryDate.setDate(nextDeliveryDate.getDate() + daysToAdd);
                
                return {
                    date: formatDate(nextDeliveryDate),
                    slot: day.delivery_slots[0] // Pick the first slot on that day
                };
            }
        }
    }
  
   
    // If no slots found in the current week, loop back to the next available delivery day
    for (let day of deliveryDays) {
        if (day.delivery_slots.length > 0) {
            let nextDeliveryDate = new Date(nowString);
            let daysToAdd = (7 - todayIndex) + day.day;
            nextDeliveryDate.setDate(nextDeliveryDate.getDate() + daysToAdd);
            
            return {
                date: formatDate(nextDeliveryDate),
                slot: day.delivery_slots[0]
            };
        }
    }

    return "No delivery slots available";
}

  
function getTimeLeftForNextSlot(allowable_days) {
    let now = new Date(nowString);
    let todayIndex = now.getDay();
    let currentMinutes = now.getHours() * 60 + now.getMinutes();

    let sortedDays = allowable_days.sort((a, b) => a.day - b.day);

    for (let i = 0; i < sortedDays.length; i++) {
        let { day, delivery_slots } = sortedDays[i];

        if (day=== todayIndex) {
            for (let slot of delivery_slots) {
                let [startHour, startMinute] = slot.start_fmt.split(":").map(Number);
                let slotStartMinutes = startHour * 60 + startMinute;

                if (slotStartMinutes > currentMinutes) {
                    let timeLeft = slotStartMinutes - currentMinutes;
                    let hours = Math.floor(timeLeft / 60);
                    let minutes = timeLeft % 60;
                    return `${hours} hrs and ${minutes} mins`;
                }
            }
        }

        if (day > todayIndex || i === sortedDays.length - 1) {
            let nextDayIndex = (day > todayIndex) ? day : sortedDays[0].day;
            let daysToAdd = (nextDayIndex >= todayIndex) ? (nextDayIndex - todayIndex) : (7 - todayIndex + nextDayIndex);

            let nextSlot = sortedDays.find(day => day.day === nextDayIndex)?.delivery_slots[0];

            if (nextSlot) {
                let [startHour, startMinute] = nextSlot.start_fmt.split(":").map(Number);
                let nextSlotDate = new Date(nowString);
                nextSlotDate.setDate(nextSlotDate.getDate() + daysToAdd);
                nextSlotDate.setHours(startHour, startMinute, 0, 0);

                let timeLeftMs = nextSlotDate.getTime() - now.getTime();
                let timeLeftMinutes = Math.floor(timeLeftMs / 60000);
                let timeLeftHours = Math.floor(timeLeftMinutes / 60);
                let timeLeftDays = Math.floor(timeLeftHours / 24);

                if (timeLeftDays > 0) {
                    return `${timeLeftDays} days, ${timeLeftHours % 24} hrs, and ${timeLeftMinutes % 60} mins`;
                } else {
                    return `${timeLeftHours} hrs and ${timeLeftMinutes % 60} mins`;
                }
            }
        }
    }

    return "No available slots found.";
}

function formatterDate(dateInp) {
  const date = new Date(dateInp);
  const options = { month: 'short', weekday: 'short', day: '2-digit' };
  const formattedDate = new Intl.DateTimeFormat('en-GB', options).format(date);
  const parts = formattedDate.split(' ');
  const finalFormattedDate = `${parts[1]} ${parts[2]} (${parts[0].replace(',', '')})`;

  return finalFormattedDate;
}
  
  
  function convertToAMPM(time) {
    let [start, end] = time.split('-'); 
    let [startHour, startMin] = start.split(':').map(Number); 
    let [endHour, endMin] = end.split(':').map(Number);

    function formatTime(hour, minute) {
        let period = hour >= 12 ? 'PM' : 'AM';
        hour = hour % 12;  
        hour = hour === 0 ? 12 : hour; 
        return `${hour}${period}`;
    }

    let startAMPM = formatTime(startHour, startMin);
    let endAMPM = formatTime(endHour, endMin);

    return `${startAMPM}-${endAMPM}`;
}

  
  // --------------------Functions End-----

  // Adding options to location selector dropdown
   $.each(delivery_zones_data , function(key, option) {
      var newOption = $('<option>', {
        value: option.id,   
        text: option.name  
      });
      $('#delivery_locations_selector').append(newOption);
    });
// -------------------------------------


  function renderDeliveryInfo(locationId) {
    $(`#ld_delivery_${locationId}`).click();

    let locationDetailsObj = locationDetails(locationId);
    let allowableDays = locationDetailsObj.allowable_days;
    let locationName = locationDetailsObj.name;
    const { date, slot } = getNextDeliverySlot(allowableDays);
    const nextDeliveryDateFormatted = formatterDate(date);
    let timeLeft = getTimeLeftForNextSlot(allowableDays);

    $("#day-of-delivery").text(nextDeliveryDateFormatted);
    let timePeriod = `${slot.start_fmt}-${slot.end_fmt}`;
    let tp = convertToAMPM(timePeriod);
    $("#time-slot-of-delivery").text(tp);
    $("#location-for-order").text(locationName);
    $("#time-slot-of-delivery-prod").text(nextDeliveryDateFormatted + "  " + tp);
    $("#time-left-to-place-order").text(timeLeft);
}

  
    const storedLocationId = localStorage.getItem("location_id");


        // default selection=dubai
    $('#delivery_locations_selector option').each(function() { 
              if ($(this).text() === 'Dubai') {
                  $(this).prop('selected', true);
                  const defaultLocationId = $(this).val();
                  localStorage.setItem("location_id", defaultLocationId);
                  renderDeliveryInfo(defaultLocationId); // Render default delivery info
                }
              });

  // closed
$('#delivery_locations_selector').on("change",function() {
    const selected_location_id = $(this).val();
  // appusablelocation_id = selected_location_id;
  localStorage.setItem("location_id", selected_location_id)
  
