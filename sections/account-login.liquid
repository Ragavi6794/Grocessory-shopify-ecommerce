<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

<script>
$(document).ready(function() {
  const otpLoginBtn = $("#otpLoginBtn");
  const passwordLoginBtn = $("#passwordLoginBtn");

  const otpLoginSection = $('#mo-otp-login div');
  const passwordLoginSection = $("#login");
  
  const forgotpassword = $('.forgotpassword');
  const loginblock = $('.login-block');
  const recover = $("#recover");
  const backtologin = $(".backtologin");

  var otninputbox = $('.motw-relative.motw-w-full');
  otninputbox.css("marginTop", "20px");

  loginblock.show();
   recover.hide();
  otpLoginSection.hide();

  passwordLoginBtn.addClass("active");

  otpLoginBtn.on('click', function() {

    {% comment %}miniOrange code start{% endcomment %}
    $("#MOLoginModal").css("display", "block");
    $("#shopify-section-template--19125620343037__17394385396363c35f").css("display", "none");
    {% comment %}miniOrange code end{% endcomment %}
    
    otpLoginSection.show();
    otpLoginBtn.addClass("active");
    passwordLoginSection.hide();
    passwordLoginBtn.removeClass("active");
  });


  passwordLoginBtn.on('click', function() {
    $("#MOLoginModal").css("display", "none");
    $("#shopify-section-template--19125620343037__17394385396363c35f").css("display", "block");
    
    otpLoginSection.hide();
    otpLoginBtn.removeClass("active");
    passwordLoginSection.show();
    passwordLoginBtn.addClass("active");
  });


  forgotpassword.on('click', function() {
    loginblock.hide(); 
    recover.show();  
  });


  backtologin.on('click', function() {
    recover.hide();  
    loginblock.show(); 
  });


   // $(".reset-password-send").on("click",()=>{ localStorage.setItem("reset-password",true);})
   // let resetPass  = localStorage.getItem("reset-password");  
   // if(resetPass == "true"){ $("#recover").show(); $(".login-block").hide();} else { $("#recover").hide(); $(".login-block").show(); }

    $(".backtologin").on("click",()=>{
     localStorage.removeItem("reset-password");    
  })

    
  
});
  
</script>

<style>
  .login-headingMain {
    display: flex;
    gap: 10px;
    justify-content: space-around;
    cursor:pointer;
}
   .active {
    text-decoration: underline;
  }

 #mo-otp-login  a.motw-inline-block {
        font-weight: 600!important;
       margin-top: 20px!important;
   border-bottom: 1px solid #000;
  }
</style>
