{%- liquid
  assign image_loading = 'loading="eager" decoding="async" fetchpriority="high" src='
  assign images = ''
  assign placeholder = 'lifestyle-1' | placeholder_svg_tag: 'placeholder media of-contain h-100 w-100'
  assign time_run = section.blocks.size | times: section.settings.speed

  if section.settings.content_position_desktop contains 'mask--top'
    assign overlay_style_md = 'sht-mask--top-md'
  elsif section.settings.content_position_desktop contains 'mask--bottom'
    assign overlay_style_md = 'sht-mask--bottom-md'
  endif

  if section.settings.content_position_mobile contains 'mask--top'
    assign overlay_style = 'sht-mask--top'
  elsif section.settings.content_position_mobile contains 'mask--bottom'
    assign overlay_style = 'sht-mask--bottom'
  endif

  unless section.settings.color_mask_overlay.alpha == 0.0 or section.settings.color_mask_overlay == blank
    assign overlay_color = '--color-mask-overlay:' | append: section.settings.color_mask_overlay.red | append: ',' | append: section.settings.color_mask_overlay.green | append: ',' | append: section.settings.color_mask_overlay.blue | append: ';'
  endunless
  unless section.settings.color_text_overlay.alpha == 0.0 or section.settings.color_text_overlay == blank
    assign content_color = 'color:' | append: section.settings.color_text_overlay | append: ';'
  endunless
-%}
<div class="section s--banner-spacing section-index--{{section.index |  replace: '1', 'first' }} color-{{- section.settings.color_scheme }}">
  <div class="ctnr " data-ui-component="Moving Image Banner Section">
    <sht-moving-image>
      <div class="sht-mask p-relative corner-radius-m bs-card js-moving-image-container color-{{ section.settings.color_scheme }} {{ overlay_style }} {{ overlay_style_md }}" style="--mh-xs: {{ section.settings.height_mobile }};--mh-md:{{ section.settings.height_desktop }}; --overlay: {{ section.settings.image_overlay_opacity }}; {{ overlay_color }}">
        <div class="fw-nowrap w-100 p-absolute d-flex h-100" style="--time-run: {{ time_run }}s;">
          {%- liquid
            for block in section.blocks
              case block.type
                when 'image'
                  assign media = placeholder
                  assign media_alt = block.settings.background_image.alt | default: block.settings.background_image.image | split: '/' | last
                  assign media = block.settings.background_image | image_url: width: block.settings.background_image.width | image_tag: widths: '750, 950, 1024, 1200', sizes: '(min-width: 361px) calc(100vw/2), calc(100vw/3)', alt: media_alt, class: 'media of-contain w-100 h-100'
                  assign ratio = block.settings.background_image.aspect_ratio
                  assign media_style = ''
                  if block.settings.background_image == blank
                    assign ratio = 1
                    assign media_style = 'w-100'
                  endif
                  capture images
                    echo images
                    echo '<div class="moving-image media-wrapper media_style h-100" style="--ratio: ratio_image ">' | replace: 'ratio_image', ratio | replace: 'media_style', media_style
                    echo media | replace: 'src=', image_loading
                    echo '</div>'
                  endcapture
              endcase
            endfor
          -%}
          {% if images != '' %}
            <div class="moving-image-inner d-flex fw-nowrap">
              {{ images }}
            </div>
            <div class="moving-image-inner d-flex fw-nowrap">
              {{ images }}
            </div>
            {%- if section.blocks.size == 1 -%}
              <div class="moving-image-inner d-flex fw-nowrap">
                {{ images }}
              </div>
            {%- endif -%}
          {% endif %}
        </div>
        {%- capture header_style -%}
            style="--mh-xs: {{ section.settings.height_mobile }};--mh-md:{{ section.settings.height_desktop }}; {{ content_color }}"
          {%- endcapture -%}
        {% render 'section-header', content_position_desktop: section.settings.content_position_desktop, content_position_mobile: section.settings.content_position_mobile, subheading: section.settings.subheading, heading: section.settings.heading, heading_size: section.settings.heading_size, description: section.settings.description, countdown: section.settings.enable_countdown_timer, button_1_label: section.settings.button_1_label, button_1_style: section.settings.button_1_style, button_1_link: section.settings.button_1_link, button_2_label: section.settings.button_2_label, button_2_style: section.settings.button_2_style, button_2_link: section.settings.button_2_link, section: section, classes: 'w-100 h-100 p-relative zi-1 s-card', header_style: header_style %}
      </div>
    </sht-moving-image>
  </div>
  {%- render 'section-id', section: section -%}
</div>
