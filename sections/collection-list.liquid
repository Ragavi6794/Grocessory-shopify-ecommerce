{%- liquid
  assign items_per_row_on_desktop = section.settings.items_per_row_on_desktop | plus: 0
  assign items_per_row_on_mobile = section.settings.items_per_row_on_mobile | plus: 0

  assign column_mobile = 12.0 | divided_by: items_per_row_on_mobile
  assign column_desktop = 12.0 | divided_by: items_per_row_on_desktop
  assign item_class = section.settings.enable_carousel | default: '' | replace: 'true', 'carousel__item js-carousel-item p-relative scrollable-aln-start d-flex fd-column middle-xs fg-1 fs-0 p-zero'
-%}
<div class="section section-index--{{section.index |  replace: '1', 'first' }} {% render 'sections-spacing' %} color-{{- section.settings.color_scheme }}">
  <div class="ctnr background" data-ui-component="Collection List Section" role="region" aria-labelledby="sectionHeading-{{ section.id | md5 | truncate: 12, "" }}">
    <div class="{{ section.settings.content_alignment }}">
      {% render 'section-header',
        content_align: section.settings.content_alignment,
        subheading: section.settings.subheading,
        heading: section.settings.heading,
        heading_size: section.settings.heading_size,
        description: section.settings.description,
        section: section,
        button_label: section.settings.button_main_text,
        button_link: routes.collections_url
      %}
      <div class="s-content js-animate">
        <sht-carousel class="sht-carousel p-relative d-block " data-enable="{{ section.settings.enable_carousel }}">
          <div aria-atomic="true" class="o-hidden rw {{ section.settings.enable_carousel | default: '' | replace: 'true', 'fw-nowrap carousel ox-auto p-relative scrollable scrollable-x disable-scrollbars js-carousel-items m-zero' }}">
            {%- if section.blocks.size > 0 -%}
              {%- assign total_items = section.blocks.size -%}
              {%- for block in section.blocks -%}
                <sht-carousel-itm class="clm anm anm-fadeInUpLarge {{ item_class }}" style="--w-xs:{{ column_mobile }};--w-md: {{ column_desktop }}; --delay: {{ forloop.index | plus: 2 | times: 0.05 -}}s; --duration: .7s" role="group" aria-roledescription="Slide" aria-label="{{ 'accessibility.slide' | t }} {{ forloop.index }} {{ 'accessibility.of' | t }} {{ forloop.length }}" data-item-index="{{ forloop.index }}" {{ block.shopify_attributes }}>
                  {% render 'card-collection',
                    collection: block.settings.collection,
                    custom_image: block.settings.custom_image,
                    custom_title: block.settings.custom_title,
                    custom_link: block.settings.custom_link,
                    media_ratio: settings.collection_image_ratio,
                    show_product_count: settings.show_product_count
                  %}
                </sht-carousel-itm>
              {%- endfor -%}
            {%- else -%}
              {%- assign total_items = 4 -%}
              {%- for i in (1..6) -%}
                <sht-carousel-itm class="clm anm anm-fadeInUpLarge {{ item_class }}" style="--w-xs:{{ column_mobile }};--w-md: {{ column_desktop }}; --delay: {{ forloop.index | plus: 2 | times: 0.05 -}}s; --duration: .7s" role="group" aria-roledescription="Slide" aria-label="{{ 'accessibility.slide' | t }} {{ forloop.index }} {{ 'accessibility.of' | t }} {{ forloop.length }}" data-item-index="{{ forloop.index }}">
                  {% render 'card-collection-placeholder',
                    media_ratio: settings.collection_image_ratio,
                    show_product_count: settings.show_product_count
                  %}
                </sht-carousel-itm>
              {%- endfor -%}
            {%- endif -%}
          </div>
          <div class="carousel-pagination carousel-pagination--position w-100 p-absolute no-js-hidden d-none {{ section.settings.enable_carousel | replace: 'true', 'd-block-md' }}">
            <div class="p-absolute zi-1 left-0">
              <button type="button" data-step="{{ items_per_row_on_desktop }}" class="js-carousel-prev-btn btn btn-secondary btn-icon icon btn-large " aria-label="{{ 'accessibility.previous_slide' | t }}" name="previous" disabled>{% render 'icon-arrow-left' %}</button>
            </div>
            <div class="p-absolute zi-1 right-0">
              <button type="button" data-step="{{ items_per_row_on_desktop }}"  class="js-carousel-next-btn btn btn-secondary btn-icon icon btn-large" aria-label="{{ 'accessibility.next_slide' | t }}" name="next" disabled>{% render 'icon-arrow-right' %}</button>
            </div>
          </div>

          {% if section.settings.show_progress_indicator == true and section.settings.enable_carousel == true %}
            <div class="slider-scrollbar {% if items_per_row_on_desktop < total_items %} d-flex-md {% else %} d-none-md {% endif %} {% if items_per_row_on_mobile < total_items %} d-flex {% else %} d-none {% endif %}">
              <div class="scrollbar-track js-scrollbar-track" data-thumb-mobile="{{ items_per_row_on_mobile }}" data-thumb-desk="{{ items_per_row_on_desktop }}" data-thumb-total="{{ total_items }}" style="--width-thumb-desktop: {{ items_per_row_on_desktop | times: 100.0 | divided_by: total_items }}%; --width-thumb-mobile: {{ items_per_row_on_mobile | times: 100.0 | divided_by: total_items }}%">
                <div class="scrollbar-thumb js-scrollbar-thumb"></div>
              </div>
            </div>
          {% endif %}

        </sht-carousel>
        {% comment %}<div class="s-footer anm anm-fadeInUpLarge {{ section.settings.enable_view_all | default: 'd-none' | replace: 'true', '' }} {{ section.settings.button_main_text | default: 'd-none' | replace: section.settings.button_main_text, '' }}"  style="--duration: .7s; --delay: .15s">
          <a class="btn btn-primary btn-large hide-empty" href="{{- routes.collections_url -}}">
            {{- section.settings.button_main_text -}}
          </a>
        </div>{% endcomment %}
      </div>
    </div>

  </div>
  {%- render 'section-id', section: section -%}
</div>

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "class": "collection_listSection",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.headers.header_general.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.settings.color_scheme.label",
      "default": "scheme-3"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:general.settings.section_subheading.label",
      "default": "Add a tagline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:general.settings.section_heading.label",
      "default": "Our Collections"
    },
    {
      "type": "select",
      "label": "t:general.settings.heading_size.label",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:general.settings.heading_size.options.h2.label"
        },
        {
          "value": "h3",
          "label": "t:general.settings.heading_size.options.h3.label"
        },
        {
          "value": "h4",
          "label": "t:general.settings.heading_size.options.h4.label"
        },
        {
          "value": "h5",
          "label": "t:general.settings.heading_size.options.h5.label"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:general.settings.section_description.label"
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.header_layout.content"
    },
    {
      "type": "select",
      "id": "items_per_row_on_desktop",
      "label": "t:general.settings.items_per_row_on_desktop.label",
      "default": "4",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
        },
        {
          "value": "7",
          "label": "7"
        },
        {
          "value": "8",
          "label": "8"
        },
        {
          "value": "9",
          "label": "9"
        },
        {
          "value": "10",
          "label": "10"
        },
        {
          "value": "11",
          "label": "11"
        },
        {
          "value": "12",
          "label": "12"
        }
      ]
    },
    {
      "type": "select",
      "id": "items_per_row_on_mobile",
      "label": "t:general.settings.items_per_row_on_mobile.label",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_carousel",
      "label": "t:general.settings.enable_carousel.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_progress_indicator",
      "label": "t:general.settings.show_progress_indicator.label",
      "default": false
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:general.settings.content_alignment.label",
      "default": "ta-center",
      "options": [
        {
          "value": "ta-left",
          "label": "t:general.settings.option_left.label"
        },
        {
          "value": "ta-center",
          "label": "t:general.settings.option_center.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.header_button.content"
    },
    {
      "type": "checkbox",
      "id": "enable_view_all",
      "label": "t:sections.collection_list.settings.show_view_all_button.label",
      "default": false
    },
    {
      "type": "text",
      "id": "button_main_text",
      "label": "t:general.settings.label.label",
      "default": "View all collections",
      "info": "t:general.settings.button_label.info"
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:general.settings.collection.label"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom image"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list.name"
    }
  ]
}
{% endschema %}