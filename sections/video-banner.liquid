{%- liquid

  assign video_type_desktop = section.settings.video_url_desktop.type
  if section.settings.video_hosted_desktop
    assign video_type_desktop = 'local_video'
  endif

  assign video_type_mobile = section.settings.video_url_mobile.type
  if section.settings.video_hosted_mobile
    assign video_type_mobile = 'local_video'
  endif

  if section.settings.content_position_desktop contains 'mask--top'
    assign overlay_style_md = 'sht-mask--top-md'
  elsif section.settings.content_position_desktop contains 'mask--bottom'
    assign overlay_style_md = 'sht-mask--bottom-md'
  endif

  if section.settings.content_position_mobile contains 'mask--top'
    assign overlay_style = 'sht-mask--top'
  elsif section.settings.content_position_mobile contains 'mask--bottom'
    assign overlay_style = 'sht-mask--bottom'
  endif

  assign content_align_class_mobile = 'top-xs ta-left start-xs'
  if section.settings.content_position_mobile contains 'ta-center'
    assign content_align_class_mobile = 'middle-xs ta-center center-xs'
  endif

  unless section.settings.color_mask_overlay.alpha == 0.0 or section.settings.color_mask_overlay == blank
    assign overlay_color = '--color-mask-overlay:' | append: section.settings.color_mask_overlay.red | append: ',' | append: section.settings.color_mask_overlay.green | append: ',' | append: section.settings.color_mask_overlay.blue | append: ';'
  endunless
  unless section.settings.color_text_overlay.alpha == 0.0 or section.settings.color_text_overlay == blank
    assign content_color = 'color:' | append: section.settings.color_text_overlay | append: ';'
  endunless

  assign content_position = section.settings.content_position_mobile | append: ' ' | append: section.settings.content_position_desktop
-%}
<div class="section s--banner-spacing section-index--{{section.index |  replace: '1', 'first' }} color-{{- section.settings.color_scheme }}">
  <div  data-ui-component="Video Banner Section" role="region" aria-labelledby="sectionHeading-{{ section.id | md5 | truncate: 12, "" }}">
    <div class="p-relative sht-mask corner-radius-m bs-card {{ overlay_style }} {{ overlay_style_md }}" style="--overlay: {{ section.settings.image_overlay_opacity }}; {{ overlay_color }}">
      <sht-load-video class="p-absolute w-100 h-100 js-animate anm anm-zoomOut" data-video-type="{{ video_type_desktop }}" data-video-id="{{ section.settings.video_url_desktop.id }}">
        {% if section.settings.video_hosted_desktop %}
          {% capture local_video_desktop %}
            {{- section.settings.video_hosted_desktop | video_tag: autoplay: true, controls: false, loop: true, preload: 'none', class: 'video-local center-middle p-absolute of-cover mih w-100' -}}
          {% endcapture %}
          {{ local_video_desktop | replace: '<source src="', '<source data-src="' }}
        {% else %}
          <iframe tabindex="-1" title="{{ section.settings.video_url_desktop.type }}" class="video-ifram js-local-video w-100v center-middle p-absolute mih miw" allow="autoplay; encrypted-media"
            data-src="
            {%- if section.settings.video_url_desktop.type == 'youtube' -%}
              https://www.youtube.com/embed/{{ section.settings.video_url_desktop.id }}?version=3&enablejsapi=1&mute=1&loop=1&controls=0&rel=0&showinfo=0&autoplay=1&playlist={{ section.settings.video_url_desktop.id }}
            {%- elsif section.settings.video_url_desktop.type == 'vimeo' -%}
              https://player.vimeo.com/video/{{ section.settings.video_url_desktop.id }}?api=1&background=1&autoplay=1&loop=1&title=0&byline=0&portrait=0&controls=0&muted=1
            {%- endif -%}" style="--miw:177.77vh;--h-xs:56.25vw;">
          </iframe>
        {% endif %}
      </sht-load-video>
      {% if section.settings.video_hosted_mobile != blank or video_type_mobile != blank %}
        <sht-load-video class="p-absolute w-100 h-100 js-animate anm anm-zoomOut d-none-md d-block" data-video-type="{{ video_type_mobile }}" data-video-id="{{ section.settings.video_url_mobile.id }}">
          {% if section.settings.video_hosted_mobile %}
            {% capture local_video_mobile %}
              {{- section.settings.video_hosted_mobile | video_tag: autoplay: true, controls: false, loop: true, preload: 'none', class: 'video-local center-middle p-absolute of-cover mih w-100' -}}
            {% endcapture %}
            {{ local_video_mobile | replace: '<source src="', '<source data-src="' }}
          {% else %}
            <iframe tabindex="-1" title="{{ section.settings.video_url_mobile.type }}" class="video-ifram js-local-video w-100v center-middle p-absolute mih miw" allow="autoplay; encrypted-media"
              data-src="
              {%- if section.settings.video_url_mobile.type == 'youtube' -%}
                https://www.youtube.com/embed/{{ section.settings.video_url_mobile.id }}?version=3&enablejsapi=1&mute=1&loop=1&controls=0&rel=0&showinfo=0&autoplay=1&playlist={{ section.settings.video_url_mobile.id }}
              {%- elsif section.settings.video_url_mobile.type == 'vimeo' -%}
                https://player.vimeo.com/video/{{ section.settings.video_url_mobile.id }}?api=1&background=1&autoplay=1&loop=1&title=0&byline=0&portrait=0&controls=0&muted=1
              {%- endif -%}" style="--miw:177.77vh;--h-xs:56.25vw;">
            </iframe>
          {% endif %}
        </sht-load-video>
      {% endif %}
      <div class="s-header__content s-card d-flex fd-column zi-1 w-100 h-100 p-relative
      {{ content_position }}"
      style="--mh-xs: {{ section.settings.height_mobile }};--mh-md:{{ section.settings.height_desktop }}; {{ content_color }}">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
            {%- when 'subheading' -%}
              {%- if block.settings.subheading != blank -%}
                <span class="s-header__subheading d-inline-block fw-700 hide-empty">{{- block.settings.subheading -}}</span>
              {%- endif -%}
            {%- when 'heading' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="s-header__heading {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                  {{- block.settings.heading -}}
                </h2>
              {%- endif -%}
            {%- when 'description' -%}
              {%- if block.settings.description != blank -%}
                <div class="s-header__description" {{ block.shopify_attributes }}>
                  {{- block.settings.description -}}
                </div>
              {%- endif -%}
            {%- when 'countdown' -%}
              <div class="s-header__countdown countdown-wrapper d-grid w-100" {{ block.shopify_attributes }}>
                  {%- render 'countdown', block: block, class: content_position -%}
              </div>
            {%- when 'buttons' -%}
              <div class="s-header__buttons d-flex fw-wrap gap-8 {{ content_align_class_mobile }}" {{ block.shopify_attributes }}>
                {%- if block.settings.button_1_label != blank -%}
                  <a class="btn btn-large ta-center {{ block.settings.button_1_style }}" href="{{- block.settings.button_1_link | default: '#' -}}">{{- block.settings.button_1_label -}}</a>
                {%- endif -%}
                {%- if block.settings.button_2_label != blank -%}
                  <a class="btn btn-large ta-center {{ block.settings.button_2_style }}" href="{{- block.settings.button_2_link | default: '#' -}}">{{- block.settings.button_2_label -}}</a>
                {%- endif -%}
              </div>
            {%- endcase -%}
          {%- endfor -%}
      </div>
    </div>

  </div>
  {%- render 'section-id', section: section -%}
</div>
{% schema %}
