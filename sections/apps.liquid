
<div class="section section-index--{{section.index |  replace: '1', 'first' }} {% render 'sections-spacing' %} color-{{- section.settings.color_scheme }} o-hidden
{{ section.settings.remove_padding_top | replace: 'true', 'pt-0' | replace: section.settings.remove_padding_top, '' }} {{ section.settings.remove_padding_bottom | replace: 'true', 'pb-0' | replace: section.settings.remove_padding_bottom, '' }}
" data-ui-component="Apps Section">
  <div class="ctnr background ">
    {%- for block in section.blocks -%}
      {% render block %}
    {%- endfor -%}
  </div>
  {%- render 'section-id', section: section -%}
</div>

{% schema %}
  {
    "name": "t:sections.apps.name",
    "settings": [
      {
        "type": "header",
        "content": "t:general.settings.headers.header_general.content"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:general.settings.color_scheme.label",
        "default": "scheme-1"
      },
      {
        "type": "header",
        "content": "t:general.settings.headers.header_layout.content"
      },
      {
        "type": "checkbox",
        "id": "remove_padding_top",
        "default": false,
        "label": "t:sections.apps.settings.remove_padding_top.label"
      },
      {
        "type": "checkbox",
        "id": "remove_padding_bottom",
        "default": false,
        "label": "t:sections.apps.settings.remove_padding_bottom.label"
      }
    ],
    "blocks": [
      {
        "type": "@app"
      }
    ],
    "presets": [
      {
        "name": "t:sections.apps.name"
      }
    ]
  }
{% endschema %}
