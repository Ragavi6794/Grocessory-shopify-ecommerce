<div class="flex-1">
  <div class="product-comparison-item p-relative">
    <sht-prd-slideshow class="product-comparison__media d-flex fd-column gap-24 p-relative corner-radius-m o-hidden" data-hide-variant-image="true" data-section="{{ section.id }}-{{ product.id }}">
      <div class="product-slideshow__slider">
        {% render 'product-comparison-gallery', product: product, section: section, place_holder: place_holder, section.id: section.id, hide_variant_image: true, is_first_image: false, ratio: settings.product_comparison_image_ratio %}
      </div>
    </sht-prd-slideshow>

    <div class="js-product-comparison-item product-comparison-info mt-16 wb-break-word">
      <div class="color-light subtext mb-4 {{ settings.product_comparison_show_vendor | default: 'd-none' | replace: 'true', '' }}">
        <span class="visually-hidden">{{- 'accessibility.vendor' | t -}}</span>
        <span>{{- product.vendor -}}</span>
      </div>
      <h3 class="card__heading fw-700 m-zero mb-4">
        <a href="{{ product.url | default: '#' }}" class="pe-no-link">
          {{ product.title | escape }}
        </a>
      </h3>
      <div class="d-flex fw-wrap gap-8" id="productComparisonPrice-{{ section.id }}-{{ product.id }}" role="status">
        {% render 'product-price', product: product, target: product.selected_or_first_available_variant %}
      </div>
      <div class="product-comparison-attributes mt-16 color-{{ settings.color_scheme_product_attributes }} {{ settings.product_comparison_show_attributes | default: 'd-none' | replace: 'true', '' }}">
        {%- render 'product-attributes', product: product, namespace_keys: settings.product_attributes_metafield_namespace, att_style: 'mb-0' -%}
      </div>
    </div>
  </div>
  <div class="js-button-remove mt-8" data-product="{{ product.id }}"></div>

  <div class="js-product-comparison-variant mt-listing">
    {% liquid
      assign variant_label = settings.variant_swatches_option | downcase
      assign product_form_id = 'productComparisonForm-' | append: product.id
      %}
    {%- if product != blank -%}
      <div class="pb-12 pb-md-20 wb-break-word">
        <span class="h5">{{ 'sections.product_comparison.options' | t }}</span>
      </div>
      <div class="product__variants gap-16 d-flex fd-column">
        {%- unless product.has_only_default_variant -%}
          <div id="productComparisonVariantPicker-{{ product.id }}">
            <sht-show-comparison-variant-radios class="product__variants--radios d-flex fd-column gap-24 no-js-hidden" data-product="{{ product.id }}" data-section="{{ section.id }}" data-url="{{ product.url }}">
              {%- for option in product.options_with_values -%}
                {% assign index = forloop.index | minus: 1 %}
                <fieldset class="form__fields gap-12 product-option js-featured-variant-radio-container d-flex fw-wrap p-zero m-zero b-zero">
                  <legend class="p-zero m-zero product-option__name">
                    <span class="mr-8 fw-700">{{ option.name }}</span>
                    <span class="js-variant-radio-option-name hide-empty" data-option-name="{{ option.name }}">
                      {{ product.selected_or_first_available_variant.options[index] }}
                    </span>
                  </legend>
                  {%- assign variant_name = option.name | downcase -%}
                  {%- if variant_label contains variant_name -%}
                    <div class="clr-swh no-js-hidden">
                      <sht-show-prd-comparison-variant-swtch class="variant-swatchs d-flex fw-wrap gap-8 r-gap-12 hide-empty">
                        {%- for value in option.values -%}
                          <div class="product-swatches__item js-variant-option-value product-option__value {% if product.selected_or_first_available_variant.available == false and option.selected_value == value %}product-option--sold-out{% endif %}" data-value="{{ value | escape }}-{{ index }}" data-snipets="core-color-swatch">
                            <input type="radio" aria-label="{{ option.name }}" class="input--variant form__control js-variant-item js-comparison-variant-radio-item {{ input_class | default: 'js-variant-radio-item' }} visually-hidden"
                              id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                              name="{{ option.name }}"
                              value="{{ value | escape }}"
                              data-variant-value="{{ value | escape }}-{{ index }}"
                              form="{{ product_form_id }}"
                              {% if option.selected_value == value %}checked{% endif %}>
                            <label class="form__label form__label--{{- settings.swatch_source }} d-block" for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" tabindex="-1">
                              <span class="product-swatches product-swatches--{{- settings.swatch_source }} product-variant-label o-hidden js-variant-swatch-item d-block br-50p subtext p-relative c-pointer o-hidden d-flex center-xs middle-xs ta-center" aria-hidden="true" data-option-value="{{ value | downcase | escape | remove: " " }}" data-swatch-source="{{ settings.swatch_source }}">
                                {% if settings.swatch_source == 'variant_image' %}
                                  {%- liquid
                                      assign selected_variant = ''
                                      for variant in product.variants
                                        if variant.title contains value and variant.image
                                          assign selected_variant = variant
                                          break
                                        endif
                                      endfor
                                  -%}
                                  {%- if selected_variant.image -%}
                                    {{ selected_variant.image | image_url: width: 200 | image_tag: widths: '200', class: 'product-swatches-image absolute zi-1 top-0 left-0 w-100 h-100 of-cover', loading: "lazy" , fetchpriority: "auto", decoding: "async" }}
                                  {%- endif -%}
                                {% endif %}
                                <span class="variant-option-label js-variant-option-label pe-none p-absolute">{{ value }}</span>
                              </span>
                            </label>
                          </div>
                          {%- endfor -%}
                      </sht-show-prd-comparison-variant-swtch>
                    </div>
                  {%- else -%}
                    {%- for value in option.values -%}
                      <div class="form__field js-variant-option-value product-option__value {% if product.selected_or_first_available_variant.available == false and option.selected_value == value %}product-option--sold-out{% endif %}" data-value="{{ value | escape }}-{{ index }}" data-option-index="{{ index }}">
                        <input type="radio" class="form__control input--variant js-variant-item js-comparison-variant-radio-item visually-hidden"
                          id="{{ section.id }}-{{ product.id }}-{{ option.position }}-{{ forloop.index0 }}" name="{{ option.name }}" value="{{ value | escape }}" data-variant-value="{{ value | escape }}-{{ index }}"
                          form="{{ product_form_id }}"
                          {% if option.selected_value == value %} checked{% endif %}
                        >
                        <label class="form__label product-option__label d-block" for="{{ section.id }}-{{ product.id }}-{{ option.position }}-{{ forloop.index0 }}">{{ value }}</label>
                      </div>
                    {%- endfor -%}
                  {%- endif -%}
                </fieldset>
              {%- endfor -%}
              <script type="application/json">
                {{ product.variants | json }}
              </script>
            </sht-show-comparison-variant-radios>
          </div>
        {%- endunless -%}
        <div class="hide-empty fw-700" id="productComparisonInventoryTracking-{{ product.id }}">
          {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
            {%- liquid
              assign stock_status = 'product--instock color-success'
              if settings.product_information_low_stock_threshold > 0 and settings.product_information_low_stock_threshold >= product.selected_or_first_available_variant.inventory_quantity
                assign stock_status = 'product--lowstock color-warning'
              endif
            -%}
            <span class="product-inventory-tracking icon-dot-shadow {{ stock_status }} p-relative">
              {%- if settings.product_information_low_stock_threshold > 0 and settings.product_comparison_show_stock_number -%}
                {{ 'products.product.in_stock_html' | t: stock:  product.selected_or_first_available_variant.inventory_quantity }}
              {%- else -%}
                {{ 'products.product.in_stock' | t }}
              {%- endif -%}
            </span>
          {%- else -%}
            {%- if product.selected_or_first_available_variant.inventory_policy != 'continue' and product.selected_or_first_available_variant.inventory_management != blank -%}
              <span class="product-inventory-tracking icon-dot-shadow product--outstock p-relative color-error">{{ 'products.product.out_of_stock' | t }}</span>
            {% else %}
              <span class="product-inventory-tracking icon-dot-shadow product--instock color-success p-relative">
              {{ 'products.product.in_stock' | t }}
              </span>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
      <div class="product__form d-none">
        <sht-featured-prd-frm data-section="{{ section.id }}-{{ product.id }}">
          <div class="js-featured-product-form-error-wrapper mb-16" data-type="error-wrapper" role="alert" hidden>
            <span class="d-flex middle-xs">
              <span class="icon--error icon icon--small mr-8 fs-0">{%- render 'icon-error', size: 16 -%}</span>
              <span class="js-featured-product-form-error-message subtext" data-type="error-message"></span>
            </span>
          </div>
          {%- if product != blank -%}
            {%- form 'product', product, id: product_form_id, class: 'form form__fields', novalidate: 'novalidate' -%}
              <div class="form__field">
                <input type="hidden" class="form__control" name="id" value="{{ product.selected_or_first_available_variant.id }}" disabled>
              </div>
              <div class="product-form__buttons d-flex top-xs fd-column">
                <div class="gap-16 d-flex w-100">
                  <button type="submit" name="add" class="js-featured-product-form-submit-btn product-btn-atc btn btn-secondary btn-large w-100"
                    {% if product.selected_or_first_available_variant.available == false %}
                      disabled
                      {% assign add_to_cart_btn_lbl =  'products.product.sold_out' | t %}
                    {% else %}
                      {% assign add_to_cart_btn_lbl =  'products.product.add_to_cart' | t %}
                    {% endif %}>
                    <span class="p-relative d-flex middle-xs center-xs ta-center">
                      <span class="hidden js-featured-product-form-spinner">
                        {% render 'icon-spinner' %}
                      </span>
                      <span class="js-featured-product-form-submit-btn-text">
                        {{ add_to_cart_btn_lbl }}
                      </span>
                    </span>
                  </button>
                </div>
              </div>
            {%- endform -%}
          {%- else -%}
            <button type="submit" name="add" class=" product-btn-atc btn btn-secondary btn-large mb-16 w-100" disabled>
              {{ 'products.product.sold_out' | t }}
            </button>
          {%- endif -%}
        </sht-featured-prd-frm>
      </div>
    {%- endif -%}
  </div>

  <div class="js-product-comparison-des mt-listing {{ settings.product_comparison_show_description | default: 'd-none' | replace: 'true', '' }}">
    <div class="pb-12 pb-md-20 wb-break-word">
      <span class="h5">{{ 'sections.product_comparison.descriptions' | t }}</span>
    </div>

    <div class="product-card-desc">
      {{- product.description -}}
    </div>
  </div>

  <a href="{{- product.url | within: collection | default: '#' -}}" class="btn btn-link btn-small btn-view-details ta-left mt-listing {{ settings.product_comparison_enable_view_full_details | default: 'd-none-important' | replace: 'true', '' }}" aria-label="{{ "products.product.view_full_details" | t }}">
    {{ 'products.product.view_full_details' | t }}
    {% render 'icon-arrow-right', size: 16, class: 'ml-8' %}
  </a>

  {%- assign files = 'componet-show-product-compare.js' | split: ', ' -%}
  <script>
    {%- for file in files -%}
      {%- assign id = file | replace: ".js", "-js" | strip | append: "-file" -%}
      {%- assign fileName = id | replace: "-", "_" -%}
      if (!SHTHelper.qs(`#{{ id }}`)) {
          let {{ fileName }} = document.createElement("script");
          {{ fileName }}.setAttribute('src', `{{ file | asset_url }}`);
          {{ fileName }}.setAttribute('id', '{{ id }}');
          document.body.appendChild({{ fileName }});
      }
    {%- endfor -%}
  </script>

</div>

{% schema %}
{
  "name": "Show product compare",
  "tag": "section",
  "class": "section-view-product-compare",
  "settings": [
    {
      "type": "text",
      "id": "product_comparison_metafield_keys",
      "label": "t:sections.main_collection_products.settings.add_info.label",
      "info": "t:sections.main_collection_products.settings.add_info.info"
    }
  ]
}
{% endschema %}
