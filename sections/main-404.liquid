<link rel="stylesheet" href="{{ '404.css' | asset_url }}" media="all">
{% liquid
  assign desktop_image_alt  = section.settings.desktop_image.alt | default: section.settings.desktop_image.image | split: '/' | last
  assign desktop_image = section.settings.desktop_image | image_url: width: section.settings.desktop_image.width | image_tag: widths: '375, 550, 750, 950, 1024, 1200, 1400, 1600, 1800, 2000', sizes: "(min-width: 769px) 900px, calc(100vw - 48px)", alt: desktop_image_alt, class: 'd-none d-block-md w-100 h-100 media media-md of-cover'

  assign mobile_image_alt  = section.settings.mobile_image.alt | default: section.settings.mobile_image.image | split: '/' | last
  assign mobile_image = section.settings.mobile_image | image_url: width: section.settings.mobile_image.width | image_tag: widths: '375, 550, 750, 950', sizes: "calc(100vw - 48px)", alt: mobile_image_alt, class: 'd-none-md d-block w-100 h-100 media of-cover'

  assign section_style = 's-media-with-text--solid'
  assign page_background_color = settings.page_background | downcase
  assign section_background_color = section.settings.color_scheme.settings.color_background | downcase
  assign container_rounded = 'corner-radius-m corner-radius-zero-mb'
  if page_background_color == section_background_color or section.settings.color_scheme.settings.color_background.alpha == 0.0
      assign section_style = 's-media-with-text--transparent'
      assign media_rounded = 'corner-radius-m corner-radius-zero-mb'
      assign container_rounded = 'corner-radius-zero-mb'
  endif

  assign form_width = '--mw-sm: 100%;'
-%}

<div class="section section-index--{{section.index |  replace: '1', 'first' }} s-media-with-text color-{{- section.settings.color_scheme }}">
<div class="ctnr section-404 {{ container_rounded }}  d-grid {{ section_style }}" data-ui-component="Main 404" style="--mh-md:{{ section.settings.image_height |  prepend: 'calc(' | append: ' - (var(--s-outer-p-y) * 2))' }}; {% if section.settings.desktop_image != blank %} --gtc-equal-md:2; {% endif %}">
    {% assign section_content_layout = 'top-md ta-start-md' %}
    {% assign form_width = '--mw-sm: 100%;' %}
    <div class="section-404__media {{ media_rounded }}  p-relative m-zero-md js-animate anm hide-empty" style="--ratio: {{ section.settings.mobile_ratio }};--ratio-md:auto;">
      {%- liquid
        if section.settings.mobile_image
          echo mobile_image | replace: "src=", 'data="mobile" loading="lazy" decoding="async" fetchpriority="low" src='
          echo desktop_image | replace: "src=", 'loading="lazy" decoding="async" fetchpriority="low" src='
        else
          echo desktop_image | replace: 'd-none d-block-md', '' | replace: "src=", 'loading="lazy" decoding="async" fetchpriority="low" src='
        endif
      -%}
    </div>
    <div class="s-header__content s-media-with-text__content s-card h-100 d-flex fd-column middle-xs center-xs ta-center background {{ section_content_layout }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'subheading' -%}
            {%- if block.settings.subheading != blank -%}
              <span class="s-header__subheading s-header__sub d-inline-block fw-700 hide-empty">{{- block.settings.subheading -}}</span>
            {%- endif -%}
          {%- when 'heading' -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="s-header__heading {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                {{- block.settings.heading -}}
              </h2>
            {%- endif -%}
          {%- when 'description' -%}
            {%- if block.settings.description != blank -%}
              <div class="s-header__description" {{ block.shopify_attributes }}>
                {{- block.settings.description -}}
              </div>
            {%- endif -%}
          {%- when 'functions' -%}
            <div class="s-header__buttons d-flex fd-column middle-xs w-100 {{ section_content_layout }}" {{ block.shopify_attributes }}>
              {%- if block.settings.enable_search -%}
                <div class= "pb-24 p-relative w-100" style="{{ form_width }}">
                  <form action="{{ routes.search_url }}">
                    <input
                      id="section404Input"
                      type="text"
                      placeholder="{{ 'general.search.search_the_site' | t }}"
                      name="q"
                      value="{{ search.terms | escape }}"
                      class="field__text field--focus field--hover w-100"
                    >
                    <label class="field__label visually-hidden" for="section404Input">{{ 'general.search.search' | t }}</label>
                    <button type="submit" aria-label="{{ "accessibility.search" | t }}" class="btn btn-icon btn-plain btn-large p-absolute zi-1 right-0 top-0">
                      {%- render 'icon-search', size: 20, class: 'color-text' -%}
                    </button>
                  </form>
                </div>
              {%- endif -%}
              <div class="d-flex fd-column fd-row-md gap-12 w-100 {{ section_content_layout }} " style="{{ form_width }}">
                {%- if block.settings.button_1_label != blank -%}
                  <a class="btn btn-large {{ block.settings.button_1_style }} c-gap-10 w-100" href="{{- routes.root_url -}}">
                    {% render 'icon-home', size: 16 %}
                    <span class="flex-1 maw-fit-content">{{- block.settings.button_1_label -}}</span>
                  </a>
                {%- endif -%}
                {%- if block.settings.button_2_label != blank -%}
                  <a class="btn btn-large {{ block.settings.button_2_style }} c-gap-10 w-100" href="{{- routes.all_products_collection_url -}}">
                    {% render 'icon-shop', size: 16 %}
                    <span class="flex-1 maw-fit-content">
                    {{- block.settings.button_2_label -}}</span></a>
                {%- endif -%}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

</div>
</div>
{% schema %}
{
  "name": "t:sections.main_404.name",
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.headers.header_general.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.header_image.content"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "t:general.settings.image.label"
    },
    {
      "type": "select",
      "label": "t:general.settings.image_height_on_large_screen.label",
      "info": "t:general.settings.image_height_expand.info",
      "id": "image_height",
      "options": [
        {
          "value": "70vh",
          "label": "t:general.settings.height.options.option_70.label"
        },
        {
          "value": "100vh",
          "label": "t:general.settings.height.options.fill_screen_height.label"
        }
      ],
      "default": "70vh"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:general.settings.mobile_image_2.label"
    },
    {
      "type": "select",
      "label": "t:general.settings.image_ratio_on_mobile.label",
      "id": "mobile_ratio",
      "options": [
        {
          "value": "1/1",
          "label": "t:general.settings.image_ratio.options.option_square.label"
        },
        {
          "value": "2/3",
          "label": "t:general.settings.image_ratio.options.option_portrait.label"
        },
        {
          "value": "3/2",
          "label": "t:general.settings.image_ratio.options.option_landscape.label"
        }
      ],
      "default": "1/1"
    }
  ],
  "blocks": [
    {
      "type": "subheading",
      "name": "t:general.settings.subheading.label",
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "label": "t:general.settings.text.label",
          "default": "404-Page not found"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:general.settings.heading.label",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:general.settings.text.label",
          "default": "We're sorry, this page is not available"
        },
        {
          "type": "select",
          "label": "t:general.settings.text_size.label",
          "id": "heading_size",
          "options": [
            {
              "value": "headline",
              "label": "t:general.settings.heading_size.options.headline.label"
            },
            {
              "value": "h1",
              "label": "t:general.settings.heading_size.options.h1.label"
            },
            {
              "value": "h2",
              "label": "t:general.settings.heading_size.options.h2.label"
            },
            {
              "value": "h3",
              "label": "t:general.settings.heading_size.options.h3.label"
            }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "description",
      "name": "t:general.settings.description.label",
      "settings": [
        {
          "type": "richtext",
          "id": "description",
          "label": "t:general.settings.text.label",
          "default": "<p>The page URL might be outdated or contain typo errors</p>"
        }
      ]
    },
    {
      "type": "functions",
      "name": "t:sections.main_404.settings.headers.header_functions.content",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "t:sections.main_404.settings.headers.header_functions.content"
        },
        {
          "type": "checkbox",
          "id": "enable_search",
          "label": "t:sections.main_404.settings.enable_search.label",
          "default": true
        },
        {
          "type": "header",
          "content": "t:sections.main_404.settings.home_page_link_text.label"
        },

        {
          "type": "text",
          "id": "button_1_label",
          "label": "t:general.settings.button.text.label",
          "info": "t:sections.main_404.settings.general.link_text.info",
          "default": "Visit our homepage"
        },
        {
          "type": "select",
          "id": "button_1_style",
          "default": "btn-secondary",
          "options": [
            {
              "value": "btn-primary",
              "label": "t:general.settings.primary.label"
            },
            {
              "value": "btn-secondary",
              "label": "t:general.settings.secondary.label"
            },
            {
              "value": "btn-link",
              "label": "t:general.settings.tertiary.label"
            }
          ],
          "label": "t:general.settings.button.style.label"
        },
        {
          "type": "header",
          "content": "t:sections.main_404.settings.catalogue_link_text.label"
        },
        {
          "type": "text",
          "id": "button_2_label",
          "label": "t:general.settings.button.text.label",
          "info": "t:sections.main_404.settings.general.link_text.info",
          "default": "Browse all products"
        },
        {
          "type": "select",
          "id": "button_2_style",
          "default": "btn-secondary",
          "options": [
            {
              "value": "btn-primary",
              "label": "t:general.settings.primary.label"
            },
            {
              "value": "btn-secondary",
              "label": "t:general.settings.secondary.label"
            },
            {
              "value": "btn-link",
              "label": "t:general.settings.tertiary.label"
            }
          ],
          "label": "t:general.settings.button.style.label"
        }
      ]
    }
  ]
}
{% endschema %}
