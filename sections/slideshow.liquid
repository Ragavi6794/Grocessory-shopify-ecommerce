{%- liquid
  assign place_holder = 'lifestyle-2' | placeholder_svg_tag: 'placeholder js-image-lazy js-slideshow-image-desktop d-none d-block-md w-100 h-100 p-absolute center-middle'
  assign place_holder_mobile = 'lifestyle-2' | placeholder_svg_tag: 'placeholder js-image-lazy-mobile js-slideshow-image-mobile d-none-md d-block w-100 h-100 p-absolute center-middle'
  assign class_desktop = 'js-image-lazy js-slideshow-image-desktop d-none d-block-md w-100 h-100 of-cover zi-m-1 p-absolute center-middle background'
  assign class_mobile = 'js-image-lazy-mobile js-slideshow-image-mobile d-none-md d-block w-100 h-100 of-cover zi-m-1 p-absolute center-middle'

  assign show_pagination = section.settings.enable_pagination | default: 'd-none-important' | replace: 'true', ''
  assign show_navigation = section.settings.enable_navigation | default: 'd-none-important' | replace: 'true', ''
  assign show_autoplay = section.settings.enable_autoplay | default: 'd-none-important' | replace: 'true', ''
  assign icon_pause_class = section.settings.enable_autoplay | default: 'js-slideshow-pause-icon d-none' | replace: 'true', 'js-slideshow-pause-icon'
  assign slideshow_pagination = ''
-%}
<div class="section s--banner-spacing section-index--{{section.index |  replace: '1', 'first' }} color-{{- section.settings.color_scheme }}">
  <div class="ctnr" data-ui-component="Slideshow Section">
    <div class="p-relative corner-radius-m bs-card">
      <sht-slideshow class="d-block" data-slideshow-properties='{"sectionId": "{{ section.id }}", "autoplayAccessibilityText": ["{{ 'accessibility.start_slideshow' | t }}","{{ 'accessibility.stop_slideshow' | t }}"], "autoplayText": ["▶","||"], "separatorText": "{{ 'accessibility.of' | t }}", "autoplay": {{ section.settings.enable_autoplay }}, "duration": {{ section.settings.delay | times: 1000 }}}'>
        <div role="region" aria-roledescription="Carousel" aria-label="{{ section.settings.accessibility_content }}" class="slideshow__wrapper js-slideshow p-relative">
          <div aria-live="polite" aria-atomic="true" id="slideShow-{{ section.id }}" class="slider-track js-slideshow-items scrollable scrollable-x scrl-bhvr-auto disable-scrollbars w-100 ox-auto fd-row ls-none p-zero m-zero d-flex {% if section.settings.height_desktop == "adapt_img" %} middle-md {% endif %} {% if section.settings.height_mobile == "adapt_img" %} style-slider-mb {% endif %}">
            {%- for block in section.blocks -%}
              {%- liquid
                assign current_item = ''
                assign lazy_load = ''
                assign current_pagination_item = ''
                assign loaded_item = 'loaded="true"'
                assign slide_desktop_image = place_holder
                assign slide_desktop_image_alt = block.settings.desktop_image.alt | default: block.settings.desktop_image.image | split: '/' | last
                assign slide_mobile_image = place_holder_mobile
                assign slide_mobile_image_alt = block.settings.mobile_image.alt | default: block.settings.mobile_image.image | split: '/' | last

                if forloop.first
                assign current_item = ' js-slideshow-image--current'
                assign current_pagination_item = ' is-active'
                assign lazy_load = 'js-animate anm anm-zoomOut'
                endif
                assign slide_desktop_image = block.settings.desktop_image | image_url: width: block.settings.desktop_image.width | image_tag: widths: '1300', sizes: '(min-width: 1440px) calc(100vw/2), calc(100vw)', alt: slide_desktop_image_alt, class: class_desktop
                assign slide_mobile_image = block.settings.mobile_image | image_url: width: block.settings.mobile_image.width | image_tag: widths: '375, 550, 750, 950', sizes: '100vw', alt: slide_mobile_image_alt, class: class_mobile

                if block.settings.mobile_image == blank
                  assign slide_desktop_image = slide_desktop_image | replace: 'd-none d-block-md', ''
                endif

                assign min_height_mobile = section.settings.height_mobile
                assign min_height_desktop = section.settings.height_desktop

                if min_height_desktop == "adapt_img"
                  assign image_banner_height_adapt_desktop = 'image-banner--height-adapt-desktop'
                  assign min_height_desktop = ""
                  if block.settings.desktop_image == blank
                    assign min_height_desktop = "500px"
                  endif
                  assign height_desktop = block.settings.desktop_image.aspect_ratio
                endif

                if min_height_mobile == "adapt_img"
                  assign image_banner_height_adapt_mobile = 'image-banner--height-adapt-mobile'
                  assign min_height_mobile = ""
                  assign height_mobile = block.settings.mobile_image.aspect_ratio
                  if block.settings.mobile_image == blank
                    assign height_mobile = block.settings.desktop_image.aspect_ratio
                  endif
                  if block.settings.mobile_image == blank and block.settings.desktop_image == blank
                    assign min_height_mobile = "500px"
                  endif
                endif

                assign overlay_style_md = 'sht-mask-md'
                if block.settings.content_position_desktop contains 'top'
                  assign overlay_style_md = 'sht-mask--top-md'
                elsif block.settings.content_position_desktop contains 'bottom'
                  assign overlay_style_md = 'sht-mask--bottom-md'
                endif

                if block.settings.content_position_mobile contains 'top'
                  assign overlay_style = 'sht-mask--top'
                elsif block.settings.content_position_mobile contains 'bottom'
                  assign overlay_style = 'sht-mask--bottom'
                endif

                assign content_align_class_desktop = 'start-md ta-left-md'
                if block.settings.content_position_desktop contains 'ta-center'
                  assign content_align_class_desktop = 'center-md ta-center-md'
                endif

                assign content_align_class_mobile = 'start-xs ta-left'
                if block.settings.content_position_mobile contains 'ta-center'
                  assign content_align_class_mobile = 'center-xs ta-center'
                endif

                assign content_position = 'content_position-xs'
                if block.settings.content_position_mobile contains 'middle'
                  assign content_position = ''
                endif
                assign content_position_md = 'content_position-md'
                if block.settings.content_position_desktop contains 'middle'
                  assign content_position_md = ''
                endif

                assign overlay = block.settings.image_overlay_opacity
                assign overlay_color = ''
                assign content_color = ''
                unless block.settings.color_mask_overlay.alpha == 0.0 or block.settings.color_mask_overlay == blank
                  assign overlay_color = '--color-mask-overlay:' | append: block.settings.color_mask_overlay.red | append: ',' | append: block.settings.color_mask_overlay.green | append: ',' | append: block.settings.color_mask_overlay.blue | append: ';'
                endunless
                unless block.settings.color_text_overlay.alpha == 0.0 or block.settings.color_text_overlay == blank
                  assign content_color = 'color:' | append: block.settings.color_text_overlay | append: ';'
                endunless
              -%}
              <div role="group" aria-roledescription="Slide" aria-label="{{ 'accessibility.slide' | t }} {{ forloop.index }} {{ 'accessibility.of' | t }} {{ forloop.length }}" class="slider-slide slider-slide-{{ forloop.index }} js-slideshow-item scrollable-aln-start miw d-flex p-relative o-hidden image-banner-height {{ image_banner_height_adapt_desktop }} {{ image_banner_height_adapt_mobile }}" style="--miw:100%; --mh-xs: {{- min_height_mobile -}};--mh-md: {{- min_height_desktop -}};--image-ratio: {{- height_mobile -}};--image-ratio-md: {{- height_desktop -}};" aria-hidden="true" {{ block.shopify_attributes }}>
                {% if block.settings.slide_link != blank %}<a href="{{ block.settings.slide_link }}" class="slideshowDefault_link"></a>{% endif %}
                <div class="js-slideshow-image sht-mask w-100 h-100 p-absolute center-middle zi-1 {{ current_item }} {{ overlay_style }} {{ overlay_style_md }}" data-slideshow-index="{{ forloop.index }}" style="--overlay: {{ overlay }}; {{ overlay_color }}">
                  <sht-slideshow-load-img data-section-id="{{ section.id }}" class="d-block w-100 h-100 no-animation" {{- loaded_item -}}>
                    <div class="d-block w-100 h-100 {{ lazy_load }} media-wrapper">
                      {%- liquid
                        echo slide_desktop_image | replace: 'src=', 'loading="lazy" decoding="async" fetchpriority="low" src='
                        if block.settings.mobile_image
                          echo slide_mobile_image | replace: 'src=', 'data="mobile" loading="lazy" decoding="async" fetchpriority="low" src='
                        endif
                      -%}
                    </div>
                  </sht-slideshow-load-img>
                </div>
                <div class="slider__content s-card w-100 h-100 d-flex p-relative zi-2 {{ content_position }} {{ content_position_md }} {{ block.settings.content_position_mobile }} {{ block.settings.content_position_desktop }}" style="{{- content_color -}};">
                  <div class="s-header__content d-flex fd-column {{ content_align_class_desktop }} {{ content_align_class_mobile }}">
                    <div class="slider__content-item s-header__subheading s-header__sub hide-empty d-inline-block fw-700">{{- block.settings.sub_heading | escape -}}</div>
                    <h2 class="slider__content-item s-header__heading s-header__title mb-0 hide-empty {{ section.settings.heading_size }}">{{- block.settings.heading | escape -}}</h2>
                    <div class="slider__content-item s-header__description s-header__desc hide-empty text-block">{{- block.settings.description -}}</div>
                    <sht-slideshow-cta class="slider__content-item s-header__buttons slideshow__buttons d-inline-flex fw-wrap  gap-12 {{ content_align_class_desktop }} {{ content_align_class_mobile }}">
                      {%- if block.settings.button_1_label != blank -%}
                        <a class="btn btn-large {{ block.settings.button_1_style }}" href="{{- block.settings.button_1_link | default: '#' -}}">{{- block.settings.button_1_label -}}</a>
                      {%- endif -%}
                      {%- if block.settings.button_2_label != blank -%}
                        <a class="btn btn-large {{ block.settings.button_2_style }}" href="{{- block.settings.button_2_link | default: '#' -}}">{{- block.settings.button_2_label -}}</a>
                      {%- endif -%}
                    </sht-slideshow-cta>
                  </div>
                </div>
              </div>
              {% capture slideshow_pagination %}
                {{ slideshow_pagination }}
                <li class="slideshow__pagination__item dots-pagination js-slideshow-pagination-item{{ current_pagination_item }}" data-slideshow-index="{{ forloop.index }}"><div class="slideshow__pagination__item--background js-slideshow-pagination-item-background"></div></li>
              {% endcapture %}
            {%- endfor -%}
          </div>
          <div class="slideshow__controls bottom-12 p-absolute zi-2 w-100 no-js-hidden gap-12 d-flex bg-transparent center-xs middle-xs {{ section.settings.color_scheme }}">
            <button aria-label="{{ 'accessibility.previous_slide' | t }}" aria-controls="slideShow-{{ section.id }}" class="btn btn-large btn-icon btn-plain js-slideshow-prev-btn {{ show_navigation }}" type="button">
              {% render 'icon-arrow-left' %}
            </button>
            <div class="d-flex">
<button aria-label="{{ 'accessibility.start_slideshow' | t }}" 
        aria-controls="slideShow-{{ section.id }}" 
        class="btn btn-large btn-icon btn-plain btn-play-stop js-slideshow-start-n-stop-btn p-relative autoplay-button {{ show_autoplay }}" 
        type="button">
  {% liquid
    render 'icon-pause', class: icon_pause_class
    render 'icon-play', class: 'js-slideshow-play-icon d-none'
  %}
</button>

              <ul class="slideshow__pagination js-slideshow-pagination d-flex middle-xs ls-none gap-6 {{ show_pagination }}">
                {{ slideshow_pagination }}
              </ul>
              <div class="slideshow__counter d-none-important d-flex center-xs middle-xs gap-6">
                <span class="js-slideshow-current">1</span>
                <span class="slideshow__counter--separator" aria-hidden="true">/</span>
                <span class="slideshow__counter--separator js-slideshow-separator visually-hidden">{{ 'accessibility.of' | t }}</span>
                <span class="js-slideshow-total">{{ section.blocks.size }}</span>
              </div>
            </div>
            <button aria-label="{{ 'accessibility.next_slide' | t }}" aria-controls="slideShow-{{ section.id }}" class="btn btn-icon btn-large btn-plain js-slideshow-next-btn {{ show_navigation }}" type="button">
              {% render 'icon-arrow-right' %}
            </button>
          </div>
        </div>
      </sht-slideshow>
    </div>

  </div>
  {%- render 'section-id', section: section -%}
</div>
{% schema %}
{
  "name": "t:sections.slideshow.name",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.headers.header_general.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.settings.color_scheme.label",
      "default": "scheme-2"
    },
    {
      "type": "select",
      "label": "t:general.settings.heading_size.label",
      "id": "heading_size",
      "options": [
        {
          "value": "headline",
          "label": "t:general.settings.heading_size.options.headline.label"
        },
        {
          "value": "h1",
          "label": "t:general.settings.heading_size.options.h1.label"
        },
        {
          "value": "h2",
          "label": "t:general.settings.heading_size.options.h2.label"
        },
        {
          "value": "h3",
          "label": "t:general.settings.heading_size.options.h3.label"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.header_layout.content"
    },
    {
      "type": "paragraph",
      "content": "t:general.settings.paragraph.section_expand.content"
    },
    {
      "type": "select",
      "label": "t:general.settings.section_height_on_large_screen.label",
      "id": "height_desktop",
      "options": [
        {
          "value": "50vh",
          "label": "t:general.settings.height.options.option_50.label"
        },
        {
          "value": "70vh",
          "label": "t:general.settings.height.options.option_70.label"
        },
        {
          "value": "100vh",
          "label": "t:general.settings.height.options.fill_screen_height.label"
        },
        {
          "value": "adapt_img",
          "label": "t:general.settings.image_ratio.options.option_adapt.label"
        }
      ],
      "default": "70vh"
    },
    {
      "type": "select",
      "label": "t:general.settings.section_height_on_mobile.label",
      "id": "height_mobile",
      "options": [
        {
          "value": "50vh",
          "label": "t:general.settings.height.options.option_50.label"
        },
        {
          "value": "70vh",
          "label": "t:general.settings.height.options.option_70.label"
        },
        {
          "value": "100vh",
          "label": "t:general.settings.height.options.fill_screen_height.label"
        },
        {
          "value": "adapt_img",
          "label": "t:general.settings.image_ratio.options.option_adapt.label"
        }
      ],
      "default": "70vh"
    },
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.controller.label"
    },
    {
      "type": "checkbox",
      "id": "enable_pagination",
      "label": "t:general.settings.enable_pagination.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_navigation",
      "label": "t:general.settings.show_navigation.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "t:sections.slideshow.settings.enable_autoplay.label",
      "default": true
    },
    {
      "type": "range",
      "id": "delay",
      "label": "t:sections.slideshow.settings.autoplay_delay.label",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 2,  // Updated to 2 seconds
      "unit": "s"
    },
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.accessibility.label"
    },
    {
      "type": "text",
      "id": "accessibility_content",
      "label": "t:sections.slideshow.settings.accessibility.description.label",
      "info": "t:sections.slideshow.settings.accessibility.description.info",
      "default": "Slideshow about our brand"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.slideshow.blocks.slide.name",
      "limit": 6,
      "settings": [
        {
          "type": "header",
          "content": "t:general.settings.headers.header_general.content"
        },
        {
          "type": "select",
          "label": "t:general.settings.content_position_on_large_screen.label",
          "id": "content_position_desktop",
          "options": [
            {
              "value": "start-md top-md ta-left",
              "label": "t:general.settings.content_position.options.option_top_left.label"
            },
            {
              "value": "center-md top-md ta-center",
              "label": "t:general.settings.content_position.options.option_top_center.label"
            },
            {
              "value": "start-md middle-md ta-left",
              "label": "t:general.settings.content_position.options.option_middle_left.label"
            },
            {
              "value": "center-md middle-md ta-center",
              "label": "t:general.settings.content_position.options.option_middle_center.label"
            },
            {
              "value": "start-md bottom-md ta-left",
              "label": "t:general.settings.content_position.options.option_bottom_left.label"
            },
            {
              "value": "center-md bottom-md ta-center",
              "label": "t:general.settings.content_position.options.option_bottom_center.label"
            }
          ],
          "default": "center-md middle-md ta-center"
        },
        {
          "type": "select",
          "label": "t:general.settings.content_position_on_mobile.label",
          "id": "content_position_mobile",
          "options": [
            {
              "value": "start-xs top-xs ta-left",
              "label": "t:general.settings.content_position.options.option_top_left.label"
            },
            {
              "value": "center-xs top-xs ta-center",
              "label": "t:general.settings.content_position.options.option_top_center.label"
            },
            {
              "value": "start-xs middle-xs ta-left",
              "label": "t:general.settings.content_position.options.option_middle_left.label"
            },
            {
              "value": "center-xs middle-xs ta-center",
              "label": "t:general.settings.content_position.options.option_middle_center.label"
            },
            {
              "value": "start-xs bottom-xs ta-left",
              "label": "t:general.settings.content_position.options.option_bottom_left.label"
            },
            {
              "value": "center-xs bottom-xs ta-center",
              "label": "t:general.settings.content_position.options.option_bottom_center.label"
            }
          ],
          "default": "center-xs middle-xs ta-center"
        },
        {
          "type": "range",
          "unit": "%",
          "max": 90,
          "min": 0,
          "step": 1,
          "default": 30,
          "id": "image_overlay_opacity",
          "label": "t:general.settings.overlay_opacity.label"
        },
        {
          "type": "color",
          "id": "color_mask_overlay",
          "label": "t:general.settings.custom_mask_overlay.label"
        },
        {
          "type": "color",
          "id": "color_text_overlay",
          "label": "t:general.settings.custom_text_overlay.label"
        },
        {
          "type": "header",
          "content": "t:general.settings.headers.header_text.content"
        },
        {
          "type": "text",
          "label": "t:general.settings.subheading.label",
          "id": "sub_heading",
          "default": "Add a tagline"
        },
        {
          "type": "text",
          "label": "t:general.settings.heading.label",
          "id": "heading",
          "default": "Slide heading"
        },
        {
          "type": "richtext",
          "label": "t:general.settings.description.label",
          "id": "description",
          "default": "<p>Highlight your new collection or share content related to this image</p>"
        },
        {
          "type": "header",
          "content": "t:general.settings.headers.header_image.content"
        },
        {
          "type": "paragraph",
          "content": "t:general.settings.paragraph_recommend_slides.content"
        },
        {
          "type": "image_picker",
          "label": "t:general.settings.background_image.label",
          "id": "desktop_image",
          "info": "t:general.settings.image_recommend.info"
        },
        {
          "type": "image_picker",
          "label": "t:general.settings.mobile_background_image_optional.label",
          "id": "mobile_image",
          "info": "t:general.settings.image_recommend_mobile.info"
        },
        {
          "type": "url",
          "id": "slide_link",
          "label": "Image Link"
        },
        {
          "type": "header",
          "content": "t:general.settings.headers.header_buttons.content"
        },
        {
          "type": "text",
          "id": "button_1_label",
          "label": "t:general.settings.button_1_label.label",
          "info": "t:general.settings.button_label.info",
          "default": "Button label"
        },
        {
          "type": "select",
          "id": "button_1_style",
          "default": "btn-primary",
          "options": [
            {
              "value": "btn-primary",
              "label": "t:general.settings.primary.label"
            },
            {
              "value": "btn-secondary",
              "label": "t:general.settings.secondary.label"
            },
            {
              "value": "btn-link",
              "label": "t:general.settings.tertiary.label"
            }
          ],
          "label": "t:general.settings.button_1_style.label"
        },
        {
          "type": "url",
          "id": "button_1_link",
          "label": "t:general.settings.button_1_link.label"
        },
        {
          "type": "text",
          "id": "button_2_label",
          "label": "t:general.settings.button_2_label.label",
          "info": "t:general.settings.button_label.info",
          "default": "View details"
        },
        {
          "type": "select",
          "id": "button_2_style",
          "default": "btn-secondary",
          "options": [
            {
              "value": "btn-primary",
              "label": "t:general.settings.primary.label"
            },
            {
              "value": "btn-secondary",
              "label": "t:general.settings.secondary.label"
            },
            {
              "value": "btn-link",
              "label": "t:general.settings.tertiary.label"
            }
          ],
          "label": "t:general.settings.button_2_style.label"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "t:general.settings.button_2_link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.slideshow.name",
      "blocks": [
        {
          "type": "slide",
          "settings": {
          }
        },
        {
          "type": "slide",
          "settings": {
          }
        },
        {
          "type": "slide",
          "settings": {
          }
        }
      ]
    }
  ]
}
{% endschema %}
<style>
  .autoplay-button{
    display:none !important;
  }
   .js-slideshow {
  direction: ltr !important;
} 
</style>
