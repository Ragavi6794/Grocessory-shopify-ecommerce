{%- liquid
  assign section_id = section.id | md5 | truncate: 12, ""
  assign frm_id = section_id | prepend: 'newsletterForm-'

  assign desktop_image = 'lifestyle-1' | placeholder_svg_tag: 'placeholder d-none d-block-md w-100 h-100 of-cover'
  assign desktop_image_alt  = section.settings.desktop_image.alt | default: section.settings.desktop_image.image | split: '/' | last
  assign desktop_image = section.settings.desktop_image | image_url: width: section.settings.desktop_image.width | image_tag: widths: '375, 550, 750, 950, 1024, 1200, 1400, 1600, 1800, 2000', sizes: "(min-width: 1681px) calc(100vw/2), calc(100vw)", alt: desktop_image_alt, class: 'd-none d-block-md w-100 h-100 of-cover'

  assign min_height_mobile = section.settings.height_mobile
  assign min_height_desktop = section.settings.height_desktop

  if min_height_desktop == "adapt_img"
    assign desktop_ratio = section.settings.desktop_image.aspect_ratio
    if section.settings.desktop_image == blank
      assign min_height_desktop = "500px"
    endif
  endif

  if min_height_mobile == "adapt_img"
    assign mobile_ratio = section.settings.mobile_image.aspect_ratio
    if section.settings.mobile_image == blank
      assign mobile_ratio = '--image-ratio' | append: section.settings.desktop_image.aspect_ratio
    endif
    if section.settings.mobile_image == blank and section.settings.desktop_image == blank
      assign min_height_mobile = "500px"
    endif
  endif

  if section.settings.content_position_desktop contains 'mask--top'
    assign overlay_style_md = 'sht-mask--top-md'
  elsif section.settings.content_position_desktop contains 'mask--bottom'
    assign overlay_style_md = 'sht-mask--bottom-md'
  endif

  if section.settings.content_position_mobile contains 'mask--top'
    assign overlay_style = 'sht-mask--top'
  elsif section.settings.content_position_mobile contains 'mask--bottom'
    assign overlay_style = 'sht-mask--bottom'
  endif

  unless section.settings.color_mask_overlay.alpha == 0.0 or section.settings.color_mask_overlay == blank
    assign overlay_color = '--color-mask-overlay:' | append: section.settings.color_mask_overlay.red | append: ',' | append: section.settings.color_mask_overlay.green | append: ',' | append: section.settings.color_mask_overlay.blue | append: ';'
  endunless
  unless section.settings.color_text_overlay.alpha == 0.0 or section.settings.color_text_overlay == blank
    assign content_color = 'color:' | append: section.settings.color_text_overlay | append: ';'
  endunless
-%}
<div class="section s--banner-spacing color-{{ section.settings.color_scheme }}" data-ui-component="Newsletter Section" role="region" aria-labelledby="sectionHeading-{{ section_id }}">
  <div class="ctnr" style="--overlay: {{ section.settings.image_overlay_opacity }}; {{ overlay_color }}">
    <div class="bs-card sht-mask p-relative corner-radius-m {{ overlay_style }} {{ overlay_style_md }}">
      <div class="p-absolute w-100 h-100">
        <div class="d-block w-100 h-100 js-animate anm anm-zoomOut media-wrapper">
          {%- liquid
            if section.settings.mobile_image
              assign mobile_image_alt  = section.settings.mobile_image.alt | default: section.settings.mobile_image.image | split: '/' | last
              assign mobile_image = section.settings.mobile_image | image_url: width: section.settings.mobile_image.width | image_tag: widths: '375, 550, 750, 950', sizes: "calc(100vw)", alt: mobile_image_alt, class: 'd-none-md d-block w-100 h-100 of-cover'
              echo mobile_image | replace: "src=", 'data="mobile" loading="lazy" decoding="async" fetchpriority="low" src='
              echo desktop_image | replace: "src=", 'loading="lazy" decoding="async" fetchpriority="low" src='
            else
              echo desktop_image | replace: 'd-none d-block-md', '' | replace: "src=", 'loading="lazy" decoding="async" fetchpriority="low" src='
            endif
          -%}
        </div>
      </div>
      <div class="s-header__content s-card d-flex fd-column zi-1 w-100 h-100 p-relative image-banner-height
      {{ section.settings.content_position_mobile }}
      {{ section.settings.content_position_desktop }}"
      style="
        --mh-xs: {{ min_height_mobile }};
        --mh-md: {{ min_height_desktop }};
        --image-ratio: {{ mobile_ratio }};
        --image-ratio-md: {{ desktop_ratio }};
        {{ content_color }}">
          {%- for block in section.blocks -%}
          {%- case block.type -%}
          {%- when 'subheading' -%}
            {%- if block.settings.subheading != blank -%}
              <span class="s-header__subheading d-inline-block fw-700 hide-empty">{{- block.settings.subheading -}}</span>
            {%- endif -%}
          {%- when 'heading' -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="s-header__heading {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                {{- block.settings.heading -}}
              </h2>
            {%- endif -%}
          {%- when 'description' -%}
            {%- if block.settings.description != blank -%}
              <div class="s-header__description" {{ block.shopify_attributes }}>
                {{- block.settings.description -}}
              </div>
            {%- endif -%}
          {%- when 'newsletter' -%}
            {% assign button_text = block.settings.button_text | default: 'Subscribe' %}
            <div class="s-header__buttons w-100" {{ block.shopify_attributes }}>
              {% render 'newsletter-form', form_id: frm_id , form_name: 'newsletterForm', button_label: button_text, button_style: block.settings.button_style %}
            </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>

  </div>
  {%- render 'section-id', section: section -%}
</div>
{% schema %}
{
  "name": "t:sections.newsletter.name",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.headers.header_general.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.settings.color_scheme.label",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "unit": "%",
      "max": 90,
      "min": 0,
      "step": 1,
      "default": 30,
      "id": "image_overlay_opacity",
      "label": "t:general.settings.overlay_opacity.label"
    },
    {
      "type": "color",
      "id": "color_mask_overlay",
      "label": "t:general.settings.custom_mask_overlay.label"
    },
    {
      "type": "color",
      "id": "color_text_overlay",
      "label": "t:general.settings.custom_text_overlay.label"
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.header_layout.content"
    },
    {
      "type": "paragraph",
      "content": "t:general.settings.paragraph.section_expand.content"
    },
    {
      "type": "select",
      "label": "t:general.settings.section_height_on_large_screen.label",
      "id": "height_desktop",
      "options": [
        {
          "value": "auto",
          "label": "t:general.settings.height.options.adapt_to_content.label"
        },
        {
          "value": "50vh",
          "label": "t:general.settings.height.options.option_50.label"
        },
        {
          "value": "70vh",
          "label": "t:general.settings.height.options.option_70.label"
        },
        {
          "value": "adapt_img",
          "label": "t:general.settings.image_ratio.options.option_adapt.label"
        }
      ],
      "default": "70vh"
    },
    {
      "type": "select",
      "label": "t:general.settings.content_position_on_large_screen.label",
      "id": "content_position_desktop",
      "default": "middle-md center-md ta-center-md",
      "options": [
        {
          "value": "top-md start-md ta-start-md mask--top",
          "label": "t:general.settings.content_position.options.option_top_left.label"
        },
        {
          "value": "middle-md start-md ta-center-md mask--top",
          "label": "t:general.settings.content_position.options.option_top_center.label"
        },
        {
          "value": "top-md center-md ta-start-md",
          "label": "t:general.settings.content_position.options.option_middle_left.label"
        },
        {
          "value": "middle-md center-md ta-center-md",
          "label": "t:general.settings.content_position.options.option_middle_center.label"
        },
        {
          "value": "top-md end-md ta-start-md mask--bottom",
          "label": "t:general.settings.content_position.options.option_bottom_left.label"
        },
        {
          "value": "middle-md end-md ta-center-md mask--bottom",
          "label": "t:general.settings.content_position.options.option_bottom_center.label"
        }
      ]
    },
    {
      "type": "select",
      "label": "t:general.settings.section_height_on_mobile.label",
      "id": "height_mobile",
      "options": [
        {
          "value": "auto",
          "label": "t:general.settings.height.options.adapt_to_content.label"
        },
        {
          "value": "50vh",
          "label": "t:general.settings.height.options.option_50.label"
        },
        {
          "value": "70vh",
          "label": "t:general.settings.height.options.option_70.label"
        },
        {
          "value": "adapt_img",
          "label": "t:general.settings.image_ratio.options.option_adapt.label"
        }
      ],
      "default": "70vh"
    },
    {
      "type": "select",
      "label": "t:general.settings.content_position_on_mobile.label",
      "id": "content_position_mobile",
      "default": "middle-xs center-xs ta-center",
      "options": [
        {
          "value": "top-xs start-xs ta-start mask--top",
          "label": "t:general.settings.content_position.options.option_top_left.label"
        },
        {
          "value": "middle-xs start-xs ta-center mask--top",
          "label": "t:general.settings.content_position.options.option_top_center.label"
        },
        {
          "value": "top-xs center-xs ta-start",
          "label": "t:general.settings.content_position.options.option_middle_left.label"
        },
        {
          "value": "middle-xs center-xs ta-center",
          "label": "t:general.settings.content_position.options.option_middle_center.label"
        },
        {
          "value": "top-xs end-xs ta-start mask--bottom",
          "label": "t:general.settings.content_position.options.option_bottom_left.label"
        },
        {
          "value": "middle-xs end-xs ta-center mask--bottom",
          "label": "t:general.settings.content_position.options.option_bottom_center.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.header_image.content"
    },
    {
      "type": "image_picker",
      "label": "t:general.settings.background_image.label",
      "id": "desktop_image",
      "info": "t:sections.newsletter.settings.image_desktop.info"
    },
    {
      "type": "image_picker",
      "label": "t:general.settings.mobile_background_image_optional.label",
      "id": "mobile_image",
      "info": "t:sections.newsletter.settings.image_mobile.info"
    }
  ],
  "blocks": [
    {
      "type": "subheading",
      "name": "t:general.settings.subheading.label",

      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "label": "t:general.settings.text.label",
          "default": "Add a tagline"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:general.settings.heading.label",

      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:general.settings.text.label",
          "default": "Newsletter heading"
        },
        {
          "type": "select",
          "label": "t:general.settings.text_size.label",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "t:general.settings.heading_size.options.h2.label"
            },
            {
              "value": "h3",
              "label": "t:general.settings.heading_size.options.h3.label"
            },
            {
              "value": "h4",
              "label": "t:general.settings.heading_size.options.h4.label"
            },
            {
              "value": "h5",
              "label": "t:general.settings.heading_size.options.h5.label"
            }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "description",
      "name": "t:general.settings.description.label",

      "settings": [
        {
          "type": "richtext",
          "id": "description",
          "label": "t:general.settings.text.label",
          "default": "<p>Highlight your new collection or share content related to this image.</p>"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.popup.blocks.newsletter.name",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.popup.blocks.newsletter.settings.paragraph_one.content"
        },
        {
          "type": "text",
          "id": "button_text",
          "default": "Subscribe",
          "label": "t:general.settings.submit_button_text.label"
        },
        {
          "type": "select",
          "id": "button_style",
          "default": "btn-primary",
          "options": [
            {
              "value": "btn-primary",
              "label": "t:general.settings.primary.label"
            },
            {
              "value": "btn-secondary",
              "label": "t:general.settings.secondary.label"
            },
            {
              "value": "btn-link",
              "label": "t:general.settings.tertiary.label"
            }
          ],
          "label": "t:general.settings.submit_button_style.label"
        }
      ],
      "limit": 1
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.name",
      "blocks": [
        {
          "type": "subheading"
        },
        {
          "type": "heading"
        },
        {
          "type": "description"
        },
        {
          "type": "newsletter"
        }

      ]
    }
  ]
}
{% endschema %}