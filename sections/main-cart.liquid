{{ 'cart.css' | asset_url | stylesheet_tag: preload: true }}
<style>
  {% if localization.language.iso_code == "ar" %}

   .ld_input_icon_wrapper #local_delivery , .ld_input_icon_wrapper #datepicker:not(.ld_datepicker_always_visible) {
        width: 90%;
    }
  @media (max-width: 470px) {
      .address-box .default-badge {
        right: 79% !important;
      }
    }
    .default-badge {
      right: 85% !important;
    }
  {% endif %}

  /* Free Shipping Progress Bar Styles */
  .free-shipping-bar-wrapper {
    background: #FEF7F9B2;
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 20px;
    border: 1px solid #F0A8BB;
  }

  .free-shipping-message {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: 12px;
    font-size: 14px;
    font-weight: 500;
    color: #333;
    text-align: center;
  }
  span.free-shipping-icon-block {
      background: #db325e;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 100px;
      padding: 5px;
  }
  .free-shipping-icon {
    flex-shrink: 0;
  }

  .free-shipping-success {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    color: {{ settings.free_shipping_bar_color }};
    font-weight: 600;
    gap: 5px;
  }

  .free-shipping-progress-text {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 10px;
    font-weight: 400;
  }

  .free-shipping-highlight {
    color: #34BA12;
    font-weight: 500;
  }

  .free-shipping-progress-bar {
    width: 100%;
    height: 10px;
    background-color: {{ settings.free_shipping_bar_bg_color }};
    border-radius: 10px;
    overflow: hidden;
    position: relative;
  }

  .free-shipping-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, {{ settings.free_shipping_bar_color }}, {{ settings.free_shipping_bar_color | color_lighten: 15 }});
    border-radius: 10px;
    transition: width 0.4s ease-in-out;
    position: relative;
  }

  .free-shipping-progress-fill::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
    animation: shimmer 2s infinite;
  }

  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  /* Mobile Responsive Styles */
  @media (max-width: 768px) {
    .free-shipping-bar-wrapper {
      padding: 12px;
      margin-bottom: 16px;
      border-radius: 10px;
    }

    .free-shipping-message {
      font-size: 13px;
      margin-bottom: 10px;
      line-height: 1.4;
    }

    .free-shipping-icon {
      width: 18px;
      height: 18px;
    }

    .free-shipping-progress-bar {
      height: 8px;
    }
  }

  @media (max-width: 480px) {
    .free-shipping-bar-wrapper {
      padding: 10px;
      margin-bottom: 12px;
    }

    .free-shipping-message {
      font-size: 12px;
    }

    .free-shipping-icon {
      width: 16px;
      height: 16px;
      color: white;
    }
  }

  /* RTL Support for Arabic */
  [dir="rtl"] .free-shipping-icon,
  html[lang="ar"] .free-shipping-icon {
    margin-right: 0;
    margin-left: 8px;
  }

  [dir="rtl"] .free-shipping-progress-fill,
  html[lang="ar"] .free-shipping-progress-fill {
    right: 0;
    left: auto;
  }

  /* Desktop/Mobile visibility */
  .free-shipping-mobile {
    display: none;
    margin-top: 16px;
  }

  .free-shipping-desktop {
    display: block;
  }
  .free-shipping-icon {
    color: white;
  }

  @media (max-width: 989px) {
    .free-shipping-mobile {
      display: block;
    }

    .free-shipping-desktop {
      display: none;
    }
  }
  @media (min-width: 989px) {
    span.free-shipping-icon-block {
      height:29px
    }
  }
</style>
{%- liquid
  if cart == empty
    assign cart_empty_hide = 'd-none'
    assign cart_empty_show = 'd-block'
  endif
  capture icon_plus
    render 'icon-plus', size: 16
  endcapture

  capture icon_minus
    render 'icon-minus', size: 16
  endcapture

  capture icon_remove
    render 'icon-remove'
  endcapture


-%}

<div class="main-cart section section-index--{{section.index |  replace: '1', 'first' }} {% render 'sections-spacing' %} color-{{- section.settings.color_scheme }}" id="mainCart" data-ui-component="Main Cart Section" >
  <div class="ctnr js-animate anm anm-fadeInUpSmall background" id="mainCartContainer" style="--duration: .7s">
    <sht-cart-frm class="cart-content d-block">
      <div class="s-header cart-heading">
        <h1 class="{{ section.settings.heading_size }}  m-zero">
          {{ 'general.cart.cart_title' | t }} (<span class="js-cart-form-item_count">{{ cart.item_count }}</span>)
        </h1>

        <!-- Two-Tier Progress Bar - Mobile/Tablet Only: Checkout Minimum (30 AED) + Free Shipping -->
        {% if settings.enable_free_shipping_bar %}
          {%- assign checkout_minimum_mobile = 3000 -%}
          {%- assign free_shipping_threshold = settings.free_shipping_threshold | times: 100 -%}
          {%- assign cart_total_mobile = 0 -%}
          {%- for item in cart.items -%}
            {%- unless item.product.handle == 'shipping-charges' -%}
              {%- assign cart_total_mobile = cart_total_mobile | plus: item.final_line_price -%}
            {%- endunless -%}
          {%- endfor -%}
          {% if cart != empty %}
            <div class="free-shipping-bar-wrapper free-shipping-mobile{% if cart == empty %} d-none{% endif %}" data-threshold="{{ free_shipping_threshold }}" data-checkout-minimum="{{ checkout_minimum_mobile }}">
              <div class="free-shipping-message">
                {% if cart_total_mobile < checkout_minimum_mobile %}
                  {%- assign remaining_checkout_mobile = checkout_minimum_mobile | minus: cart_total_mobile -%}
                  {%- assign progress_percentage_mobile = cart_total_mobile | times: 100 | divided_by: checkout_minimum_mobile -%}
                  <span class="free-shipping-progress-text checkout-progress-text">
                    <span class="free-shipping-icon-block">    
                      <svg class="free-shipping-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                      </svg>
                    </span>
                    {%- assign remaining_checkout_aed_mobile = remaining_checkout_mobile | money_without_currency -%}
                    Add {{ remaining_checkout_aed_mobile }} AED more to <span class="free-shipping-highlight">enable checkout!</span>
                  </span>
                {% elsif cart_total_mobile >= free_shipping_threshold %}
                  {%- assign progress_percentage_mobile = 100 -%}
                  <span class="free-shipping-success">
                    <span class="free-shipping-icon-block">             
                      <svg class="free-shipping-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    </span>
                    {{ settings.free_shipping_message_success }}
                  </span>
                {% else %}
                  {%- assign remaining_amount_mobile = free_shipping_threshold | minus: cart_total_mobile -%}
                  {%- assign shipping_progress_range_mobile = free_shipping_threshold | minus: checkout_minimum_mobile -%}
                  {%- assign cart_above_minimum_mobile = cart_total_mobile | minus: checkout_minimum_mobile -%}
                  {%- assign progress_percentage_mobile = cart_above_minimum_mobile | times: 100 | divided_by: shipping_progress_range_mobile -%}
                  {%- if progress_percentage_mobile > 100 -%}
                    {%- assign progress_percentage_mobile = 100 -%}
                  {%- endif -%}
                  <span class="free-shipping-progress-text">
                    <span class="free-shipping-icon-block">    
                      <svg class="free-shipping-icon" width="21" height="17" viewBox="0 0 21 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M13.1104 0C14.5593 0 15.7325 1.17322 15.7325 2.62209V3.81394H16.3433C17.2483 3.81394 18.0882 4.27951 18.5687 5.04675L19.9561 7.26847C20.3118 7.83646 20.4999 8.49384 20.4999 9.16242V12.1569C20.4999 13.6058 19.3267 14.779 17.8778 14.779H17.5407C17.2297 15.8796 16.2167 16.686 15.0173 16.686C13.818 16.686 12.805 15.8796 12.4939 14.779H9.91281C9.60181 15.8796 8.58875 16.686 7.38941 16.686C6.19007 16.686 5.17704 15.8796 4.86601 14.779H3.57547C3.18067 14.779 2.86035 14.4587 2.86035 14.0639C2.86035 13.6691 3.18067 13.3488 3.57547 13.3488H4.86601C5.17701 12.2482 6.19007 11.4418 7.38941 11.4418C8.58875 11.4418 9.60178 12.2482 9.91281 13.3488H12.4939C12.7416 12.4754 13.4288 11.7882 14.3022 11.5405V2.62209C14.3022 1.9647 13.7677 1.43023 13.1104 1.43023H3.57551C3.18071 1.43023 2.8604 1.10991 2.8604 0.715114C2.8604 0.320314 3.18071 0 3.57551 0H13.1104ZM7.38947 12.8721C6.73209 12.8721 6.19761 13.4065 6.19761 14.0639C6.19761 14.7213 6.73209 15.2558 7.38947 15.2558C8.04685 15.2558 8.58133 14.7213 8.58133 14.0639C8.58133 13.4065 8.04685 12.8721 7.38947 12.8721ZM15.0174 12.8721C14.36 12.8721 13.8255 13.4065 13.8255 14.0639C13.8255 14.7213 14.36 15.2558 15.0174 15.2558C15.6747 15.2558 16.2092 14.7213 16.2092 14.0639C16.2092 13.4065 15.6747 12.8721 15.0174 12.8721ZM15.7325 11.5405C16.6059 11.7882 17.293 12.4754 17.5408 13.3488H17.8778C18.5352 13.3488 19.0697 12.8143 19.0697 12.1569V9.16242C19.0697 8.76204 18.9561 8.36722 18.7438 8.02644L17.3545 5.80472C17.1366 5.45648 16.7549 5.24417 16.3433 5.24417H15.7325L15.7325 11.5405Z" fill="white"/>
                      <path d="M4.52918 7.62793C4.92398 7.62793 5.2443 7.94824 5.2443 8.34304C5.2443 8.73784 4.92398 9.05816 4.52918 9.05816H1.66873C1.27393 9.05816 0.953613 8.73784 0.953613 8.34304C0.953613 7.94824 1.27393 7.62793 1.66873 7.62793H4.52918Z" fill="white"/>
                      <path d="M4.52906 3.81396C4.92386 3.81396 5.24417 4.13428 5.24417 4.52908C5.24417 4.92388 4.92386 5.24419 4.52906 5.24419H0.715114C0.320314 5.24419 0 4.92388 0 4.52908C0 4.13428 0.320314 3.81396 0.715114 3.81396H4.52906Z" fill="white"/>
                      </svg>
                    </span>
                    {%- assign remaining_aed_mobile = remaining_amount_mobile | money_without_currency -%}
                    Add {{ remaining_aed_mobile }} AED more for <span class="free-shipping-highlight">FREE shipping!</span>
                  </span>
                {% endif %}
              </div>
              <div class="free-shipping-progress-bar">
                <div class="free-shipping-progress-fill" style="width: {{ progress_percentage_mobile }}%;"></div>
              </div>
            </div>
          {% endif %}
        {% endif %}
      </div>

      {%- comment -%} Check for subscription products {%- endcomment -%}
      {%- assign has_subscription = false -%}
      {%- for line_item in cart.items -%}
        {%- if line_item.product.tags contains "subscriptions-products" -%}
          {%- comment -%} Check if has selling plan allocation (native Shopify subscriptions) {%- endcomment -%}
          {%- if line_item.selling_plan_allocation != nil -%}
            {%- assign has_subscription = true -%}
            {%- break -%}
          {%- endif -%}

          {%- comment -%} Check if has subscription property {%- endcomment -%}
          {%- for property in line_item.properties -%}
            {%- assign property_key = property.first | downcase -%}
            {%- if property_key contains "subscription" -%}
              {%- assign has_subscription = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if has_subscription -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if has_subscription -%}
        <div class="subscription_message" style="background: #fff3cd; border: 1px solid #ffc107; border-radius: 8px; padding: 15px; color: #856404; margin: 20px 0;">
          <p style="margin: 0; font-weight: 500; font-size: 14px;">Your cart has a subscription product, please note we deliver only in Dubai region</p>
        </div>
      {%- endif -%}
      {%- assign non_deliverable = false -%}
      {%- if customer.default_address.province == "Sharjah" or  customer.default_address.province == "Ajman"-%} 
        {%- assign non_deliverable = true -%}
      {%- endif -%}
      {%- if non_deliverable -%}
        <div class="non_deliverable_message" style="background: #fff3cd; border: 1px solid #ffc107; border-radius: 8px; padding: 15px; color: #856404; margin: 20px 0;">
          <p style="margin: 0; font-weight: 500; font-size: 14px;">It appears your default address is in {{customer.default_address.province}}. Unfortunately, we currently do not deliver to this location.</p>
        </div>
      {%- endif -%}
      <div class="ta-center d-none {{ cart_empty_show }}">
        <p class="mb-24">{{ 'sections.cart.empty' | t }}</p>
        <a class="btn btn-primary btn-large" href="{{ routes.all_products_collection_url }}">{{ 'general.cart.continue_shopping' | t }}</a>
      </div>
      <form action="{{ routes.cart_url }}" method="post" id="cartForm" class="{{ cart_empty_hide }}">
        <div class="rw">
          <div class="pb-24 pb-sm-36 js-cart-form-wrapper clm" id="mainCartForm" data-section-id="{{ section.id }}" style="--w-xs: 12; --w-md:8; ">
            <div class="js-cart-form-content-cart-items mr-md-16 mr-xl-20">
              {%- if cart != empty -%}
                <div class="cart-content__headings d-grid-md c-gap pb-md-24" style="--gtc-equal:4">
                  <div class="d-none d-block-md fw-700 padding--start" style="--gc-xs: 1 / span 3; --gc-md: 1 / span 2">
                    {{ 'sections.cart.label.product' | t }}
                  </div>
                  <div class="d-none d-block-md fw-700 padding--start">
                    {{ 'sections.cart.label.quantity' | t }}
                  </div>
                  <div class="d-none d-block-md fw-700 ta-right">
                    {{ 'sections.cart.label.total' | t }}
                  </div>
                </div>
                <div class="cart-items d-grid r-gap-32 r-gap-md-36">
                  {% for line_item in cart.items %}
                  {% unless line_item.product.tags contains "Pre-Order-Item" %}
                    <div class="cart-item d-grid middle-md lagu" id="cartItem-{{ line_item.index | plus: 1 }}">
                      <div class="cart-item__product d-grid start-md mr-12 m-zero-md gap-12 top-xs gap-md-24">
                        <div class="cart-item__image p-relative o-hidden corner-radius-xs">
                          {%- liquid
                            assign media = 'image' | placeholder_svg_tag: 'placeholder js-image-lazy'
                            assign media = line_item.image | image_url: width: 300 | image_tag: widths: '300', sizes: '100vw', alt: line_item.product.title, class: 'media w-100 h-100 of-cover'
                          %}
                          {% render 'image', image_item: media, image_classes: 'corner-radius-xs' %}
                        </div>
                        <div class="wb-break-word">
                          {% if settings.enable_cart_product_vendor %}
                            <p class="subtext color-light mb-8">
                              {{ line_item.product.vendor }}
                            </p>
                          {% endif %}
                          <a href="{{ line_item.url }}" class="fw-700 card__heading mb-8 d-block">{{ line_item.product.title | escape }}</a>
                          
                          {%- if line_item.product.has_only_default_variant == false or line_item.properties.size != 0 or line_item.selling_plan_allocation != null -%}
                            <dl class="m-zero subtext color-light wb-break-word hide-empty">
                              {%- if line_item.product.has_only_default_variant == false -%}
                                <div class="product-option">
                                  <span>
                                    {%- liquid
                                      assign options_names = ''
                                      for option in line_item.options_with_values
                                        assign options_names = options_names | append: ', ' | append: option.value
                                      endfor
                                      echo  options_names | replace_first: ', ', ''
                                    -%}
                                    </span>
                                </div>
                              {%- endif -%}
                              {%- for property in line_item.properties -%}
                                {%- assign property_first_char = property.first | slice: 0 -%}
                                {%- if property.last != blank and property_first_char != '_' -%}
                                  <div class="product-option">
                                    <p>{{ property.first }}:
                                      {%- if property.last contains '/uploads/' -%}
                                        <a href="{{ property.last }}" class="link" target="_blank">
                                          {{ property.last | split: '/' | last }}
                                        </a>
                                      {% else %}
                                        {{ property.last }}
                                      {% endif %}
                                    </p>
                                  </div>
                                {%- endif -%}
                              {%- endfor -%}
                            </dl>
                          {%- endif -%}
                          {%- if line_item.variant.available and line_item.unit_price_measurement -%}
                            <div class="color-light subtext mt-8">
                              <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
                              {{ line_item.variant.unit_price | money }}
                              <span aria-hidden="true">/</span>
                              <span class="visually-hidden">&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span>
                              {%- if line_item.variant.unit_price_measurement.reference_value != 1 -%}
                                {{- line_item.variant.unit_price_measurement.reference_value -}}
                              {%- endif -%}
                              {{ line_item.variant.unit_price_measurement.reference_unit }}
                            </div>
                          {%- endif -%}
                          <div class="cart-item__sale d-flex fd-column gap-12 hide-empty mt-16">
                            {%- if line_item.selling_plan_allocation != nil -%}
                              <div class="cart-item__discounted subtext hide-empty d-flex middle-xs">
                                <span class="discounted-icon icon icon--small mr-8 fs-0">
                                  {% render 'icon-subscription', size: 16 %}
                                </span>
                                <span>
                                  {{ line_item.selling_plan_allocation.selling_plan.name }}
                                </span>
                              </div>
                            {%- endif -%}
                            {%- if line_item.original_line_price != line_item.final_line_price -%}
                              <ul class="ls-none subtext hide-empty">
                                {%- for discount in line_item.discounts -%}
                                  <li class="cart-item__discounted d-grid middle-xs">
                                    <span class="discounted-icon icon icon--small mr-8 fs-0">
                                      {% render 'icon-voucher', size: 16 %}
                                    </span>
                                    <span>
                                      {{ discount.title }}
                                      (
                                      {{- discount.savings | money -}}
                                      )
                                    </span>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </div>
                        </div>
                      </div>
                      <div class="cart-item__quantity padding--start ml-12 mt-16 m-zero-md">
                        <div class="d-flex middle-xs">
                          <label class="visually-hidden" for="quantity-{{ line_item.index | plus: 1 }}">
                            {{ 'products.product.quantity.label' | t }}
                          </label>
                          <sht-qty-inp class="field_quantity d-inline-flex middle-xs center-xs btn-small mr-8">
                            <button class="js-quantity-btn js-quantity-btn-minus icon--small btn btn-icon btn-plain no-js-hidden" name="minus" data-name="minus" type="button" aria-label="{{ 'accessibility.minus' | t }}">
                              {{ icon_minus }}
                            </button>
                            <input
                              class="js-quantity-input input-number icon--small b-zero ta-center"
                              type="number"
                              name="updates[]"
                              value="{{ line_item.quantity }}"
                              data-cart-quantity="{{ cart | item_count_for_variant: line_item.variant.id }}"
                              min="0"
                              aria-label="{{ 'products.product.quantity.input_label' | t: product: line_item.product.title | escape }}"
                              id="quantity-{{ line_item.index | plus: 1 }}"
                              data-index="{{ line_item.index | plus: 1 }}"
                              data-variant-id="{{ line_item.variant.id }}"
                            >
                            <button class="js-quantity-btn js-quantity-btn-plus icon--small btn btn-icon btn-plain no-js-hidden" name="plus" data-name="plus" type="button" aria-label="{{ 'accessibility.plus' | t }}">
                              {{ icon_plus }}
                            </button>
                          </sht-qty-inp>
                          <sht-cart-rmv-btn data-index="{{ line_item.index | plus: 1 }}" data-variant-id="{{ line_item.variant.id }}">
                            <a href="{{ line_item.url_to_remove }}" class="btn btn-icon btn-secondary icon--small bg-transparent b-zero d-inline-flex middle-xs center-xs" aria-label="{{ 'accessibility.delete' | t }}">
                              {{ icon_remove }}
                            </a>
                          </sht-cart-rmv-btn>
                        </div>
                        <div class="d-none-important d-flex mt-16 center-cs middle-xs" id="line-item-error-{{ line_item.index | plus: 1 }}" role="alert">
                          <div class="icon icon--small icon--error fs-0 mr-8">
                            {% render 'icon-error', size: 16 %}
                          </div>
                          <small class="js-cart-form-item-error-message"></small>
                        </div>
                      </div>
                      <div class="cart-item__price ta-right">
                        <div class="wb-break-word d-flex fd-column">
                          {%- if line_item.original_line_price != line_item.final_line_price -%}
                            <div class="cart-item__discounted-prices">
                              <span class="visually-hidden">
                                {{ 'products.product.price.sale_price' | t }}
                              </span>
                              <span class="d-block fw-400 mb-4">
                                {{ line_item.final_line_price | money_with_currency }}
                              </span>
                              <span class="visually-hidden">
                                {{ 'products.product.price.regular_price' | t }}
                              </span>
                              <s class="color-light subtext">
                                {{ line_item.original_line_price | money_with_currency }}
                              </s>
                            </div>
                          {%- else -%}
                            <span class="d-block fw-400">
                              {{ line_item.original_line_price | money_with_currency }}
                            </span>
                            {% if line_item.variant.compare_at_price > line_item.variant.price %}
                                <s class="color-light subtext d-block"> {{ line_item.variant.compare_at_price | times: line_item.quantity | money_with_currency }} </s>
                              {% endif %}
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                  {% endunless %}
                  {% endfor %}
                </div>
                {%- assign has_preorder = false -%}
                {%- for line_item in cart.items -%}
                  {%- if line_item.product.tags contains "Pre-Order-Item" -%}
                    {%- assign has_preorder = true -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}

                {%- assign all_preorder = true -%}
                {%- for line_item in cart.items -%}
                  {%- unless line_item.product.tags contains "Pre-Order-Item" or line_item.product.title == "Shipping Charge" -%}
