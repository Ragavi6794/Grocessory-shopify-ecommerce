              <p><b>{% if localization.language.iso_code == "ar" %}وقت التوصيل :{% else %}Time-Slot :{% endif %} </b><span id="timeslot-view-ld">{% if localization.language.iso_code == "ar" %}لم يتم التحديد{% else %}Not Selected{% endif %}</span></p>

