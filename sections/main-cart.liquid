$(".checkout-button-ctrl").prop("disabled", true);

const targetNode = document.querySelector("#local_delivery");
const observer = new MutationObserver(() => {
  const timeslotStr = $("#local_delivery").val();
  let timeSlot = "";

  if (timeslotStr && timeslotStr.includes("between")) {
    timeSlot = timeslotStr.split("between")[1].trim();
  }

  // Enable save button only if a timeslot is selected
  toggleSaveButton();

  $('#save-timeslot').off('click').on('click', (e) => {
    // Check subscription condition first
    let hasSubscription = false;
    if ($(".subscription_message").length > 0) {
      hasSubscription = true;
    }
    let non_deliverable = false;
    if ($(".non_deliverable_message").length > 0) {
      non_deliverable = true;
    }
    
    let selectedProvince = $('input[name="shipping_address"]:checked').attr('data-province');
    let non_deliverable_selectedProvince = false;

    if (selectedProvince === "Sharjah" || selectedProvince === "Ajman") {
      non_deliverable_selectedProvince = true;
    }


    // Prevent default if subscription product and not Dubai
    if (hasSubscription && selectedProvince && selectedProvince !== 'Dubai') {
      $("#save-timeslot").prop("disabled", true);
      $("#subscription-warning-timeslot").show();
      e.preventDefault();
      console.log('🚫 Cannot save timeslot: Subscription product only available in Dubai');
      $(".subscription-message").show();
      setTimeout(() => {
        $(".subscription-message").hide();
      }, 5000);
      return false;
    } else {
      $("#subscription-warning-timeslot").hide();
    }
    
    const datepickeNew = $("#datepicker").val();
    const timeslotStrfinal = $("#local_delivery").val();
    let timeSlotfinal = "";

    console.log("hasSubscription:", hasSubscription);
    if (timeslotStrfinal && timeslotStrfinal.includes("between")) {
      timeSlotfinal = timeslotStrfinal.split("between")[1].trim();
    }

    // Enable checkout only if both date and timeslot are selected
    if (datepickeNew && timeSlotfinal) {
      $("#date-view-ld").text(datepickeNew); 
      $("#timeslot-view-ld").text(timeSlotfinal); 

      modal.hide();
      
      // Get the selected province for subscription check
      let subscriptionDataCityMain = $('input[name="shipping_address"]:checked').attr('data-province');
      let selectedPhone = $('input[name="shipping_address"]:checked').attr('data-phone');
      
      // Validate phone number
      if (!selectedPhone || selectedPhone.trim() === '' || selectedPhone === 'null' || selectedPhone === 'undefined') {
        console.warn('Phone number is missing in selected address');
        document.querySelector('.checkout-button-ctrl').disabled = true;
        $(".wk_pay_wallet.oncartpage").hide();
        $("#checkoutButtonError").text('⚠️ Phone number is missing in your address. Please update your address.');
        $("#checkoutButtonError").show();
        return;
      }
      
      // Check if this is a subscription product and not in Dubai
      if (hasSubscription == true && subscriptionDataCityMain !== 'Dubai') {
        console.log('Subscription product not available outside Dubai');
        $(".checkout-button-ctrl").prop("disabled", true);
        $(".wk_pay_wallet.oncartpage").hide();
        $(".timeslot-message").hide();
        $(".subscription-message").show();
        $("#checkoutButtonError").text('').hide();
      } else {
        $(".checkout-button-ctrl").prop("disabled", false); // Enable checkout
        $(".wk_pay_wallet.oncartpage").show();
        $(".subscription-message").hide();
        $("#checkoutButtonError").text('').hide();
      }
        $(".open-modal-btn").text("Change Time Slot >");

        // Sync timeslot + address data to cart metafields
        if (window.CartMetafields) {
          window.CartMetafields.syncDeliveryData();
        }
    } else {
      // Keep save and checkout buttons disabled
      $(".checkout-button-ctrl").prop("disabled", true);
      $("#save-timeslot").prop("disabled", true);
    }
  });
});

// Also watch for changes in datepicker or timeslot to enable Save button
$(document).on('change', '#datepicker, #local_delivery', toggleSaveButton);

// Function to enable/disable Save button based on selections
function toggleSaveButton() {
  const dateSelected = $("#datepicker").val();
  const timeslotSelected = $("#local_delivery").val() && $("#local_delivery").val().includes("between");
  
  if (dateSelected && timeslotSelected) {
    
    // Check if subscription product and not Dubai
    let hasSubscription = false;
    if ($(".subscription_message").length > 0) {
      hasSubscription = true;
    }
    
    let selectedProvince = $('input[name="shipping_address"]:checked').attr('data-province');
    
    if (hasSubscription && selectedProvince && selectedProvince !== 'Dubai') {
      $("#save-timeslot").prop("disabled", true);
      $("#subscription-warning-timeslot").show();
    } else {
      $("#save-timeslot").prop("disabled", false);
      $("#subscription-warning-timeslot").hide();
    }
  } else {
    $("#save-timeslot").prop("disabled", true);
    $("#subscription-warning-timeslot").hide();
  }
}


// Observe attribute and value changes on the input
observer.observe(targetNode, { attributes: true, childList: true, subtree: true });

  //----------------------------------------
  
$(".checkout-btn-container-ctrl").on("click",()=>{
  if ($(".checkout-button-ctrl").prop("disabled")) {
