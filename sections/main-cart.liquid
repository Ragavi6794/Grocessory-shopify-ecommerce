<script>
$(document).ready(function() {
      let dataCityMain = $('input[name="shipping_address"]:checked').attr('data-province');
      $("#location-view-ld").text(dataCityMain)

  // --- Parse Metafield JSON (Multi-location) ---
  const metafieldRaw = `{{ shop.metafields.custom.timeslot_details | escape }}`;
  const metafieldJson = metafieldRaw.replace(/&quot;/g, '"');

  let timeslotData = {};
  try {
    timeslotData = JSON.parse(metafieldJson);
  } catch (error) {
    console.error("❌ Invalid JSON in metafield:", error);
    timeslotData = {};
  }

  // --- Helper: Parse time range like "10am - 1pm" ---
  function parseTimeRange(rangeStr, baseDate) {
    if (!rangeStr) return null;
    const [start, end] = rangeStr.split(" - ").map(s => s.trim());

    function parseTo24Hour(timeStr) {
      const match = timeStr.match(/(\d{1,2})(?::(\d{2}))?\s*(am|pm)/i);
      if (!match) return null;
      let hour = parseInt(match[1], 10);
      let minute = match[2] ? parseInt(match[2], 10) : 0;
      const period = match[3].toLowerCase();
      if (period === "pm" && hour < 12) hour += 12;
      if (period === "am" && hour === 12) hour = 0;
      return { hour, minute };
    }

    const startParts = parseTo24Hour(start);
    const endParts = parseTo24Hour(end);
    if (!startParts || !endParts) return null;

    const startDate = new Date(baseDate);
    startDate.setHours(startParts.hour, startParts.minute, 0, 0);

    const endDate = new Date(baseDate);
    endDate.setHours(endParts.hour, endParts.minute, 0, 0);

    return { start: startDate, end: endDate };
  }

  // --- Helper: Format time for display ---
  function formatTime(timeStr) {
    const match = timeStr.match(/(\d{1,2})(?::(\d{2}))?\s*(am|pm)/i);
    if (!match) return timeStr;
    let hour = parseInt(match[1], 10);
    let minute = match[2] ? ':' + match[2] : ':00';
    const period = match[3].toUpperCase();
    return hour + minute + ' ' + period;
  }

  // --- Main Function: Update timeslot based on location ---
  function updateTimeslots(baseDate = new Date(), locationName = null) {
    if (!timeslotData.locations) {
      console.error("⚠️ No locations found in metafield");
      return;
    }

    // Use provided locationName or fall back to dataCityMain
    const selectedLocation = locationName || dataCityMain?.trim();
    const locationData = timeslotData.locations[selectedLocation];

    if (!locationData) {
      console.warn(`⚠️ No schedule found for location: ${selectedLocation}`);
      $("#date-view-ld").text("").css("color", "red");
      $("#timeslot-view-ld").text("").css("color", "red");
      return;
    }

    const schedule = locationData.schedule;
    if (!schedule) {
      console.error(`⚠️ Missing schedule for ${selectedLocation}`);
      return;
    }

    // Always use Dubai timezone
    const dubaiNow = new Date(new Date().toLocaleString("en-US", { timeZone: "Asia/Dubai" }));
    const targetDate = new Date(baseDate.toLocaleString("en-US", { timeZone: "Asia/Dubai" }));

    const dayName = targetDate.toLocaleDateString("en-GB", { weekday: "long" }).toLowerCase();
    const todaySlots = schedule[dayName] || [];

    const validSlots = todaySlots.filter(item => {
      const parsed = parseTimeRange(item.slot, targetDate);
      if (!parsed) return false;
      const cutoffTime = new Date(parsed.start.getTime() - item.cutoff_hours * 60 * 60 * 1000);
      return dubaiNow < cutoffTime;
    });

    let nextSlot = null;
    for (let item of validSlots) {
      const parsed = parseTimeRange(item.slot, targetDate);
      if (parsed && parsed.start > dubaiNow) {
        nextSlot = item.slot;
        break;
      }
    }

    console.log(`📅 Checking: ${selectedLocation} | ${dayName} (${targetDate.toLocaleDateString('en-GB')})`);
    console.log("✅ Valid Slots:", validSlots.map(i => i.slot));
    console.log("🌟 Next Slot:", nextSlot || "None");

    // If no slot today → check tomorrow recursively
    if (!nextSlot) {
      const nextDay = new Date(targetDate);
      nextDay.setDate(targetDate.getDate() + 1);
      console.log("➡️ No slot today, checking next day...");
      return updateTimeslots(nextDay, locationName);
    }

    // Update DOM
    const formattedDate = targetDate.toLocaleDateString("en-GB", {
      timeZone: "Asia/Dubai",
      day: "2-digit",
      month: "2-digit",
      year: "numeric"
    });

    const [startTime, endTime] = nextSlot.split(' - ').map(t => t.trim());
    const formattedSlot = `${formatTime(startTime)} and ${formatTime(endTime)}`;

    $("#date-view-ld").text(formattedDate).css("color", "");
    $("#timeslot-view-ld").text(formattedSlot).css("color", "");

    console.log("🎉 Timeslot Updated Successfully!");

    // Only enable if phone number exists
    let selectedAddress = $("input[name='shipping_address']:checked");
    let phoneNumber = selectedAddress.attr('data-phone');
    if (phoneNumber && phoneNumber.trim() !== '' && phoneNumber !== 'null' && phoneNumber !== 'undefined') {
      $(".checkout-button-ctrl").prop("disabled", false);
    } else {
      console.warn('Cannot enable checkout - phone number is missing');
      $(".checkout-button-ctrl").prop("disabled", true);
      $("#checkoutButtonError").text('⚠️ Phone number is missing in your address. Please update your address.').show();
    }

    return { date: formattedDate, slot: formattedSlot };
  }

  
  // Check delivery type and adjust starting date for Full Delivery pre-orders
  window.initializeTimeslots = function() {
    // Get the currently selected shipping address province
    const selectedProvince = $('input[name="shipping_address"]:checked').attr('data-province');
    const selectedPhone = $('input[name="shipping_address"]:checked').attr('data-phone');
    let newselectedAddress = $("input[name='shipping_address']:checked");

    if (newselectedAddress.length > 0) {
      // Validate phone number first
      if (!selectedPhone || selectedPhone.trim() === '' || selectedPhone === 'null' || selectedPhone === 'undefined') {
        console.warn('⚠️ Cannot initialize timeslots - phone number is missing');
        $(".checkout-button-ctrl").prop("disabled", true);
        $("#checkoutButtonError").text('⚠️ Phone number is missing in your address. Please update your address.').show();
        return;
      }
    }
    
    if (selectedProvince) {
      console.log('🌍 Using Province for timeslot:', selectedProvince);
    } else {
      console.warn('⚠️ No shipping address selected');
    }
    
    // Check for subscription products
    let hasSubscription = false;
    if ($(".subscription_message").length > 0) {
      hasSubscription = true;
    }
    
    // If subscription product exists and province is not Dubai, block checkout
    if (hasSubscription && selectedProvince && selectedProvince !== 'Dubai') {
      console.log('🚫 Subscription product detected with non-Dubai address');
      $(".checkout-button-ctrl").prop("disabled", true);
      $(".wk_pay_wallet.oncartpage").hide();
      $(".subscription-message").show();
      $("#subscription-warning-timeslot").show();
      $("#save-timeslot").prop("disabled", true);
      $("#date-view-ld").text("Not Available").css("color", "red");
      $("#timeslot-view-ld").text("Dubai Only").css("color", "red");
      return; // Don't proceed with timeslot initialization
    }
    
    // Hide subscription message if conditions are met
    $(".subscription-message").hide();
    $("#subscription-warning-timeslot").hide();
    
    const deliveryType = $("#deliveryType").val();
    if (deliveryType === "Full Delivery") {
      const baseDate = new Date();
      baseDate.setDate(baseDate.getDate() + 3); // Add 3 days for Full Delivery pre-orders
      updateTimeslots(baseDate, selectedProvince);
    } else {
      updateTimeslots(new Date(), selectedProvince);
    }
  }
  
  // Initialize timeslots on page load
  initializeTimeslots();
  
  // Re-initialize when delivery type changes
  $("#deliveryType").on('change', function() {
    resetLocalDeliverySelection();
  });


  // --- code ends ---

      $('input[name="shipping_address"]').on('change', function () {
       let dataCityMain = $('input[name="shipping_address"]:checked').attr('data-province');
       console.log('Selected Province:', dataCityMain);
      $("#location-view-ld").text(dataCityMain);

      // Re-initialize timeslots when address changes to check subscription conditions
      initializeTimeslots();

      // Rebuild cart note with updated address data
      revalidateCartAddress();
      if (window.CartMetafields) window.CartMetafields.syncDeliveryData();
    });


  
// ---------------------loader---

     $("#ld_delivery_areas_div_content_box").hide();
     $("#date_div").hide()
  
     $("#ld_delivery_areas_div_content_box").before('<div id="loading-message">Your address is being set up for Checkout... <div class="loader"></div> </div> ');
    $(window).on('load', function() {
    $("#ld_delivery_areas_div_content_box").show();
    $("#date_div").show()

    $("#loading-message").remove();
