{%- liquid
  assign desktop_thumbnail     = 'lifestyle-1' | placeholder_svg_tag: 'placeholder media d-none d-block-sm w-100 h-100 of-cover'
  assign mobile_thumbnail      = 'lifestyle-1' | placeholder_svg_tag: 'placeholder media d-none-sm d-block w-100 h-100 of-cover'
  assign alt_video_thubnail    = 'sections.video_with_text.load_video' | t: description: section.settings.video_alt_text | escape
  assign desktop_thumbnail     = section.settings.desktop_thumbnail | image_url: width: section.settings.desktop_thumbnail.width | image_tag: widths: '750, 950, 1024, 1200, 1400, 1600, 1800, 2000', sizes: "(min-width: 361px) calc(100vw/2), calc(100vw/3)", alt: alt_video_thubnail, class: 'd-none d-block-sm media w-100 h-100 of-cover'
  assign mobile_thumbnail      = section.settings.mobile_thumbnail | image_url: width: section.settings.mobile_thumbnail.width | image_tag: widths: '750, 950', sizes: "(min-width: 361px) calc(100vw/2), calc(100vw/3)", alt: alt_video_thubnail, class: 'd-none-sm d-block media w-100 h-100 of-cover'

-%}

{%- liquid
    assign section_style = 's-media-with-text--solid'
    assign page_background_color = settings.page_background | downcase
    assign section_background_color = section.settings.color_scheme.settings.color_background | downcase
    assign container_rounded = 'corner-radius-m corner-radius-zero-mb'
    if page_background_color == section_background_color or section.settings.color_scheme.settings.color_background.alpha == 0.0
        assign section_style = 's-media-with-text--transparent'
        assign media_rounded = 'corner-radius-m'
        assign container_rounded = ''
    endif
-%}
<div class="section section-index--{{section.index |  replace: '1', 'first' }} s-media-with-text color-{{- section.settings.color_scheme }}">
  <div class="ctnr s-media-with-text-ctnr {{ section_style }}  d-grid {{ container_rounded }} js-animate anm" style="--gtc-equal-md:2; --mh-md:{{ section.settings.height }}; --duration: .6s" data-ui-component="Video With Text Section">
    <div class="s-media-with-text__content s-card h-100 d-flex fd-column center-xs background" >
      <div class="s-header__content d-flex fd-column top-xs anm anm-fadeInUpLarge anm-card" style="--duration: .7s;">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'subheading' -%}
              {%- if block.settings.subheading != blank -%}
                <span class="s-header__subheading d-inline-block fw-700 hide-empty">{{- block.settings.subheading -}}</span>
              {%- endif -%}
            {%- when 'heading' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="s-header__heading {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                  {{- block.settings.heading -}}
                </h2>
              {%- endif -%}
            {%- when 'description' -%}
              {%- if block.settings.description != blank -%}
                <div class="s-header__description" {{ block.shopify_attributes }}>
                  {{- block.settings.description -}}
                </div>
              {%- endif -%}
            {%- when 'countdown' -%}
              <div class="s-header__countdown countdown-wrapper d-grid w-100" {{ block.shopify_attributes }}>
                  {%- render 'countdown', block: block  -%}
              </div>
            {%- when 'buttons' -%}
              <div class="s-header__buttons d-flex gap-8 fw-wrap" {{ block.shopify_attributes }}>
                {%- if block.settings.button_1_label != blank -%}
                  <a class="btn btn-large {{ block.settings.button_1_style }}" href="{{- block.settings.button_1_link | default: '#' -}}">{{- block.settings.button_1_label -}}</a>
                {%- endif -%}
                {%- if block.settings.button_2_label != blank -%}
                  <a class="btn btn-large {{ block.settings.button_2_style }}" href="{{- block.settings.button_2_link | default: '#' -}}">{{- block.settings.button_2_label -}}</a>
                {%- endif -%}
              </div>
            {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
    <div class="s-media-with-text__media h-100 w-100 p-relative o-hidden {{ media_rounded }} {{ section.settings.content_ordering }}">
      <div class="h-100 w-100 media-wrapper anm anm-zoomOut anm-card" style="--duration: .7s;">
        <sht-load-media class="d-block p-relative h-100" style="--ratio: 16/9">
          <button class="w-100 h-100 b-zero p-zero c-pointer js-load-media-trigger p-relative media-wrapper media-hover-zoomed o-hidden" type="button" aria-label="{{ 'accessibility.load_video' | t: video: section.settings.video_alt_text }}">
            {%- liquid
              if section.settings.mobile_thumbnail
                  echo mobile_thumbnail | replace: "src=", 'data="mobile" loading="lazy" decoding="async" fetchpriority="low" src='
              else
                assign desktop_thumbnail   = desktop_thumbnail | replace: 'd-none d-block-sm', ''
              endif
              echo desktop_thumbnail | replace: "src=", 'loading="lazy" decoding="async" fetchpriority="low" src='
            -%}
            <span class="p-absolute center-middle">
              <span class="btn btn-secondary btn-large btn-icon icon">
                {%- render 'icon-play' -%}
              </span>
            </span>
          </button>
          {%- if section.settings.video_hosted -%}
            <template>
              {{- section.settings.video_hosted | video_tag: autoplay: true, muted: section.settings.enable_video_mute, loop: section.settings.enable_video_loop, controls: true, preload: 'none', class: 'background-video w-100 h-100 media d-block js-media-item-video' -}}
            </template>
          {%- else -%}
            <template>
              {%- if section.settings.video.type == 'youtube' -%}
                <iframe title="{{ section.settings.video.type }}" class="w-100 h-100 media js-media-item-youtube background-video" allow="autoplay; encrypted-media" src="https://www.youtube.com/embed/{{ section.settings.video.id }}?version=3&enablejsapi=1&mute={{ section.settings.enable_video_mute | default: '0' | replace: 'true', '1' }}&autoplay=1&loop={{ section.settings.enable_video_loop | default: '0' | replace: 'true', '1' }}&playlist={{ section.settings.video.id }}" style="--ratio: 16/9"></iframe>
              {%- elsif section.settings.video.type == 'vimeo' -%}
                <iframe title="{{ section.settings.video.type }}" class="w-100 h-100 media js-media-item-vimeo background-video vwt-vimeo" allow="autoplay; encrypted-media" src="https://player.vimeo.com/video/{{ section.settings.video.id }}?api=1&background=0&loop={{ section.settings.enable_video_loop | default: '0' | replace: 'true', '1' }}&autoplay=1&muted={{ section.settings.enable_video_mute | default: '0' | replace: 'true', '1' }}" style="--ratio: 16/9"></iframe>
              {%- endif -%}
            </template>
          {%- endif -%}
        </sht-load-media>
      </div>
    </div>

</div>
{%- render 'section-id', section: section -%}
</div>
{% schema %}
{
  "name": "t:sections.video_with_text.name",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.headers.header_general.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_ordering",
      "label": "t:general.settings.content_ordering_large_screen.label",
      "default": "s-media-with-text__media--first",
      "options": [
        {
          "value": "s-media-with-text__media--last",
          "label": "t:general.settings.content_ordering.options.option_text_first.label"
        },
        {
          "value": "s-media-with-text__media--first",
          "label": "t:general.settings.content_ordering.options.option_video_first.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.header_video.content"
    },
    {
      "type": "video_url",
      "id": "video",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
      "label": "t:general.settings.external_video.label",
      "info": "t:general.settings.video_link.info"
    },
    {
      "type": "video",
      "id": "video_hosted",
      "label": "t:general.settings.headers.header_hosted_video.content",
      "info": "t:general.settings.video_hosted.info"
    },
    {
      "type": "text",
      "id": "video_alt_text",
      "label": "t:sections.video_with_text.settings.video_alt_text.label",
      "info": "t:sections.video_with_text.settings.video_alt_text.info"
    },

    {
      "type": "header",
      "content": "t:general.settings.headers.header_layout.content"
    },
    {
      "type": "select",
      "label": "t:general.settings.height_on_large_screen.label",
      "info": "t:general.settings.height_on_large_screen.info",
      "id": "height",
      "options": [
        {
          "value": "70vh",
          "label": "t:general.settings.height.options.option_70.label"
        },
        {
          "value": "100vh",
          "label": "t:general.settings.height.options.fill_screen_height.label"
        }
      ],
      "default": "70vh"
    },
    {
      "type": "image_picker",
      "id": "desktop_thumbnail",
      "label": "t:sections.video_with_text.settings.video_thumbnail.label"
    },
    {
      "type": "image_picker",
      "id": "mobile_thumbnail",
      "label": "t:sections.video_with_text.settings.video_thumbnail_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "enable_video_loop",
      "label": "t:sections.video_with_text.settings.enable_video_loop.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_video_mute",
      "label": "t:sections.video_with_text.settings.enable_video_mute.label",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "subheading",
      "name": "t:general.settings.subheading.label",
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "label": "t:general.settings.text.label",
          "default": "Text block heading"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:general.settings.heading.label",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:general.settings.text.label",
          "default": "Video with text"
        },
        {
          "type": "select",
          "label": "t:general.settings.text_size.label",
          "id": "heading_size",
          "options": [
            {
              "value": "headline",
              "label": "t:general.settings.heading_size.options.headline.label"
            },
            {
              "value": "h1",
              "label": "t:general.settings.heading_size.options.h1.label"
            },
            {
              "value": "h2",
              "label": "t:general.settings.heading_size.options.h2.label"
            },
            {
              "value": "h3",
              "label": "t:general.settings.heading_size.options.h3.label"
            },
            {
              "value": "h4",
              "label": "t:general.settings.heading_size.options.h4.label"
            },
            {
              "value": "h5",
              "label": "t:general.settings.heading_size.options.h5.label"
            },
            {
              "value": "h6",
              "label": "t:general.settings.heading_size.options.h6.label"
            }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "description",
      "name": "t:general.settings.description.label",
      "settings": [
        {
          "type": "richtext",
          "id": "description",
          "label": "t:general.settings.text.label",
          "default": "<p>Share information about your products, policies or services.</p>"
        }
      ]
    },
    {
      "type": "countdown",
      "name": "t:general.settings.countdown_timer.label",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:general.settings.headers.countdown_timer.content"
        },
        {
          "type": "header",
          "content": "t:general.settings.countdown_timer.label"
        },
        {
          "type": "checkbox",
          "id": "hide_on_end",
          "label": "t:general.settings.countdown_timer.hide_countdown.label",
          "default": true
        },
        {
          "type": "text",
          "id": "end_date",
          "label": "t:general.settings.countdown_timer.end_date.label",
          "info": "t:general.settings.countdown_timer.date_format.info"
        },
        {
          "type": "text",
          "id": "end_time",
          "label": "t:general.settings.countdown_timer.end_time.label",
          "info": "t:general.settings.countdown_timer.end_time_format.label"
        },
        {
          "type": "richtext",
          "id": "end_text",
          "label": "t:general.settings.countdown_timer.end_text.label",
          "info": "t:general.settings.countdown_timer.end_text.info.label",
          "default": "<p>This event is finished</p>"
        },
        {
          "type": "header",
          "content": "t:general.settings.custom_color.label"
        },
        {
          "type": "color",
          "id": "countdown_background_color",
          "label": "t:general.settings.countdown_timer.countdown_background.label"
        },
        {
          "type": "color",
          "id": "countdown_number_color",
          "label": "t:general.settings.countdown_timer.countdown_number.label"
        },
        {
          "type": "color",
          "id": "countdown_end_text_color",
          "label": "t:general.settings.countdown_timer.endtext.label",
          "default": "#FF0000"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "t:general.settings.headers.header_buttons.content",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "t:general.settings.button_1.label"
        },
        {
          "type": "text",
          "id": "button_1_label",
          "label": "t:general.settings.button.text.label",
          "default": "Check now",
          "info": "t:general.settings.button_label.info"
        },
        {
          "type": "select",
          "id": "button_1_style",
          "default": "btn-primary",
          "options": [
            {
              "value": "btn-primary",
              "label": "t:general.settings.primary.label"
            },
            {
              "value": "btn-secondary",
              "label": "t:general.settings.secondary.label"
            },
            {
              "value": "btn-link",
              "label": "t:general.settings.tertiary.label"
            }
          ],
          "label": "t:general.settings.button.style.label"
        },
        {
          "type": "url",
          "id": "button_1_link",
          "label": "t:general.settings.button.link.label"
        },
        {
          "type": "header",
          "content": "t:general.settings.button_2.label"
        },
        {
          "type": "text",
          "id": "button_2_label",
          "label": "t:general.settings.button.text.label",
          "default": "View details",
          "info": "t:general.settings.button_label.info"
        },
        {
          "type": "select",
          "id": "button_2_style",
          "default": "btn-secondary",
          "options": [
            {
              "value": "btn-primary",
              "label": "t:general.settings.primary.label"
            },
            {
              "value": "btn-secondary",
              "label": "t:general.settings.secondary.label"
            },
            {
              "value": "btn-link",
              "label": "t:general.settings.tertiary.label"
            }
          ],
          "label": "t:general.settings.button.style.label"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "t:general.settings.button.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.video_with_text.name",
      "blocks": [
        {
          "type": "subheading"
        },
        {
          "type": "heading"
        },
        {
          "type": "subheading"
        },
        {
          "type": "description"
        },
        {
          "type": "subheading"
        },
        {
          "type": "description"
        },
        {
          "type": "countdown"
        },
        {
          "type": "buttons"
        }
      ]
    }
  ]
}
{% endschema %}