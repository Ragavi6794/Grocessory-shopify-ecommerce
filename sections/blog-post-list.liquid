{%- liquid
  assign placeholder = 'image' | placeholder_svg_tag: 'placeholder media'
  assign show_image = settings.blog_post_card_show_featured_image
  assign image_ratio = settings.blog_post_card_featured_image_ratio

  assign show_excerpt = settings.blog_post_card_show_excerpt
  assign show_published_date = settings.blog_post_card_show_published_date
  assign show_author = settings.blog_post_card_show_author
  assign show_read_more = settings.blog_post_card_show_read_more
  assign items_to_show = section.settings.items_to_show

  assign items_per_row_on_desktop = section.settings.items_per_row_on_desktop | plus: 0
  assign items_per_row_on_mobile = section.settings.items_per_row_on_mobile | plus: 0
  assign column_desktop = 12.0 | divided_by: section.settings.items_per_row_on_desktop
 -%}
 <div class="section section-index--{{section.index |  replace: '1', 'first' }} {% render 'sections-spacing' %} color-{{- section.settings.color_scheme }}">
<div class="ctnr background" data-ui-component="Blog Post List Section" role="region" aria-labelledby="sectionHeading-{{ section.id | md5 | truncate: 12, "" }}">
  <div class="m-auto js-animate" style="--w-xs:12;">
    {%- render 'section-header',
        content_align: section.settings.content_alignment,
        subheading: section.settings.subheading,
        heading: section.settings.heading,
        heading_size: section.settings.heading_size,
        description: section.settings.description,
        section: section
      -%}
    <div class="s-content">
      <sht-carousel class="sht-carousel p-relative d-block" data-enable="{{ section.settings.enable_carousel }}">
        <div aria-atomic="true" class="o-hidden rw {{ section.settings.enable_carousel | default: '' | replace: 'true', 'fw-nowrap carousel ox-auto p-relative scrollable scrollable-x disable-scrollbars js-carousel-items m-zero' }}">
          {%- for article in blogs[section.settings.blog].articles limit: items_to_show -%}
              {%- liquid assign total_items = forloop.length | plus: 0 -%}
            <sht-carousel-itm class="clm anm anm-fadeInUpLarge {{ section.settings.enable_carousel | default: '' | replace: 'true', 'carousel__item js-carousel-item p-relative scrollable-aln-start d-flex fd-column middle-xs fg-1 fs-0 p-zero' }}" style="--w-xs:12;--w-sm:6;--w-md: {{ column_desktop }}; --delay: {{ forloop.index | plus: 2 | times: 0.05 -}}s; --duration: .7s" role="group" aria-roledescription="Slide" aria-label="{{ 'accessibility.slide' | t }} {{ forloop.index }} {{ 'accessibility.of' | t }} {{ forloop.length }}" data-item-index="{{ forloop.index }}">
              {%- render 'card-article',
                article: article,
                blog: section.settings.blog,
                show_image: show_image,
                image_ratio: image_ratio,
                show_blog_tag: false,
                show_excerpt: show_excerpt,
                show_published_date: show_published_date,
                show_author: show_author,
                show_read_more: show_read_more
              -%}
            </sht-carousel-itm>
            {%- else -%}
              {%- for i in (1..items_to_show) -%}
                {%- liquid assign total_items = items_to_show -%}
                <sht-carousel-itm class="clm anm anm-fadeInUpLarge {{ section.settings.enable_carousel | default: '' | replace: 'true', 'carousel__item js-carousel-item p-relative scrollable-aln-start d-flex fd-column middle-xs fg-1 fs-0 p-zero' }}" style="--w-xs:12;--w-sm:6;--w-md: {{ column_desktop }}; --delay: {{ forloop.index | plus: 2 | times: 0.05 -}}s; --duration: .7s" role="group" aria-roledescription="Slide" aria-label="{{ 'accessibility.slide' | t }} {{ forloop.index }} {{ 'accessibility.of' | t }} {{ forloop.length }}" data-item-index="{{ forloop.index }}">
                 {%- render 'card-article-placeholder' -%}
                </sht-carousel-itm>
              {%- endfor -%}
          {%- endfor -%}
        </div>

        <div class="carousel-pagination carousel-pagination--position w-100 p-absolute no-js-hidden d-none {{ section.settings.enable_carousel | replace: 'true', 'd-block-md' }}">
          <div class="p-absolute zi-1 left-0">
            <button type="button" data-step="{{ items_per_row_on_desktop }}" class="js-carousel-prev-btn btn btn-secondary btn-icon icon btn-large " aria-label="{{ 'accessibility.previous_slide' | t }}" name="previous" disabled>{% render 'icon-arrow-left' %}</button>
          </div>
          <div class="p-absolute zi-1 right-0">
            <button type="button" data-step="{{ items_per_row_on_desktop }}" class="js-carousel-next-btn btn btn-secondary btn-icon icon btn-large" aria-label="{{ 'accessibility.next_slide' | t }}" name="next" disabled>{% render 'icon-arrow-right' %}</button>
          </div>
        </div>

        {%- if section.settings.show_progress_indicator == true and section.settings.enable_carousel == true -%}
          <div class="slider-scrollbar {% if items_per_row_on_desktop < total_items %} d-flex-md {% else %} d-none-md {% endif %} {% if items_per_row_on_mobile < total_items %} d-flex {% else %} d-none {% endif %}">
            <div class="scrollbar-track js-scrollbar-track" data-thumb-mobile="1" data-thumb-desk="{{ items_per_row_on_desktop }}" data-thumb-total="{{ total_items }}" style="--width-thumb-desktop: {{ items_per_row_on_desktop | times: 100.0 | divided_by: total_items }}%; --width-thumb-mobile: {{ 1 | times: 100.0 | divided_by: total_items }}%">
              <div class="scrollbar-thumb js-scrollbar-thumb"></div>
            </div>
          </div>
        {%- endif -%}

      </sht-carousel>
    </div>
    {% if items_to_show < section.settings.blog.articles_count %}
      <div class="s-footer anm anm-fadeInUpLarge {{ section.settings.content_alignment }} {{ section.settings.show_view_all_button | default: 'd-none' | replace: 'true', 'd-block' }} {% if section.settings.btn_text == blank %}d-none-important {% endif %}" style="--duration: .7s; --delay: .15s">
        <a href="{{ section.settings.blog.url | default: "#" }}" class="btn btn-primary btn-large hide-empty">
          {{- section.settings.btn_text -}}
        </a>
      </div>
    {% endif %}
  </div>

</div>
{%- render 'section-id', section: section -%}
</div>
{% schema %}
{
  "name": "t:sections.blog_post_list.name",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.headers.header_general.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.settings.color_scheme.label",
      "default": "scheme-3"
    },
    {
      "type": "text",
      "label": "t:general.settings.subheading.label",
      "id": "subheading",
      "default": "Add a tagline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:general.settings.heading.label",
      "default": "Our blog posts"
    },
    {
      "type": "select",
      "label": "t:general.settings.heading_size.label",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:general.settings.heading_size.options.h2.label"
        },
        {
          "value": "h3",
          "label": "t:general.settings.heading_size.options.h3.label"
        },
        {
          "value": "h4",
          "label": "t:general.settings.heading_size.options.h4.label"
        },
        {
          "value": "h5",
          "label": "t:general.settings.heading_size.options.h5.label"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:general.settings.description.label"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.blog_post_list.settings.blog.label"
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.header_layout.content"
    },
    {
      "type": "range",
      "id": "items_to_show",
      "label": "t:general.settings.maximum_items_to_show.label",
      "min": 2,
      "max": 12,
      "step": 2,
      "default": 4
    },
    {
      "type": "select",
      "id": "items_per_row_on_desktop",
      "label": "t:general.settings.items_per_row_on_desktop.label",
      "default": "4",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_carousel",
      "label": "t:general.settings.enable_carousel.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_progress_indicator",
      "label": "t:general.settings.show_progress_indicator.label",
      "default": false
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:general.settings.content_alignment.label",
      "default": "ta-center",
      "options": [
        {
          "value": "ta-left",
          "label": "t:general.settings.option_left.label"
        },
        {
          "value": "ta-center",
          "label": "t:general.settings.option_center.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.header_button.content"
    },
    {
      "type": "checkbox",
      "id": "show_view_all_button",
      "label": "t:sections.product_lists.settings.enable_view_more.label",
      "info": "t:sections.product_lists.settings.blog_post_list.info",
      "default": false
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "t:general.settings.label.label",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "t:sections.blog_post_list.name"
    }
  ]
}
{% endschema %}