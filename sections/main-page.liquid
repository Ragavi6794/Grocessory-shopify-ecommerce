{% liquid
  if section.settings.show_page_title == false
    assign content_style = 'pt-0'
  endif
  assign page_background_color = settings.page_background | downcase
  assign section_background_color = section.settings.color_scheme.settings.color_background | downcase
  assign container_rounded = 'corner-radius-m corner-radius-zero-mb'
  if page_background_color == section_background_color or section.settings.color_scheme.settings.color_background.alpha == 0.0
    assign container_rounded = ''
  endif
%}
<div class="section section-index--{{section.index |  replace: '1', 'first' }} {% render 'sections-spacing' %} color-{{- section.settings.color_scheme }}" data-ui-component="Main Page Section">
  <div class="ctnr background corner-radius-m">
    <div class=" js-animate anm anm-fadeInUpSmall" style=" --duration: .7s; width:100%; ">
      {% if section.settings.show_page_title %}
        <div class="s-header ta-center pb-0">
          <h1 class="{{ section.settings.heading_size }} m-zero tt-cap">{{- page.title | escape -}}</h1>
        </div>
      {% endif %}
      {% if section.settings.show_page_content %}
        <div class="s-footer-sm  hide-empty {{ content_style }}">
          {{- page.content -}}
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "t:sections.main_page.name",
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.headers.header_general.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.settings.color_scheme.label",
      "default": "scheme-3"
    },
    {
      "type": "checkbox",
      "id": "show_page_title",
      "label": "t:sections.main_page.settings.show_page_title.label",
      "default": true
    },
    {
      "type": "select",
      "label": "t:general.settings.heading_size.label",
      "id": "heading_size",
      "options": [
        {
          "value": "headline",
          "label": "t:general.settings.heading_size.options.headline.label"
        },
        {
          "value": "h1",
          "label": "t:general.settings.heading_size.options.h1.label"
        },
        {
          "value": "h2",
          "label": "t:general.settings.heading_size.options.h2.label"
        },
        {
          "value": "h3",
          "label": "t:general.settings.heading_size.options.h3.label"
        }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "show_page_content",
      "label": "t:sections.main_page.settings.show_page_content.label",
      "default": true
    }
  ]
}
{% endschema %}
