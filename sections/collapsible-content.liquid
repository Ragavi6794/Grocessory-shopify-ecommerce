{%- liquid
  assign media_alt = section.settings.image.alt | default: section.settings.image.image | split: '/' | last
  assign media = section.settings.image | image_url: width: section.settings.image.width | image_tag: widths: '750, 950, 1024, 1200', sizes: '(min-width: 361px) calc(100vw/2), calc(100vw/3)', alt: media_alt, class: 'media of-cover w-100'
  assign classes = 's-header pb-0'
  assign section_id = section.id | md5 | truncate: 12, ''
  assign subheading = section.settings.subheading
  assign heading = section.settings.heading
  assign heading_size = section.settings.heading_size
  assign description = section.settings.description
  if section.settings.image != blank
    assign classes = 's-header'
    assign ratio = section.settings.image_ratio | replace: 'auto', section.settings.image.aspect_ratio
  endif

  capture icon_chevron_down
    render 'icon-chevron-down', class: 'icon-chevron-down p-absolute'
  endcapture
-%}
<div class="section section-index--{{section.index |  replace: '1', 'first' }} {% render 'sections-spacing' %} color-{{- section.settings.color_scheme }}">
<div class="ctnr js-animate background d-flex c-gap-4x r-gap-4x fd-column fd-row-md center-xs" data-ui-component="Collapsible Content Section" role="region" aria-labelledby="sectionHeading-{{ section_id }}">
  <div class="ta-left-md {{ section.settings.content_alignment }} {% if subheading == blank and heading == blank and description == blank and section.settings.image == blank %} d-none {% endif %}" style="--w-xs:12;--w-sm:12;--w-md:6;">
    {%- render 'section-header', classes: classes, subheading: subheading, heading: heading, heading_size: heading_size, description: description, description_extra_class: 'm-side', section: section -%}
    <div class="p-relative bs-card corner-radius-s">
      {% render 'image', ratio: ratio, image_item: media, image_classes: 'anm anm-zoomOut anm-card-media', media_style: '--duration: .7s;' %}
    </div>
    <div class="s-footer anm anm-fadeInUpLarge d-none d-block-md {{ section.settings.btn_text | default: 'd-none-important' | replace: section.settings.btn_text, '' }}" style="--duration: .7s; --delay: .15s">
      <a class="btn btn-primary btn-large hide-empty" href="{{ section.settings.btn_link | default: '#' }}">
        {{- section.settings.btn_text -}}
      </a>
    </div>
  </div>
  <sht-accordion data-properties='{"multiple": false}' class="accordion d-flex fd-column gap-2x anm anm-fadeInUpLarge anm-card hide-empty" style="--w-xs:12;--w-sm:12;--w-md:6;--duration: .7s;">
    {%- for block in section.blocks limit: section.blocks.size -%}
      {%- liquid
        assign aria_expanded = 'false'
        assign ac_open_css = ''
        assign styles = 'max-height: 0;'

        if section.settings.expand_first_item_initially and forloop.first
          assign aria_expanded = 'true'
          assign ac_open_css = 'open'
          assign styles = ''
        endif
      -%}
      {%- capture custom_icon -%}
        {%- liquid
          assign icon_svg = ''
          assign icon_source = block.settings.icon_source
          if icon_source == 'theme_library'
            render 'icon-loader', icon: block.settings.options_icon, size: 24, class: "custom-icon h-100 w-100 d-block mr-8 mr-sm-12 mr-md-16"
          elsif icon_source == 'custom_img'
            assign custom_icon = 'image' | placeholder_svg_tag: 'placeholder media of-cover'
            assign custom_icon = block.settings.custom_img | image_url: width: block.settings.custom_img.width | image_tag: widths: '120', sizes: '(min-width: 361px) calc(100vw/2), calc(100vw/3)', alt: block.settings.block_heading, class: 'media of-cover h-100 w-100'
            render 'image', image_item: custom_icon, image_wrap_classes: "custom-icon d-block mr-8 mr-sm-12 mr-md-16", image_classes: "h-100 w-100"
          else
            assign icon_svg = block.settings.html_code
          endif
        -%}
        {%- if icon_svg != '' -%}
          <div class="custom-icon h-100 w-100 mr-8 mr-sm-12 mr-md-16">
            {{- icon_svg -}}
          </div>
        {%- endif -%}
      {%- endcapture -%}
      <div class="accordion__item corner-radius-s bs-card js-accordion-item color-{{ section.settings.card_color_scheme }} background" {{ block.shopify_attributes }}>
        <div class="accordion__header wb-break-word">
          <button class="accordion__header__button btn-plain w-100 js-accordion-trigger c-pointer d-flex middle-xs p-relative zi-1 p-zero m-zero {{ ac_open_css }}" id="acdnTgr-{{ forloop.index }}-{{ section_id }}" aria-expanded="{{ aria_expanded }}" aria-controls="acdnCtt-{{ forloop.index }}-{{ section_id }}">
            {%- unless section.settings.show_icon == false or block.settings.icon == 'none' -%}
              {%- capture accordion_icon -%}
                <span class="custom-icon h-100 w-100 d-block mr-8 mr-sm-12 mr-md-16"></span>
              {%- endcapture -%}
              {%- render 'icon-loader', icon: block.settings.icon, class: 'mr-8 mr-sm-12 mr-md-16' -%}
              {{- custom_icon -}}
            {%- endunless -%}
            <span class="mb-0 fg-1 pr-12 ta-left flex-1"><h3 class="card__heading fw-700 m-zero">{{ block.settings.block_heading | escape }}</h3></span>
            <span class="zi-1 btn btn-large btn-icon">
              {{ icon_chevron_down }}
            </span>
          </button>
        </div>
        <div class="accordion__content d-grid rte js-accordion-content o-hidden ac-{{ forloop.index }}-{{ section_id }} {{ ac_open_css }}" id="acdnCtt-{{ forloop.index }}-{{ section_id }}" role="region" aria-describedby="acdnTgr-{{ forloop.index }}-{{ section_id }}" tabindex="-1" style="{{ styles }}">
            {{- accordion_icon -}}
            <div class="accordion-content">
              {{ block.settings.description }}
              {{ block.settings.page.content }}
            </div>
        </div>
      </div>
    {%- endfor -%}
  </sht-accordion>
  <div class="anm anm-fadeInUpLarge hide-empty d-none-md {{ section.settings.content_alignment }} {{ section.settings.btn_text | default: 'd-none-important' | replace: section.settings.btn_text, '' }}" style="--duration: .7s; --delay: .15s">
    <a class="btn btn-primary btn-large hide-empty" href="{{ section.settings.btn_link | default: '#' }}">
      {{- section.settings.btn_text -}}
    </a>
  </div>

</div>
{%- render 'section-id', section: section -%}
</div>
