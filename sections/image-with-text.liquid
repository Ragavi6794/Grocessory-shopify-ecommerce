{%- liquid

  assign desktop_image = 'image' | placeholder_svg_tag: 'placeholder media media-md d-none d-block-md w-100 h-100 of-cover'
  assign mobile_image = 'image' | placeholder_svg_tag: 'placeholder media d-none-md d-block w-100 h-100 of-cover'

  assign desktop_image_alt  = section.settings.desktop_image.alt | default: section.settings.desktop_image.image | split: '/' | last
  assign desktop_image = section.settings.desktop_image | image_url: width: section.settings.desktop_image.width | image_tag: widths: '375, 550, 750, 950, 1024, 1200, 1400, 1600, 1800, 2000', sizes: "(min-width: 769px) 900px, calc(100vw - 48px)", alt: desktop_image_alt, class: 'd-none d-block-md w-100 h-100 media media-md of-cover'

  assign mobile_image_alt  = section.settings.mobile_image.alt | default: section.settings.mobile_image.image | split: '/' | last
  assign mobile_image = section.settings.mobile_image | image_url: width: section.settings.mobile_image.width | image_tag: widths: '375, 550, 750, 950', sizes: "calc(100vw - 48px)", alt: mobile_image_alt, class: 'd-none-md d-block w-100 h-100 media of-cover'

-%}
{%- liquid
    assign section_style = 's-media-with-text--solid'
    assign page_background_color = settings.page_background | downcase
    assign section_background_color = section.settings.color_scheme.settings.color_background | downcase
    assign container_rounded = 'corner-radius-m corner-radius-zero-mb'
    if page_background_color == section_background_color or section.settings.color_scheme.settings.color_background.alpha == 0.0
        assign section_style = 's-media-with-text--transparent'
        assign media_rounded = 'corner-radius-m'
        assign container_rounded = ''
    endif
-%}

<div class="section section-index--{{section.index |  replace: '1', 'first' }} s-media-with-text color-{{- section.settings.color_scheme }}" data-ui-component="Image With Text Section" role="region" aria-labelledby="sectionHeading-{{ section.id | md5 | truncate: 12, '' }}">
  <div class="ctnr s-media-with-text-ctnr {{ section_style }} {{ container_rounded }} d-grid" style="--gtc-equal-md:2; --mh-md:{{ section.settings.height }};">
    <div class="s-media-with-text__content s-card h-100 background">
      <div class="s-header__content d-flex fd-column center-xs h-100 anm-card js-animate anm" style="--duration: .7s;">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'subheading' -%}
              {%- if block.settings.subheading != blank -%}
                <span class="s-header__subheading d-inline-block fw-700 hide-empty anm anm-fadeInUpLarge" style="--duration: 0.7s; --delay: {{ forloop.index | divided_by: 10.0 }}s;">{{- block.settings.subheading -}}</span>
              {%- endif -%}
            {%- when 'heading' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="s-header__heading {{ block.settings.heading_size }}  anm anm-fadeInUpLarge" style="--duration: 0.7s; --delay: {{ forloop.index | divided_by: 10.0 }}s;" {{ block.shopify_attributes }}>
                  {{- block.settings.heading -}}
                </h2>
              {%- endif -%}
            {%- when 'description' -%}
              {%- if block.settings.description != blank -%}
                <div class="s-header__description  anm anm-fadeInUpLarge" style="--duration: 0.7s; --delay: {{ forloop.index | divided_by: 10.0 }}s;" {{ block.shopify_attributes }}>
                  {{- block.settings.description -}}
                </div>
              {%- endif -%}
            {%- when 'countdown' -%}
              <div class="s-header__countdown countdown-wrapper d-grid w-100  anm anm-fadeInUpLarge" style="--duration: 0.7s; --delay: {{ forloop.index | divided_by: 10.0 }}s;" {{ block.shopify_attributes }}>
                  {%- render 'countdown', block: block -%}
              </div>
            {%- when 'buttons' -%}
              <div class="s-header__buttons d-flex gap-8 fw-wrap anm anm-fadeInUpLarge" style="--duration: 0.7s; --delay: {{ forloop.index | divided_by: 10.0 }}s;" {{ block.shopify_attributes }}>
                {%- if block.settings.button_1_label != blank -%}
                  <a class="btn btn-large {{ block.settings.button_1_style }}" href="{{- block.settings.button_1_link | default: '#' -}}">{{- block.settings.button_1_label -}}</a>
                {%- endif -%}
                {%- if block.settings.button_2_label != blank -%}
                  <a class="btn btn-large {{ block.settings.button_2_style }}" href="{{- block.settings.button_2_link | default: '#' -}}">{{- block.settings.button_2_label -}}</a>
                {%- endif -%}
              </div>
            {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
    <div class="s-media-with-text__media h-100 w-100 p-relative o-hidden {{ media_rounded }} {{ section.settings.content_ordering }}" style="--ratio: {{ section.settings.image_ratio }};--ratio-md:auto;">
      <div class="h-100 w-100 media-wrapper js-animate anm anm-zoomOut anm-card background" style="--duration: .7s;">
        {%- liquid
          if section.settings.mobile_image
            echo mobile_image | replace: "src=", 'data="mobile" loading="lazy" decoding="async" fetchpriority="low" src='
            echo desktop_image | replace: "src=", 'loading="lazy" decoding="async" fetchpriority="low" src='
          else
            echo desktop_image | replace: 'd-none d-block-md', '' | replace: "src=", 'loading="lazy" decoding="async" fetchpriority="low" src='
          endif
        -%}
      </div>
    </div>

  </div>
  {%- render 'section-id', section: section -%}
</div>

{% schema %}
{
  "name": "t:sections.image_with_text.name",
  "disabled_on": {
    "groups": [
