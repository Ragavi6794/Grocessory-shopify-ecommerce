{%- liquid
  assign product_comparison_metafield_keys = section.settings.product_comparison_metafield_keys | downcase | remove: " " | split: ','
  assign row_revealed = section.settings.row_revealed
  assign show_view_more = false
  assign block_size = section.settings.number_of_related_products
  assign carousel = "carousel ox-auto scrollable scrollable-x disable-scrollbars"
  assign carousel_item = "carousel__item"
  assign carousel_style = " --w-xs: 9"
  assign product_id = product.id
  unless section.settings.current_badge_background.alpha == 0.0 or section.settings.current_badge_background == blank
    assign color_card_current = "--color-accent-gradient:" | append: section.settings.current_badge_background
  endunless
  unless section.settings.current_badge_text.alpha == 0.0 or section.settings.current_badge_text == blank
    assign bgc_card_current = "--color-field-bg:" | append: section.settings.current_badge_text
  endunless
-%}

  <div class="section section-index--{{section.index |  replace: '1', 'first' }} {% render 'sections-spacing' %} color-{{- section.settings.color_scheme }}" data-ui-component="Main Product Comparison Section" role="region" aria-labelledby="sectionHeading-{{ section.id | md5 | truncate: 12, "" }}">
    <div class="ctnr background" style="--gutter: 20px">
        {%- render 'section-header',
          content_align: section.settings.content_align,
          subheading: section.settings.subheading,
          heading: section.settings.heading,
          heading_size: section.settings.heading_size,
          description: section.settings.description,
          section: section
        -%}
        <sht-product-comparison class="product-comparison-content s-content js-animate {{ carousel }} d-flex fd-column gap-unequal ">
          <div class="d-flex fd-column gap-unequal">
            <div class="main-pcn__row anm anm-fadeInUpLarge {{ carousel_item }} d-grid c-gap" style="--gtc-equal-md: {{ block_size | plus: 1 }}; {{ carousel_style }}; --block-size: {{ block_size }}; --delay: .15s; --duration: .7s">
              <div>
                {%- render 'product-comparison-info', product: product, sectionID: section.id, productID: product_id, color_card_current: color_card_current, bgc_card_current: bgc_card_current  -%}
              </div>
              <sht-prd-recom class="product-recommendations" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.number_of_related_products }}" style="grid-column: span {{ block_size }}">
                <div class="d-grid c-gap" style="grid-template-columns: repeat({{ block_size }} ,1fr)">
                  {%- for recommendation in recommendations.products -%}
                    {% liquid
                      assign sectionID = section.id
                      assign blockID = forloop.index
                    %}
                    {%- render 'main-product-comparison-info', product: recommendation, sectionID: sectionID, blockID: blockID, productID: product_id -%}
                  {%- endfor -%}
                  </div>
              </sht-prd-recom>
            </div>
            <div class="main-pcn__row anm anm-fadeInUpLarge {{ carousel_item }} d-grid c-gap" style="--gtc-equal-md: {{ block_size | plus: 1 }}; {{ carousel_style }}; --block-size: {{ block_size }}; --delay: .15s; --duration: .7s">
              <div class="pb-12 pb-md-20 wb-break-word" style="--gr-xs: 1; --gc-xs: 1/{{ block_size | plus: 2 }}">
                <span class="h5 p-sticky left-0 ">{{ 'sections.product_comparison.options' | t }}</span>
              </div>
              <div>
                {%- render 'product-comparison-variants', product: product, sectionID: section.id, blockID: blockID -%}
              </div>
              <sht-prd-variants-recom class="product-recommendations" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.number_of_related_products }}" style="grid-column: span {{ block_size }}">
                <div class="d-grid c-gap" style="grid-template-columns: repeat({{ block_size }} ,1fr)">
                  {%- for recommendation in recommendations.products -%}
                    {% liquid
                      assign sectionID = section.id
                      assign blockID = forloop.index
                    %}
                    {%- render 'main-product-comparison-variants', product: recommendation, sectionID: sectionID, blockID: blockID -%}
                  {%- endfor -%}
                </div>
              </sht-prd-variants-recom>
            </div>
            <div class="main-pcn__row anm anm-fadeInUpLarge {{ carousel_item }} d-grid c-gap {{ settings.product_comparison_show_description | default: 'd-none-important' | replace: 'true', '' }}" style="--gtc-equal-md: {{ block_size | plus: 1 }}; {{ carousel_style }}; --block-size: {{ block_size }}; --delay: .15s; --duration: .7s">
              <div class="pb-12 pb-md-20 wb-break-word" style="--gr-xs: 1; --gc-xs: 1/{{ block_size | plus: 2 }}">
                <span class="h5 p-sticky left-0 ">{{ 'sections.product_comparison.descriptions' | t }}</span>
              </div>
              <div>
                {{ product.description }}
              </div>
              <sht-prd-desc-recom class="product-recommendations" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.number_of_related_products }}" style="grid-column: span {{ block_size }}">
                <div class="d-grid c-gap" style="grid-template-columns: repeat({{ block_size }} ,1fr)">
                  {%- for recommendation in recommendations.products -%}
                    <div>
                      {{ recommendation.description }}
                    </div>
                  {%- endfor -%}
                </div>
              </sht-prd-desc-recom>
            </div>
            <sht-prd-spec-recom class="product-recommendations d-flex fd-column gap-unequal" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.number_of_related_products }}">
              {%- if product_comparison_metafield_keys.size > 0 -%}
                {%- for k in product_comparison_metafield_keys -%}
                  {%- liquid
                    assign dislay_cls = ''
                    if forloop.index > row_revealed
                      assign show_view_more = true
                      assign dislay_cls = 'js-product-comparison-hidden-item d-none-important'
                    endif
                    -%}
                  <div class="main-pcn__row anm anm-fadeInUpLarge {{ carousel_item }} d-grid c-gap {{ dislay_cls }}" style="--gtc-equal-md: {{ block_size | plus: 1 }}; {{ carousel_style }}; --block-size: {{ block_size }}; --delay: .2s; --duration: .7s">
                    <div class="pcn__row-title pb-12 pb-md-20 wb-break-word" style="--gr-xs: 1; --gc-xs: 1/{{ block_size | plus: 2 }}">
                      <span class="h5 p-sticky left-0 tt-cap">
                        {{ k | replace: '_', ' ' }}
                      </span>
                    </div>
                    <div>
                      {%- render 'product-compairsion-specifications', product: product, metafield_key: k, product_specifications_style: "--gr-xs: 2;" -%}
                    </div>
                    <div class="d-grid c-gap" style="grid-column: span {{ block_size }}">
                      <div class="d-grid c-gap" style="grid-template-columns: repeat({{ block_size }} ,1fr)">
                        {%- for recommendation in recommendations.products -%}
                          <div>
                            {%- render 'product-compairsion-specifications', product: recommendation, metafield_key: k, product_specifications_style: "--gr-xs: 2;" -%}
                          </div>
                        {%- endfor -%}
                      </div>
                    </div>
                  </div>
                {%- endfor -%}
              {%- endif -%}
            </sht-prd-spec-recom>
            <div class="main-pcn__row anm anm-fadeInUpLarge {{ carousel_item }} d-grid c-gap {{ settings.product_comparison_enable_view_full_details | default: 'd-none-important' | replace: 'true', '' }}" style="--gtc-equal-md: {{ block_size | plus: 1 }}; {{ carousel_style }}; --block-size: {{ block_size }}; --delay: .15s; --duration: .7s">
              <sht-prd-view-recom class="product-recommendations" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.number_of_related_products }}" style="grid-column: 2 / {{ block_size | plus: 2  }}">
                <div class="d-grid c-gap" style="grid-template-columns: repeat({{ block_size }} ,1fr)">
                  {%- for recommendation in recommendations.products -%}
                    <div>
                      <a href="{{- recommendation.url | within: collection | default: '#' -}}" class="btn btn-link btn-small btn-view-details ta-left" aria-label="{{ "products.product.view_full_details" | t }}">
                        {{ 'products.product.view_full_details' | t }}
                        {% render 'icon-arrow-right', size: 16, class: 'ml-8' %}
                      </a>
                    </div>
                  {%- endfor -%}
                </div>
              </sht-prd-view-recom>
            </div>
          </div>
          {%- if show_view_more -%}
            <div class="main-pcn__row anm anm-fadeInUpSmall pt-20 pb-md-8 d-grid c-gap {{ carousel_item }}" style="--gtc-equal-md: {{ block_size }}; {{ carousel_style }}; --block-size: {{ block_size }}; --duration: .7s; --delay: .05s">
              <div class="product-comparison-btn" style="--gr-xs: 1; --gc-xs: 1/{{ block_size | plus: 1 }}">
                <button class="js-product-comparison-view-more-btn left-0 btn btn-large btn-secondary p-sticky" data-view-more="{{ 'sections.product_comparison.view_more' | t }}" data-view-less="{{ 'sections.product_comparison.view_less' | t }}" type="button">
                  <span class="js-product-comparison-view-more-btn-label">{{ 'sections.product_comparison.view_more' | t }}</span>
                  {% render 'icon-chevron-down', size: 24, class: 'icon-chevron-down ml-8' %}
                </button>
              </div>
            </div>
          {%- endif -%}
        </sht-product-comparison>
        <div class="s-header__buttons d-inline-flex gap-12 fw-wrap js-animate anm anm-fadeInUpSmall hide-empty" style="--duration: .7s; --delay: .05s">
          {%- if section.settings.button_1_label != blank -%}
            <a class="btn btn-large {{ section.settings.button_1_style }}" href="{{- section.settings.button_1_link | default: '#' -}}">{{- section.settings.button_1_label | escape -}}</a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank -%}
            <a class="btn btn-large {{ section.settings.button_2_style }}" href="{{- section.settings.button_2_link | default: '#' -}}">{{- section.settings.button_2_label | escape -}}</a>
          {%- endif -%}
        </div>

        </div>
        {%- render 'section-id', section: section -%}
  </div>
{% schema %}
  {
    "name": "t:sections.main_product_comparison.name",
    "disabled_on": {
      "groups": [
        "header",
        "footer"
      ]
    },
    "settings": [
      {
        "type": "paragraph",
        "content": "t:sections.main_product_comparison.settings.paragraph.content"
      },
      {
        "type": "header",
        "content": "t:general.settings.headers.header_general.content"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:general.settings.color_scheme.label",
        "default": "scheme-3"
      },
      {
        "type": "text",
        "id": "subheading",
        "label": "t:general.settings.subheading.label",
        "default": "Add a tagline"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "t:general.settings.heading.label",
        "default": "Product comparison"
      },
      {
        "type": "select",
        "label": "t:general.settings.heading_size.label",
        "id": "heading_size",
        "options": [
          {
            "value": "h2",
            "label": "t:general.settings.heading_size.options.h2.label"
          },
          {
            "value": "h3",
            "label": "t:general.settings.heading_size.options.h3.label"
          },
          {
            "value": "h4",
            "label": "t:general.settings.heading_size.options.h4.label"
          },
          {
            "value": "h5",
            "label": "t:general.settings.heading_size.options.h5.label"
          }
        ],
        "default": "h2"
      },
      {
        "type": "richtext",
        "id": "description",
        "label": "t:general.settings.section_description.label"
      },
      {
        "type": "header",
        "content": "t:general.settings.headers.header_layout.content"
      },
      {
        "type": "select",
        "id": "content_align",
        "label": "t:general.settings.content_alignment.label",
        "default": "ta-left",
        "options": [
          {
            "value": "ta-left",
            "label": "t:general.settings.option_left.label"
          },
          {
            "value": "ta-center",
            "label": "t:general.settings.option_center.label"
          }
        ]
      },
      {
        "type": "header",
        "content": "t:sections.product_comparison.settings.headers.header_table.content",
        "info": "t:general.settings.headers.header_product_specifications.info"
      },
      {
        "type": "select",
        "id": "number_of_related_products",
        "label": "t:sections.main_product_comparison.settings.number_of_related_products.label",
        "info": "t:sections.main_product_comparison.settings.number_of_related_products.info",
        "default": "3",
        "options": [
          {
            "value": "2",
            "label": "2"
          },
          {
            "value": "3",
            "label": "3"
          },
          {
            "value": "4",
            "label": "4"
          }
        ]
      },
      {
        "type": "text",
        "id": "product_comparison_metafield_keys",
        "label": "t:sections.product_comparison.settings.product_comparison_metafield_keys.label",
        "info": "t:sections.product_comparison.settings.product_comparison_metafield_keys.info"
      },
      {
        "type": "range",
        "id": "row_revealed",
        "label": "t:general.settings.metafield_row_revealed.label",
        "min": 1,
        "max": 10,
        "step": 1,
        "default": 5
      },
      {
        "type": "header",
        "content": "t:general.settings.custom_color.label"
      },
      {
        "type": "color",
        "id": "current_badge_background",
        "label": "t:sections.main_product_comparison.settings.current_badge_background.label"
      },
      {
        "type": "color",
        "id": "current_badge_text",
        "label": "t:sections.main_product_comparison.settings.current_badge_text.label"
      }
    ]
  }
  {% endschema %}