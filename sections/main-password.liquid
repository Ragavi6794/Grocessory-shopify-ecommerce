{%- liquid
  assign desktop_background_image_alt  = section.settings.desktop_background_image.alt | default: section.settings.desktop_background_image.image | split: '/' | last
  assign desktop_background_image = section.settings.desktop_background_image | image_url: width: section.settings.desktop_background_image.width | image_tag: widths: '350, 750, 950, 1024, 1200, 1400, 1600, 1800, 2000', sizes: "(min-width: 361px) calc(100vw/2), calc(100vw/3)", alt: desktop_background_image_alt, class: 'd-none d-block-sm w-100 h-100 of-cover'

  assign mobile_background_image_alt  = section.settings.mobile_background_image.alt | default: section.settings.mobile_background_image.image | split: '/' | last
  assign mobile_background_image = section.settings.mobile_background_image | image_url: width: section.settings.mobile_background_image.width | image_tag: widths: '350', sizes: "(min-width: 361px) calc(100vw/2), calc(100vw/3)", alt: mobile_background_image_alt, class: 'd-none-sm d-block w-100 h-100 of-cover'

  if section.settings.mobile_background_image == blank
    assign desktop_background_image = desktop_background_image | replace: 'd-none d-block-sm', ''
  endif

  if section.settings.mobile_background_image or section.settings.desktop_background_image
    unless section.settings.color_mask_overlay.alpha == 0.0 or section.settings.color_mask_overlay == blank
      assign overlay_color = '--color-mask-overlay:' | append: section.settings.color_mask_overlay.red | append: ',' | append: section.settings.color_mask_overlay.green | append: ',' | append: section.settings.color_mask_overlay.blue | append: ';'
    endunless
    unless section.settings.color_text_overlay.alpha == 0.0 or section.settings.color_text_overlay == blank
      assign content_color = 'color:' | append: section.settings.color_text_overlay | append: ';'
    endunless
  endif
-%}
{{ 'password.css' | asset_url | stylesheet_tag: preload: true }}
{% style %}
.logo__width {
  --logo-width-desktop: {{ section.settings.logo_width | append: 'px' }};
  --logo-width-mobile: {{ section.settings.logo_width_mobile | append: 'px' }};
}
{% endstyle %}
<div class=" section s--banner-spacing w-100 ">
  <div class="password-wrapper d-grid ctnr w-100 h-100 color-{{ section.settings.color_scheme }} background">
    <div class="password s-card w-100 zi-1 d-flex fd-column center-xs flex-1 sht-mask" style="--overlay: {{ section.settings.image_overlay_opacity }}; {{ overlay_color }}">
      <div class="password__content s-header__content d-flex fd-column zi-1 w-100 p-relative middle-xs ta-center" style="{{ content_color }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'logo' -%}
              <div class="password__logo s-header__description logo__width of-cover">
                <div class="header-logo js-header-logo" style="--logo-ratio: {{ block.settings.logo.aspect_ratio }};  --logo-width-desktop: {{ block.settings.logo_width | append: 'px' }}; --logo-width-mobile: {{ block.settings.logo_width_mobile | append: 'px' }};">
                  {%- if request.page_type == 'index' or request.page_type == 'password' -%}
                    <h1 class="header__heading h4 m-zero wb-break-word visually-hidden">{ shop.name | escape }}</h1>
                  {%- endif -%}
                    <a href="{{ routes.root_url }}" aria-label="{{ section.settings.logo.alt | default: shop.name | escape }}" class="header__logo-link header__link m-zero js-header-logo-link d-block h4 p-relative wb-break-word ta-left{% if request.page_type == 'password' or  request.page_type == 'gift_card' %} pe-none ta-center{% endif %}">
                      {%- if block.settings.logo != blank -%}
                        {%- assign image_size_2x = block.settings.logo_width | times: 2 | at_most: 5760 -%}
                          <img loading="eager" srcset="{{ block.settings.logo | image_url: width: block.settings.logo_width }}, {{ block.settings.logo | image_url: width: image_size_2x }} 2x" src="{{ block.settings.logo | image_url: width: 400 }}" class="header__logo__img w-100 d-inline-block" width="{{ block.settings.logo.width }}" height="{{ block.settings.logo.height }}" alt="{{ block.settings.logo.alt | default: shop.name | escape }}">
                      {%- else -%}
                        <span class="header__heading m-zero wb-break-word">{{ shop.name }}</span>
                      {%- endif -%}
                    </a>
                </div>
              </div>
            {%- when 'subheading' -%}
              {%- if block.settings.subheading != blank -%}
                <span class="s-header__subheading s-header__sub d-inline-block fw-700 hide-empty">{{- block.settings.subheading -}}</span>
              {%- endif -%}
            {%- when 'heading' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="s-header__heading {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                  {{- block.settings.heading -}}
                </h2>
              {%- endif -%}
            {%- when 'description' -%}
              {%- if block.settings.description != blank -%}
                <div class="s-header__description" {{ block.shopify_attributes }}>
                  {{- block.settings.description -}}
                </div>
              {%- endif -%}
              {%- when 'contactInfo' -%}

                  <div class="password-contact-info s-header__description ta-center">
                    {%- if settings.email_address != blank or settings.phone_number != blank -%}
                      <div class="d-none js-animate anm anm-fadeInUpLarge {{ block.settings.show_contact | replace: 'true', 'd-block' }}" style="--duration: .7s; --delay: .15s;">
                        {% render 'contact', header_style: 'mb-24', contact_class: 'subtext d-inline-flex middle-xs center-xs fw-wrap c-gap-24 r-gap-8' %}
                      </div>
                    {%- endif -%}
                    <div class="password__socials mt-24 d-none js-animate anm anm-fadeInUpLarge {{ block.settings.show_social | replace: 'true', 'd-block' }}" style="--duration: .7s; --delay: .15s;">
                      {% render 'socials', classes: 'center-xs gap-16', button_type: 'btn-secondary' %}
                    </div>
                  </div>

              {%- when 'newsletter' -%}
                <div class="s-header__description w-100 js-animate anm anm-fadeInUpLarge " style="--duration: .7s; --delay: .15s;">
                  {% assign button_label = block.settings.button_text | default: 'Subscribe' %}
                  {% render 'newsletter-form', form_id: 'mainPassword', form_name: 'mainPassword', button_label: button_label, button_style: block.settings.button_style %}
                </div>
          {%- endcase -%}
        {%- endfor -%}
        {%- if shop.password_message != blank -%}
          <div class="mt-24 mt-lg-8">
            {{ shop.password_message }}
          </div>
        {%- endif -%}

    </div>
    {% if section.settings.mobile_background_image or section.settings.desktop_background_image %}
      <div class="p-absolute left-0 w-100 h-100">
          <div class="d-block w-100 h-100 js-animate anm anm-zoomOut">
            {%- liquid
              echo desktop_background_image | replace: "src=", 'loading="lazy" decoding="async" fetchpriority="low" src='
              if section.settings.mobile_background_image
                echo mobile_background_image | replace: "src=", 'data="mobile" loading="lazy" decoding="async" fetchpriority="low" src='
              endif
            -%}
          </div>
      </div>
    {% endif %}
  </div>
  <div class="password__footer subtext d-flex fd-column center-xs w-100 pt-16 pl-16 pr-16 pb-16 between-lg middle-xs fd-row-lg zi-3 background">
    {%- capture shopify_link -%}
      <a class="d-flex middle-xs ml-4" href="//www.shopify.com" rel="nofollow" target="_blank" aria-describedby="a11y-new-window-message" aria-label="Shopify">
        {%- render 'icon-shopify', class: 'ml-8' %}
      </a>
    {%- endcapture -%}
    <div class="password__footer-left d-flex middle-xs center-xs mb-4">
      {{ 'general.password_page.powered_by_shopify_html' | t: shopify: shopify_link }}
    </div>

    <div class="password__admin-link d-flex fd-column middle-xs center-xs fd-row-lg">
      <sht-password-modal class="password__admin-login d-flex mb-4">
        <details class="password-modal">
          <summary class="modal__toggle ls-none d-flex" aria-haspopup="dialog">
            <button class="btn btn-link modal__toggle-open subtext d-flex middle-xs td-underline">
              {%- render 'icon-lock', class: 'mr-8' -%}
              {{ 'general.password_page.login_password_button' | t }}
            </button>
          </summary>
          <div class="modal__content zi-2 modal js-password-modal-content p-fixed w-100v h-100v left-0 top-0 hidden-xs opacity-0 d-flex middle-xs ta-center center-xs js-modal"
          role="dialog"
          aria-labelledby="dialogPasswordHeading"
          aria-modal="true"
          >
            <div class="password-modal__content js-password-modal-container dialog color-{{ settings.color_scheme_drawer_popover }}" tabindex="-1">
              <div class="modal-dialog__content__header dialog__header d-flex between-xs middle-xs">
                <h5 class="h4 ta-left m-zero" id="dialogPasswordHeading" data-type="modal-title">
                  {{ 'general.password_page.login_form_heading' | t }}
                </h5>
                <button aria-label="{{ 'accessibility.close' | t }}" type="button" class="dialog__btn btn bg-transparent js-modal-btn-close ml-12" data-dismiss="modal">
                  {%- render 'icon-close' -%}
                </button>
              </div>
              <div class="modal-dialog__body dialog__body">
                {%- form 'storefront_password', class: 'password_form mb-24', id: 'modal-password' -%}
                  {%- if form.errors -%}
                    <p class="d-flex middle-xs center-xs">
                      <span class="icon icon--small icon--error fs-0 mr-8">
                        {%- render 'icon-error', size: 16 -%}
                      </span>
                      <span class="subtext">
                        {{ form.errors.messages['form'] }}
                      </span>
                    </p>
                  {%- endif -%}
                  <div class="form__group d-flex fd-column fd-row-sm gap-16 layout-form">
                    <input id="mainPasswordInput" type="password" class="field__text field--focus field--hover w-100" name="password"
                    {% if form.errors %}
                      aria-invalid="true"
                      aria-describedby="PasswordLoginForm-password-error"
                    {%- endif -%}
                      placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
                      aria-label="{{ 'general.password_page.login_form_password_placeholder' | t }}"
                      autofocus
                      required
                    >
                    <label class="field__label visually-hidden" for="mainPasswordInput">{{ 'general.password_page.your_password' | t }}</label>
                    <button aria-label="{{ 'general.password_page.login_form_submit' | t }}" type="submit" name="commit" class="btn btn-primary btn-large fs-0">
                      {{ 'general.password_page.login_form_submit' | t }}
                    </button>
                  </div>
                {%- endform -%}
                <span class="password__footer-text subtext">
                  {{ "general.password_page.admin_link_html" | t }}
                  <a href="/admin" class="btn btn-link btn-small ml-4">{{ 'general.password_page.admin_link_login' | t }}</a>
                </span>
              </div>
            </div>
          </div>
        </details>
      </sht-password-modal>
      <span class="password__admin-account">
        {{ 'general.password_page.admin_link_html' | t }}
        <a href="/admin" class="btn btn-link ml-4">{{ 'general.password_page.admin_link_login' | t }}</a>
      </span>
    </div>
  </div>
  </div>
</div>
{%- liquid
  assign files = "component-password.js" | split: ', '
  render 'js-loader', files: files
-%}
<ul hidden>
  <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
</ul>
{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.headers.header_general.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.settings.color_scheme.label",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "unit": "%",
      "max": 90,
      "min": 0,
      "step": 1,
      "default": 30,
      "id": "image_overlay_opacity",
      "label": "t:general.settings.overlay_opacity.label"
    },
    {
      "type": "color",
      "id": "color_mask_overlay",
      "label": "t:general.settings.custom_mask_overlay.label",
      "info": "t:general.settings.overlay_opacity.info"
    },
    {
      "type": "color",
      "id": "color_text_overlay",
      "label": "t:general.settings.custom_text_overlay.label",
      "info": "t:general.settings.overlay_opacity.info"
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.header_image.content"
    },
    {
      "type": "image_picker",
      "id": "desktop_background_image",
      "label": "t:general.settings.background_image.label",
      "info": "t:general.settings.image_recommend.info"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "t:general.settings.mobile_background_image.label",
      "info": "t:general.settings.image_recommend_mobile.info"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "t:general.settings.headers.header_logo.content",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "t:general.settings.headers.header_logo.content"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "t:general.settings.logo_image.label",
          "info": "t:general.settings.logo_image.info"
        },
        {
          "type": "range",
          "id": "logo_width",
          "label": "t:general.settings.logo_width_desktop.label",
          "min": 40,
          "max": 200,
          "step": 5,
          "default": 140,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "logo_width_mobile",
          "label": "t:general.settings.logo_width_mobile.label",
          "min": 40,
          "max": 140,
          "step": 5,
          "default": 70,
          "unit": "px"
        }
      ]
    },
    {
      "type": "subheading",
      "name": "t:general.settings.subheading.label",
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "label": "t:general.settings.text.label",
          "default": "Come with us"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:general.settings.heading.label",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:general.settings.text.label",
          "default": "Opening soon"
        },
        {
          "type": "select",
          "label": "t:general.settings.text_size.label",
          "id": "heading_size",
          "options": [
            {
              "value": "headline",
              "label": "t:general.settings.heading_size.options.headline.label"
            },
            {
              "value": "h1",
              "label": "t:general.settings.heading_size.options.h1.label"
            },
            {
              "value": "h2",
              "label": "t:general.settings.heading_size.options.h2.label"
            },
            {
              "value": "h3",
              "label": "t:general.settings.heading_size.options.h3.label"
            }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "description",
      "name": "t:general.settings.description.label",
      "settings": [
        {
          "type": "richtext",
          "id": "description",
          "label": "t:general.settings.text.label",
          "default": "<p>Be the first to know about our new collections and exclusive offers</p>"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.popup.blocks.newsletter.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.popup.blocks.newsletter.settings.paragraph_one.content"
        },
        {
          "type": "text",
          "id": "button_text",
          "default": "Notify me",
          "label": "t:general.settings.submit_button_text.label"
        },
        {
          "type": "select",
          "id": "button_style",
          "default": "btn-primary",
          "options": [
            {
              "value": "btn-primary",
              "label": "t:general.settings.primary.label"
            },
            {
              "value": "btn-secondary",
              "label": "t:general.settings.secondary.label"
            },
            {
              "value": "btn-link",
              "label": "t:general.settings.tertiary.label"
            }
          ],
          "label": "t:general.settings.submit_button_style.label"
        }
      ]
    },
    {
      "type": "contactInfo",
      "name": "t:general.settings.headers.header_contact_information.content",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:general.settings.headers.header_contact_information.info"
        },
        {
          "type": "checkbox",
          "id": "show_contact",
          "label": "t:general.settings.enable_contact.label",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "t:general.settings.enable_social.label",
          "default": true
        }
      ]
    }
  ]
}
{% endschema %}

