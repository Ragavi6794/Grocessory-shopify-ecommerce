<script type="text/javascript">
        document.getElementsByName("customer[first_name]")[0].value = getSavedValue("customer[first_name]");    // set the value to this input
        document.getElementsByName("customer[last_name]")[0].value = getSavedValue("customer[last_name]");
        document.getElementsByName("customer[email]")[0].value = getSavedValue("customer[email]");
        document.getElementsByName("customer[password]")[0].value= getSavedValue("customer[password]");
        document.getElementsByName("customer[mobileNumbersRegister]")[0].value = getSavedValue("customer[mobileNumbersRegister]");// set the value to this input
        
        function saveValue(e){
            var id = e.name;  
            var val = e.value; 
            localStorage.setItem(id, val);
        }

         
        function getSavedValue  (v){
            if (!localStorage.getItem(v)) {
                return "";
            }
            return localStorage.getItem(v);
        }
</script>
