<div id="sotp-widget" class="sotp-widget otp-loader">&nbsp;</div>
<img style="width: 1px;height: 1px;" width="1" height="1" src="data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==" />

{% comment %}
<script src="http://ajax.googleapis.com/ajax/libs/jquery/1.7.1/jquery.min.js" type="text/javascript"></script>
<script src="{{ 'mo-verify.js' | asset_url }}"></script>

<div class="section section-index--{{section.index |  replace: '1', 'first' }} {% render 'sections-spacing' %} color-{{ section.settings.color_scheme }}">
  <div class="ctnr background">
    <div class="rw">
      <div class="clm m-auto" style="--w-xs:12;--w-sm:8;--w-md:6">
        <div class="s-header ta-center">
          <h1 class="m-zero h2" tabindex="-1">{{ 'customer.register.title' | t }}</h1>
        </div>
        <div class="s-content">
          {% form 'create_customer' %}
            {%- if form.errors -%}
              <div class="d-flex middle-xs center-xs mb-32 outline-zero" tabindex="-1" autofocus>
                <div class="icon icon--default icon--error mr-8" focusable="false" role="presentation">
                  {% render 'icon-error', size: 16 %}
                </div>
                <div class="ml-8 flex-1">
                  <h6>
                    {{ 'templates.contact.form.error_heading' | t }}
                  </h6>
                  <ul class="ls-none mt-8">
                    {%- for field in form.errors -%}
                      <li>
                        {%- if field == 'form' -%}
                          {{ form.errors.messages[field] }}
                        {%- else -%}
                          <a href="#RegisterForm-{{ field }}">
                            {{ form.errors.translated_fields[field] | capitalize }}
                            {{ form.errors.messages[field] }}
                          </a>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            {%- endif -%}
            <div class="mb-24">
              <label for="RegisterForm-FirstName" class="field__label fw-700 d-block mb-8">
                {{ 'customer.register.first_name' | t }}
              </label>
              <input
                type="text"
                name="customer[first_name]"
                id="RegisterForm-FirstName"
                class="field__text field--focus field--hover{% if form.errors contains 'first_name' %} field--error{% endif %} w-100"
                {% if form.first_name %}
                  value="{{ form.first_name }}"
                {% endif %}
                autocomplete="given-name"
                placeholder="{{ 'customer.placeholder.first_name' | t }}"
              >
            </div>
            <div class="mb-24">
              <label for="RegisterForm-LastName" class="field__label fw-700 d-block mb-8">
                {{ 'customer.register.last_name' | t }}
              </label>
              <input
                type="text"
                name="customer[last_name]"
                id="RegisterForm-LastName"
                class="field__text field--focus field--hover{% if form.errors contains 'last_name' %} field--error{% endif %} w-100"
                {% if form.last_name %}
                  value="{{ form.last_name }}"
                {% endif %}
                autocomplete="family-name"
                placeholder="{{ 'customer.placeholder.last_name' | t }}"
              >
            </div>
            <div class="mb-24">
              <label for="RegisterForm-email" class="field__label fw-700 p-relative d-block mb-8">
                {{ 'customer.register.email' | t -}}
                <sup class="p-absolute ml-4 color-error">*</sup>
              </label>
              <input
                type="email"
                name="customer[email]"
                id="RegisterForm-email"
                class="field__text field--focus field--hover{% if form.errors contains 'email' %} field--error{% endif %} w-100"
                {% if form.email %}
                  value="{{ form.email }}"
                {% endif %}
                spellcheck="false"
                autocapitalize="off"
                autocomplete="email"
                aria-required="true"
                required="required"
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="RegisterForm-email-error"
                {% endif %}
                placeholder="{{ 'customer.placeholder.email' | t }}"
              >
              {% if form.errors contains 'email' -%}
                <span class="d-block mt-8 color-error">
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}.
                </span>
              {%- endif -%}
            </div>
            <div class="mb-24">
              <label for="RegisterForm-password" class="field__label fw-700 p-relative d-block mb-8">
                {{ 'customer.register.password' | t -}}
                <sup class="p-absolute ml-4 color-error">*</sup>
              </label>
              <input
                type="password"
                name="customer[password]"
                id="RegisterForm-password"
                class="field__text field--focus field--hover{% if form.errors contains 'password' %} field--error{% endif %} w-100"
                aria-required="true"
                required="required"
                {% if form.errors contains 'password' %}
                  aria-invalid="true"
                  aria-describedby="RegisterForm-password-error"
                {% endif %}
                placeholder="{{ 'customer.placeholder.password' | t }}"
              >
              {% if form.errors contains 'password' -%}
                <span class="d-block mt-8 color-error">
                  {{ form.errors.translated_fields.password | capitalize }}
                  {{ form.errors.messages.password }}.
                </span>
              {%- endif -%}
            </div>
            <div class="d-flex middle-md between-md fd-column-reverse fd-row-md mt-32 gap-12">
              <a href="{{ routes.account_login_url }}" class="btn btn-link btn-large">{{ 'customer.log_in_instead' | t }}</a>
              <button class="btn btn-large btn-primary">
                {{ 'customer.register.button' | t }}
              </button>
            </div>
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
</div>


{% if customer %}
  <div class="alert alert-success">
    <p>Successfully signed up! Welcome, {{ customer.first_name }}.</p>
  </div>
  {% endif %}
{% comment %}miniOrange Script starts{% endcomment %}
<script>
function getFormByAction() {
  // Get all form elements
  var forms = document.getElementsByTagName("form");
  // Loop through forms
  for (var i = 0; i < forms.length; i++) {
    // Check if current form's action attribute matches the given action
    if (forms[i].getAttribute("action") === "/account") {
      return forms[i].getAttribute("id"); // Return the form if found
    } else if (
      forms[i].getAttribute("action") ===
      "https://store.xecurify.com/moas/rest/shopify/api/auth/register/verifyOtp2fa"
    ) {
      return forms[i].getAttribute("id"); // Return the form if found
    }
  }
  return null; // Return null if form not found
}


