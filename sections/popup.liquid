<style>
  .popup--center {
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  position: fixed;
  margin: 0 auto;
  height:fit-content;  
}
.popup-mainheading{
  font-size:31px;
  font-weight:800;
  padding:0;
}
  .popup-subheading{
    font-size:16px;
    font-weight:300;
    margin-bottom:0;
  }
  .popup__countdown.countdown-wrapper.d-grid {
    width: 126px;
}
</style>
 <style>
    /* Overlay styling */
    #popup-overlay {
      position: fixed;
      top: 0; left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(0, 0, 0, 0.6);
      z-index: 100;
      pointer-events: auto;

      display:none;
    }

    /* Hide overlay by default */
    /* #popup-overlay[style*="display:none"] {
      display: none !important;
    } */

    /* Prevent background scroll when popup open */
    body.popup-open {
      overflow: hidden;
    }
  </style>


<script>
  document.addEventListener('DOMContentLoaded', function () {
    {% if customer %}
      const customerId = {{ customer.id }};
      const popupKey = 'popup_shown_' + customerId;

      if (!localStorage.getItem(popupKey)) {
        // Show the popup
        const popup = document.querySelector('.section-popup');
        if (popup) {
          popup.classList.remove('hidden-xs'); // unhide popup
        }

        // Set key so it doesn't show again
        localStorage.setItem(popupKey, 'true');
      } else {
        // Hide it just in case
        const popup = document.querySelector('.section-popup');
        if (popup) {
          popup.classList.add('hidden-xs');
        }
      }
    {% endif %}
  });



</script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const overlay = document.getElementById("popup-overlay");
    const popup = document.querySelector(".section-popup");
    const closeBtns = document.querySelectorAll(".js-popup-close-btn");

    // Always show popup + overlay on every page load
    if (popup && overlay) {
      popup.style.display = "block";
      overlay.style.display = "block";
      document.body.classList.add("popup-open");
    }

    // Close popup + overlay on button click
    closeBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        if (popup && overlay) {
          popup.style.display = "none";
          overlay.style.display = "none";
          document.body.classList.remove("popup-open");
        }
      });
    });
  });
</script>