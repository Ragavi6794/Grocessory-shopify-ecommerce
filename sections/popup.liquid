{%- liquid
  assign popup_visible = false
  assign popup_visible_on = section.settings.popup_visible_on
  assign page_type = request.page_type
  if popup_visible_on == 'all' or popup_visible_on == page_type
    assign popup_visible = true
  endif

-%}
{%- if section.settings.show_popup and popup_visible -%}
  {%- liquid
    assign media_alt = section.settings.image.alt | default: section.settings.image.image | split: '/' | last
    assign popup_sticky_position = section.settings.popup_position | replace: '--', '-sticky--'
    assign section_id = section.id | md5 | truncate: 12, ""
    assign frm_id = section_id | prepend: 'newsletterPopupForm-'
  -%}
 
  
  <div class="section-popup p-fixed zi-8 hidden-xs {{ section.settings.popup_position }} color-{{ section.settings.color_scheme }} background corner-radius-m" style="z-index: 100;">
    <sht-popup class="popup w-100 d-block p-relative zi-6 no-js-hidden no-focus-visible"
      data-props='{"triggerOn":"{{ section.settings.trigger }}", "showSticky": {{ section.settings.enable_sticky_popup }}, "delayTime": {{ section.settings.delay_time }}}'
      tabindex="-1"
      data-ui-component="Popup Section">

      {%- comment -%} Close Button {%- endcomment -%}
      <button class="btn-popup--close js-popup-close-btn"
              type="button"
              aria-label="{{ 'accessibility.close_popup' | t }}"
              style="position: absolute; top: 10px; right: 10px; z-index: 99; background: none; border: none; padding: 10px; cursor: pointer;">
        {%- render 'icon-close' -%}
      </button>

      {%- comment -%} Background Image {%- endcomment -%}
      {% if section.settings.image %}
        <div class="popup-image-background"
             style="pointer-events: none; background-image: url({{ section.settings.image | image_url: width: 1500 }}); background-size: cover; background-position: center; position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; opacity: 0.3;">
        </div>
      {% endif %}

      {%- comment -%} Content {%- endcomment -%}
      <div class="p-20 popup-content s-header__content" style="position: relative; z-index: 1;" {{ section.blocks.size | replace: '0', 'hidden' }}>
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
+              {% render block %}
            {%- when 'subheading' -%}
              <span class="s-header__subheading d-inline-block fw-700 popup-subheading">{{ block.settings.subheading }}</span>
            {%- when 'heading' -%}
              <h2 class="s-header__heading popup-mainheading {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                {{ block.settings.heading }}
              </h2>
            {%- when 'description' -%}
              <div class="s-header__description" {{ block.shopify_attributes }}>
                {{ block.settings.description }}
              </div>
            {%- when 'countdown' -%}
              <div class="popup__countdown countdown-wrapper d-grid" {{ block.shopify_attributes }}>
                {%- if block.settings.enable_countdown_timer -%}
                  {%- render 'countdown', block: block -%}
                {%- endif -%}
                <a class="btn {{ block.settings.button_style }} btn-large w-100 hide-empty" href="{{ block.settings.button_link }}">{{ block.settings.button_text }}</a>
              </div>
            {%- when 'newsletter' -%}
              <div class="popup-newsletter" {{ block.shopify_attributes }}>
                {% liquid
                  assign button_label = block.settings.button_text
                  if button_label == ''
                    assign button_label = 'Subscribe'
                  endif
                %}
                {%- render 'newsletter-form', form_name: 'contactPopup', form_id: frm_id, classes: 'fd-column-sm gap-1x', button_style: block.settings.button_style, button_label: button_label -%}
              </div>
{%- when 'coupon' -%}
  <div class="popup-coupon" style="display: flex; align-items: center; justify-content: start; gap: 0.5rem;" {{ block.shopify_attributes }}>
    <span style="font-weight: 600;">{{ block.settings.coupon_label }}</span>
    <div style="font-size: 1.2rem; font-weight: bold;">
      {{ block.settings.coupon_code }}
    </div>
  </div>

  {%- endcase -%}
        {%- endfor -%}
      </div>
    </sht-popup>
  </div>

  {%- if section.settings.enable_sticky_popup and section.settings.sticky_label != blank -%}
    <sht-sticky-popup class="popup-sticky zi-2 popup-sticky-hide p-fixed gap-1x corner-radius-m {{ popup_sticky_position }} color-{{ section.settings.color_scheme }} background">
      <button class="button-reopen-popup js-sticky-popup-reopen-btn btn-plain {{ section.settings.sticky_heading_size }} m-zero p-zero ta-left c-pointer pl-20 pr-20 pt-12 pb-12">{{ section.settings.sticky_label }}</button>
      <button class="button-close-sticky-popup js-sticky-popup-close-btn btn btn-small btn-secondary btn-icon icon"
              type="button"
              style="position: relative; z-index: 99;"
              aria-label="{{ 'accessibility.close_popup' | t }}">
        {%- render 'icon-close' -%}
      </button>
    </sht-sticky-popup>
  {%- endif -%}
  </div>
<!-- Separate JavaScript -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const overlay = document.getElementById("popup-overlay");
    const popup = document.querySelector(".section-popup");
    const closeBtns = document.querySelectorAll(".js-popup-close-btn");


  // setTimeout(()=>{
  //   overlay.style.display="block";
  // },10000)
    
  setTimeout(()=>{
    overlay.style.display="none";
  },8000)
    

  
    // Close popup + overlay on button click
    closeBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        if (popup && overlay) {
          popup.style.display = "none";
          overlay.style.display = "none";
          document.body.classList.remove("popup-open");
        }
      });
    });
  });
</script>

{%- endif -%}


