@media (max-width: 768px) {   
  body:has(#menuDrawer.active) .product__info.sticky-atc {
    transform: translateY(100%);
    opacity: 0;
    pointer-events: none;
  }
.product__info.sticky-atc {
    transition: transform 0.35s ease, opacity 0.25s ease;
    position: fixed;
    width: 100%;
    margin: auto;
    display: flex;
    justify-content: center;
    background: #F9F6F7;
    z-index: 10;
    height: 5.8em;        
    bottom: 0;    
    left: 0;
    border-radius: 10px;
}
.product__info.sticky-atc .js-sticky-product-info {
    padding: 1em 0;
    width: 90%;
}
.product__info .expandable-content[data-expanded] {
    max-height: 75px;
    transition: max-height .2s ease-in-out;
}
}
.product__info .expandable-content[data-expanded=true]+.expandable-content__btn {
    display: block !important;
    position: relative;
    top: 1em;
}

.product__info .expandable-content__btn:before {
  height: 10px;
}
