<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

<script>
/**
 * Dubai Delivery Timeslot Calculator
 * Uses shop.metafields.custom.timeslot_details
 * Calculates next available delivery slot based on cutoff_hours
 */
$(document).ready(function() {
  
  // Get current time in Dubai timezone (GST = UTC+4)
  // Method: Get UTC time, then add Dubai offset (+4 hours)
  const browserNow = new Date();
  const utcTime = browserNow.getTime() + (browserNow.getTimezoneOffset() * 60000);
  const dubaiOffset = 4 * 60 * 60 * 1000; // Dubai is UTC+4 (4 hours in milliseconds)
  const now = new Date(utcTime + dubaiOffset);
  
  console.log('Browser time:', browserNow);
  console.log('UTC time:', new Date(utcTime));
  console.log('Dubai time (UTC+4):', now);
  console.log('Dubai formatted:', now.toLocaleString('en-US', { 
    weekday: 'short',
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hour12: true
  }));
  
  // Get timeslot data from metafield (Dubai only)
  // Parse as string since json filter is not allowed
  const timeslotDataStr = '{{ shop.metafields.custom.timeslot_details }}';
  let timeslotData = {};
  let dubaiSchedule = {};
  
  try {
    timeslotData = JSON.parse(timeslotDataStr);
    dubaiSchedule = timeslotData?.locations?.Dubai?.schedule || {};
    console.log('✅ Metafield parsed successfully');
    console.log('Dubai schedule:', dubaiSchedule);
  } catch (e) {
    console.error('❌ Failed to parse metafield:', e);
    console.log('Raw metafield string:', timeslotDataStr);
  }
  
  // Day mapping (0=Sunday, 1=Monday, etc.)
  const dayNames = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'];
  
  /**
   * Parse time string like "10am" or "1pm" to 24-hour format
   * @param {string} timeStr - Time string (e.g., "10am", "1pm")
   * @returns {number} Hour in 24-hour format
   */
  function parseTime(timeStr) {
    timeStr = timeStr.trim().toLowerCase();
    const isPM = timeStr.includes('pm');
    const isAM = timeStr.includes('am');
    
    let numStr = timeStr.replace(/[apm\s]/g, '');
    let hour = parseInt(numStr);
    
    if (isPM && hour !== 12) {
      hour += 12;
    } else if (isAM && hour === 12) {
      hour = 0;
    }
    
    return hour;
  }
  
  /**
   * Format time slot for display (e.g., "10AM-1PM")
   * @param {string} slotStr - Slot string (e.g., "10am - 1pm")
   * @returns {string} Formatted slot
   */
  function formatSlotDisplay(slotStr) {
    const [start, end] = slotStr.split('-').map(s => s.trim().toUpperCase());
    return `${start}-${end}`;
  }
  
  /**
   * Format date for display (e.g., "Mon 09 (Dec)")
   * @param {Date} date - Date object
   * @returns {string} Formatted date
   */
  function formatDate(date) {
    const options = { month: 'short', weekday: 'short', day: '2-digit' };
    const formatted = new Intl.DateTimeFormat('en-GB', options).format(date);
    const parts = formatted.split(' ');
    return `${parts[1]} ${parts[2]} (${parts[0].replace(',', '')})`;
  }
  
  /**
   * Check if a slot is still available based on cutoff hours
   * @param {number} slotStartHour - Hour when slot starts (24-hour format)
   * @param {number} cutoffHours - Hours before slot start when orders close
   * @param {Date} currentDate - Current date/time
   * @param {Date} slotDate - Date of the delivery slot
   * @returns {boolean} True if slot is still available
   */
  function isSlotAvailable(slotStartHour, cutoffHours, currentDate, slotDate) {
    // Calculate cutoff time (slot start time minus cutoff hours)
    const cutoffTime = new Date(slotDate);
    cutoffTime.setHours(slotStartHour, 0, 0, 0);
    
    // Subtract cutoff hours (handles negative hours automatically)
    cutoffTime.setHours(cutoffTime.getHours() - cutoffHours);
    
    return currentDate <= cutoffTime;
  }
  
  /**
   * Get next available delivery slot for Dubai
   * @returns {Object|null} Object with date, slot, and cutoffHours or null
   */
  function getNextDeliverySlot() {
    const currentDay = now.getDay();
    
    console.log('=== SLOT SEARCH DEBUG ===');
    console.log('Current time:', now);
    console.log('Current day index:', currentDay);
    console.log('Current day name:', dayNames[currentDay]);
    console.log('Dubai schedule:', dubaiSchedule);
    
    // Check today first
    const todayName = dayNames[currentDay];
    const todaySlots = dubaiSchedule[todayName] || [];
    
    console.log(`Checking today (${todayName}):`, todaySlots);
    
    for (const slot of todaySlots) {
      const [startTime] = slot.slot.split('-');
      const slotStartHour = parseTime(startTime);
      
      // Calculate cutoff for debugging
      const cutoffTime = new Date(now);
      cutoffTime.setHours(slotStartHour, 0, 0, 0);
      cutoffTime.setHours(cutoffTime.getHours() - slot.cutoff_hours);
      
      console.log(`  Slot: ${slot.slot}, Start: ${slotStartHour}:00, Cutoff: ${slot.cutoff_hours}h`);
      console.log(`  Cutoff time: ${cutoffTime}`);
      console.log(`  Available: ${now <= cutoffTime}`);
      
      if (isSlotAvailable(slotStartHour, slot.cutoff_hours, now, now)) {
        console.log(`  ✅ FOUND TODAY'S SLOT: ${slot.slot}`);
        return {
          date: now,
          slot: slot.slot,
          cutoffHours: slot.cutoff_hours
        };
      }
    }
    
    console.log('No slots available today, checking next 7 days...');
    
    // Check next 7 days
    for (let i = 1; i <= 7; i++) {
      const checkDate = new Date(now);
      checkDate.setDate(checkDate.getDate() + i);
      const checkDayIndex = checkDate.getDay();
      const checkDayName = dayNames[checkDayIndex];
      
      const daySlots = dubaiSchedule[checkDayName] || [];
      
      console.log(`Checking ${checkDayName} (+${i} days):`, daySlots);
      
      // Check each slot to find first available one
      for (const slot of daySlots) {
        const [startTime] = slot.slot.split('-');
        const slotStartHour = parseTime(startTime);
        
        // Calculate cutoff for debugging
        const cutoffTime = new Date(checkDate);
        cutoffTime.setHours(slotStartHour, 0, 0, 0);
        cutoffTime.setHours(cutoffTime.getHours() - slot.cutoff_hours);
        
        console.log(`  Slot: ${slot.slot}, Start: ${slotStartHour}:00, Cutoff: ${slot.cutoff_hours}h`);
        console.log(`  Slot date: ${checkDate}`);
        console.log(`  Cutoff time: ${cutoffTime}`);
        console.log(`  Available: ${now <= cutoffTime}`);
        
        if (isSlotAvailable(slotStartHour, slot.cutoff_hours, now, checkDate)) {
          console.log(`  ✅ FOUND SLOT: ${slot.slot} on ${checkDayName}`);
          return {
            date: checkDate,
            slot: slot.slot,
            cutoffHours: slot.cutoff_hours
          };
        }
      }
    }
    
    console.log('❌ NO SLOTS FOUND IN NEXT 7 DAYS');
    return null;
  }
  
  /**
   * Calculate time left until cutoff for next slot
   * @param {Object} nextSlot - Next slot object
   * @param {Date} currentTime - Current time to calculate from
   * @returns {Object} Object with countdown string and time components
   */
  function getTimeLeftForNextSlot(nextSlot, currentTime) {
    if (!nextSlot) return { countdown: "00:00:00", isPassed: true };
    
    const [startTime] = nextSlot.slot.split('-');
    const slotStartHour = parseTime(startTime);
    
    // Calculate cutoff time
    const cutoffTime = new Date(nextSlot.date);
    cutoffTime.setHours(slotStartHour - nextSlot.cutoffHours, 0, 0, 0);
    
    // Calculate time difference
    const timeDiff = cutoffTime - currentTime;
    
    if (timeDiff <= 0) return { countdown: "00:00:00", isPassed: true };
    
    const totalSeconds = Math.floor(timeDiff / 1000);
    const hours = Math.floor(totalSeconds / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    const seconds = totalSeconds % 60;
    
    // Format as HH:MM:SS
    const formattedHours = String(hours).padStart(2, '0');
    const formattedMinutes = String(minutes).padStart(2, '0');
    const formattedSeconds = String(seconds).padStart(2, '0');
    
    return {
      countdown: `${formattedHours}:${formattedMinutes}:${formattedSeconds}`,
      isPassed: false,
      hours: hours,
      minutes: minutes,
      seconds: seconds
    };
  }
  
  /**
   * Get current Dubai time
   * @returns {Date} Current time in Dubai timezone
   */
  function getCurrentDubaiTime() {
    const browserNow = new Date();
    const utcTime = browserNow.getTime() + (browserNow.getTimezoneOffset() * 60000);
    const dubaiOffset = 4 * 60 * 60 * 1000; // Dubai is UTC+4
    return new Date(utcTime + dubaiOffset);
  }
  
  /**
   * Render delivery information in the DOM
   */
  function renderDeliveryInfo() {
    const nextSlot = getNextDeliverySlot();
    
    if (!nextSlot) {
      $("#delivery-message").text("No delivery slots available");
      $("#delivery-countdown").text("00:00:00");
      console.error('No delivery slots found!');
      return;
    }
    
    const formattedDate = formatDate(nextSlot.date);
    const formattedSlot = formatSlotDisplay(nextSlot.slot);
    
    // Determine if delivery is today or tomorrow
    const currentDubaiTime = getCurrentDubaiTime();
    const deliveryDate = new Date(nextSlot.date);
    const isToday = deliveryDate.toDateString() === currentDubaiTime.toDateString();
    
    const tomorrow = new Date(currentDubaiTime);
    tomorrow.setDate(tomorrow.getDate() + 1);
    const isTomorrow = deliveryDate.toDateString() === tomorrow.toDateString();
    
    let deliveryTimeText = '';
    if (isToday) {
      deliveryTimeText = 'today';
    } else if (isTomorrow) {
      deliveryTimeText = 'tomorrow';
    } else {
      deliveryTimeText = `on ${formattedDate}`;
    }
    
    // Set delivery message
    const deliveryMessage = `Get it ${deliveryTimeText} in Dubai — order within`;
    $("#delivery-message").text(deliveryMessage);
    
    console.log('Dubai Delivery Info:', {
      nextSlot: nextSlot,
      formattedDate: formattedDate,
      formattedSlot: formattedSlot,
      deliveryTimeText: deliveryTimeText,
      cutoffCalculation: {
        slotDate: nextSlot.date,
        slotTime: nextSlot.slot,
        cutoffHours: nextSlot.cutoffHours
      }
    });
    
    // Update countdown timer every second
    function updateCountdown() {
      const currentDubaiTime = getCurrentDubaiTime();
      
      // Update Dubai current time display
      const dubaiTimeStr = currentDubaiTime.toLocaleString('en-US', { 
        weekday: 'short',
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: true
      });
      $("#dubai-current-time").text(dubaiTimeStr);
      
      // Update countdown
      const timeData = getTimeLeftForNextSlot(nextSlot, currentDubaiTime);
      $("#delivery-countdown").text(timeData.countdown);
      
      // If cutoff passed, refresh to find next slot
      if (timeData.isPassed) {
        console.log('Cutoff passed, refreshing delivery info...');
        clearInterval(countdownInterval);
        renderDeliveryInfo();
      }
    }
    
    // Initial update
    updateCountdown();
    
    // Update every second
    const countdownInterval = setInterval(updateCountdown, 1000);
  }
  
  // Initialize on page load
  renderDeliveryInfo();
  
});

// Dynamic Add to Cart Button Toggle
document.addEventListener('DOMContentLoaded', function() {
  const atcWrapper = document.querySelector('.atc-wrapper');
  const atcButton = document.querySelector('.atc-initial-btn');
  const quantityControls = document.querySelector('.atc-quantity-controls');
  const quantityInput = document.querySelector('.js-main-product-quantity-input');
  const minusBtn = document.querySelector('.qty-btn-minus');
  const plusBtn = document.querySelector('.qty-btn-plus');
  const productForm = document.querySelector('.js-main-product-form');

  if (!atcWrapper || !atcButton || !quantityControls || !quantityInput) {
    console.warn('Add to cart elements not found');
    return;
  }

  // Check if product is already in cart on page load
  function checkProductInCart() {
    const variantId = document.querySelector('input[name="id"]').value;
    
    fetch('/cart.js')
      .then(response => response.json())
      .then(cart => {
        const cartItem = cart.items.find(item => item.variant_id == variantId);
        if (cartItem && cartItem.quantity > 0) {
          // Product is in cart, show quantity controls
          quantityInput.value = cartItem.quantity;
          atcWrapper.classList.add('show-quantity');
          quantityControls.classList.remove('d-none');
          quantityControls.classList.add('d-flex');
          // Update button states based on cart quantity
          updatePDPButtonStates(cartItem.quantity);
        }
      })
      .catch(error => console.error('Error checking cart:', error));
  }

  // Handle add to cart button click
  if (productForm) {
    productForm.addEventListener('submit', function(e) {
      e.preventDefault();
      
      const formData = new FormData(productForm);
      const submitButton = productForm.querySelector('.js-product-form-submit-btn');
      
      // Show loading state
      submitButton.classList.add('loading');
      
      fetch('/cart/add.js', {
        method: 'POST',
        body: formData
      })
      .then(response => response.json())
      .then(data => {
        // Successfully added to cart
        quantityInput.value = data.quantity || 1;
        atcWrapper.classList.add('show-quantity');
        quantityControls.classList.remove('d-none');
        quantityControls.classList.add('d-flex');
        
        // Update button states based on quantity
        updatePDPButtonStates(data.quantity || 1);
        
        // Update cart count if exists
        if (window.theme && window.theme.cart) {
          window.theme.cart.updateCartCount();
        }
        
        // Trigger cart drawer or notification
        document.dispatchEvent(new CustomEvent('cart:item-added', { detail: data }));
      })
      .catch(error => {
        console.error('Error adding to cart:', error);
        alert('Error adding product to cart. Please try again.');
      })
      .finally(() => {
        submitButton.classList.remove('loading');
      });
    });
  }

  // Debounce timer for quantity updates
  let quantityUpdateTimer = null;
  const DEBOUNCE_DELAY = 500; // Wait 500ms after last click before updating cart

  // Handle quantity changes with debounce
  function updateCartQuantity(newQuantity) {
    const variantId = document.querySelector('input[name="id"]').value;
    const viewCartBtn = document.querySelector('.view-cart-btn');
    
    // Clear any pending update
    if (quantityUpdateTimer) {
      clearTimeout(quantityUpdateTimer);
    }
    
    // Show loading spinner on View Cart button
    if (viewCartBtn) {
      viewCartBtn.classList.add('is-loading');
    }
    
    // Debounce the API call - wait for user to stop clicking
    quantityUpdateTimer = setTimeout(() => {
      if (newQuantity <= 0) {
        // Remove from cart
        fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: variantId,
            quantity: 0
          })
        })
        .then(response => response.json())
        .then(() => {
          // Hide quantity controls, show add to cart button
          atcWrapper.classList.remove('show-quantity');
          quantityControls.classList.remove('d-flex');
          quantityControls.classList.add('d-none');
          quantityInput.value = 1;
          
          // Update cart count
          if (window.theme && window.theme.cart) {
            window.theme.cart.updateCartCount();
          }
          
          document.dispatchEvent(new CustomEvent('cart:item-removed'));
        })
        .catch(error => console.error('Error removing from cart:', error))
        .finally(() => {
          // Remove loading spinner
          if (viewCartBtn) {
            viewCartBtn.classList.remove('is-loading');
          }
        });
      } else {
        // Update quantity
        fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: variantId,
            quantity: newQuantity
          })
        })
        .then(response => response.json())
        .then(() => {
          // Update cart count
          if (window.theme && window.theme.cart) {
            window.theme.cart.updateCartCount();
          }
          
          document.dispatchEvent(new CustomEvent('cart:item-updated', { detail: { quantity: newQuantity } }));
        })
        .catch(error => console.error('Error updating cart:', error))
        .finally(() => {
          // Remove loading spinner
          if (viewCartBtn) {
            viewCartBtn.classList.remove('is-loading');
          }
        });
      }
    }, DEBOUNCE_DELAY);
  }

  // Get max inventory from data attribute or input max
  function getMaxInventory() {
    const quantityControls = document.querySelector('.product__quantity-controls');
    if (quantityControls && quantityControls.dataset.inventoryQuantity) {
      return parseInt(quantityControls.dataset.inventoryQuantity, 10) || 9999;
    }
    if (quantityInput && quantityInput.max) {
      return parseInt(quantityInput.max, 10) || 9999;
    }
    return 9999;
  }

  // Update button states based on quantity and inventory
  function updatePDPButtonStates(quantity) {
    const maxInventory = getMaxInventory();
    
    if (plusBtn) {
      if (quantity >= maxInventory) {
        plusBtn.disabled = true;
        plusBtn.classList.add('disabled');
        plusBtn.style.opacity = '0.4';
        plusBtn.style.cursor = 'not-allowed';
      } else {
        plusBtn.disabled = false;
        plusBtn.classList.remove('disabled');
        plusBtn.style.opacity = '';
        plusBtn.style.cursor = '';
      }
    }
  }

  // Plus button click
  if (plusBtn) {
    plusBtn.addEventListener('click', function() {
      const currentQty = parseInt(quantityInput.value) || 0;
      const maxInventory = getMaxInventory();
      
      // Check if already at max inventory
      if (currentQty >= maxInventory) {
        updatePDPButtonStates(currentQty);
        return;
      }
      
      const newQty = currentQty + 1;
      quantityInput.value = newQty; // Instant UI update
      updatePDPButtonStates(newQty);
      updateCartQuantity(newQty);
    });
  }

  // Minus button click
  if (minusBtn) {
    minusBtn.addEventListener('click', function() {
      const currentQty = parseInt(quantityInput.value) || 0;
      const newQty = currentQty - 1;
      if (newQty > 0) {
        quantityInput.value = newQty; // Instant UI update
      }
      updatePDPButtonStates(newQty);
      updateCartQuantity(newQty);
    });
  }

  // Update button states on page load
  updatePDPButtonStates(parseInt(quantityInput?.value) || 1);

  // Check cart on page load
  checkProductInCart();
});

</script>

