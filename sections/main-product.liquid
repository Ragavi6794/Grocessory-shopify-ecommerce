                              </svg>
                              <p>View Cart</p>                             
                            </a>
                            
                            <div class="product__quantity-controls d-flex middle-xs" data-inventory-quantity="{{ product.selected_or_first_available_variant.inventory_quantity | default: 9999 }}" data-variant-id="{{ product.selected_or_first_available_variant.id }}">
                              <button class="no-js-hidden js-quantity-btn js-quantity-btn-minus qty-btn-minus btn btn-icon btn-large" aria-label="{{ 'accessibility.minus' | t }}" name="minus" data-name="minus" type="button">
                                {%- render 'icon-minus', size: 20 -%}
                              </button>
                              <input
                                class="js-quantity-input js-main-product-quantity-input qty-element input-number b-zero ta-center"
                                type="number"
                                name="quantity"
                                aria-label="{{ 'products.product.quantity.input_label' | t: product: product.title | escape }}"
                                id="productQuantityInput-{{ section.id }}"
                                min="0"
                                max="{{ product.selected_or_first_available_variant.inventory_quantity | default: 9999 }}"
                                value="1"
                                form="{{ product_form_id }}"
                                readonly
                              >
                              <button class="no-js-hidden js-quantity-btn js-quantity-btn-plus qty-btn-plus btn btn-icon btn-large" aria-label="{{ 'accessibility.plus' | t }}" name="plus" data-name="plus" type="button">
                                {%- render 'icon-plus', size: 20 -%}
                              </button>
                            </div>
                          </div>
                        </div>

                        <!-- Swym button on product pages -->
                        <div class="swym-wishlist-button-bar whishlist-product-btn"></div>
                        <!-- Swym button on product pages -->
                          {% if block.settings.show_dynamic_checkout_buttons %}
                            <sht-load-dyn-co-btn>
                              <template>{{ form | payment_button }}</template>
                            </sht-load-dyn-co-btn>
                          {% endif %}
                        </div>
                      {%- endform -%}
                    </sht-prd-frm>
                  </div>
                </div>
              </div>
            {%- when 'highlights' -%}
              {% liquid
                assign color_icon = block.settings.color_text_icon
                unless block.settings.color_text_icon and block.settings.color_text_icon.alpha != 0.0
                  assign color_icon = 'var(--color-normal-text)'
                endunless
              %}
              <div class="product__info ord-{{ forloop.index }} product__extra-info product__extra-info--{{ block.settings.display_style }} mb-32" {{ block.shopify_attributes }}>
                {% capture custom_icon_first %}
                  {%- liquid
                    assign icon_svg = ''
                    assign icon_source = block.settings.icon_source_1
                    if icon_source == 'theme_library'
                      render 'icon-loader', icon: block.settings.primary_options_icon, size: 36, class: 'color-icon'
                    elsif icon_source == 'custom_img'
                      assign custom_icon = 'image' | placeholder_svg_tag: 'placeholder media of-cover'
                      assign custom_icon = block.settings.custom_img_1 | image_url: width: block.settings.custom_img_1.width | image_tag: widths: '120', sizes: '(min-width: 361px) calc(100vw/2), calc(100vw/3)', alt: block.settings.primary_heading, class: 'media of-cover h-100 w-100'
                      render 'image', image_item: custom_icon, image_wrap_classes: "icon-custom--large color-icon d-block", image_classes: "h-100 w-100"
                    else
                      assign icon_svg = block.settings.html_code_1
                    endif
                    -%}
                    {%- if icon_svg != '' -%}
                      <div class="icon-custom--large color-icon h-100 w-100">{{- icon_svg -}}</div>
                    {%- endif -%}
                {% endcapture %}
                {% capture custom_icon_second %}
                  {%- liquid
                    assign icon_svg = ''
                    assign icon_source = block.settings.icon_source_2
                    if icon_source == 'theme_library'
                      render 'icon-loader', icon: block.settings.secondary_options_icon, size: 36, class: 'color-icon'
                    elsif icon_source == 'custom_img'
                      assign custom_icon = 'image' | placeholder_svg_tag: 'placeholder media of-cover'
                      assign custom_icon = block.settings.custom_img_2 | image_url: width: block.settings.custom_img_2.width | image_tag: widths: '120', sizes: '(min-width: 361px) calc(100vw/2), calc(100vw/3)', alt: block.settings.secondary_heading, class: 'media of-cover h-100 w-100'
                      render 'image', image_item: custom_icon, image_wrap_classes: "icon-custom--large color-icon d-block", image_classes: "h-100 w-100"
                    else
                      assign icon_svg = block.settings.html_code_2
                    endif
                    -%}
                    {%- if icon_svg != '' -%}
                      <div class="icon-custom--large color-icon h-100 w-100">{{- icon_svg -}}</div>
                    {%- endif -%}
                {% endcapture %}
                {% capture custom_icon_third %}
                {%- liquid
                  assign icon_svg = ''
                  assign icon_source = block.settings.icon_source_3
                  if icon_source == 'theme_library'
                    render 'icon-loader', icon: block.settings.tertiary_options_icon, size: 36, class: 'color-icon'
                  elsif icon_source == 'custom_img'
                    assign custom_icon = 'image' | placeholder_svg_tag: 'placeholder media of-cover'
                    assign custom_icon = block.settings.custom_img_3 | image_url: width: block.settings.custom_img_3.width | image_tag: widths: '120', sizes: '(min-width: 361px) calc(100vw/2), calc(100vw/3)', alt: block.settings.tertiary_heading, class: 'media of-cover h-100 w-100'
                    render 'image', image_item: custom_icon, image_wrap_classes: "icon-custom--large color-icon d-block", image_classes: "h-100 w-100"
                  else
                    assign icon_svg = block.settings.html_code_3
                  endif
                  -%}
                  {%- if icon_svg != '' -%}
                    <div class="icon-custom--large color-icon h-100 w-100">{{- icon_svg -}}</div>
                  {%- endif -%}
                {% endcapture %}
                {% capture custom_icon_fourth %}
                {%- liquid
                  assign icon_svg = ''
                  assign icon_source = block.settings.icon_source_4
                  if icon_source == 'theme_library'
                    render 'icon-loader', icon: block.settings.quaternary_options_icon, size: 36, class: 'color-icon'
                  elsif icon_source == 'custom_img'
                    assign custom_icon = 'image' | placeholder_svg_tag: 'placeholder media of-cover'
                    assign custom_icon = block.settings.custom_img_4 | image_url: width: block.settings.custom_img_4.width | image_tag: widths: '120', sizes: '(min-width: 361px) calc(100vw/2), calc(100vw/3)', alt: block.settings.quaternary_heading, class: 'media of-cover h-100 w-100'
                    render 'image', image_item: custom_icon, image_wrap_classes: "icon-custom--large color-icon d-block", image_classes: "h-100 w-100"
                  else
                    assign icon_svg = block.settings.html_code_4
                  endif
                  -%}
                  {%- if icon_svg != '' -%}
                    <div class="icon-custom--large color-icon h-100 w-100">{{- icon_svg -}}</div>
                  {%- endif -%}
                {% endcapture %}
              {% if block.settings.display_style == 'collapsibles' %}
                  {% capture accordion_icons %}
                    <span class="zi-1 btn btn-small btn-icon">{% render 'icon-chevron-down', size: '24' class: 'icon-chevron-down p-absolute' %}</span>
                  {% endcapture %}
                  <sht-accordion data-properties='{"multiple": true}' style="--color-highlight-icon: {{ color_icon }}">
                    {%- if block.settings.primary_heading != blank -%}
                      <div class="accordion__item js-accordion-item b-zero">
                        <div class="accordion__header">
                          <button class="btn-plain w-100 js-accordion-trigger d-flex middle-xs p-relative p-zero c-pointer" id="accordion-primary-title-{{- block.id -}}" aria-expanded="false" aria-controls="accordion-primary-content-{{- block.id -}}">
                            {{ custom_icon_first }}
                            <span class="card__heading m-zero flex-1 ml-8 ta-left fw-700">{{ block.settings.primary_heading | escape }}</span>
                            <span class="accordion__toggle zi-1 d-flex">{{ accordion_icons }}</span>
                          </button>
                        </div>
                        <div class="accordion__content js-accordion-content d-grid text-block rte pac-primary--{{ forloop.index }}-{{ block.id }}" id="accordion-primary-content-{{- block.id -}}" role="region" aria-describedby="accordion-primary-title-{{ block.id }}" tabindex="-1" style="max-height: 0;">
                          <span class="custom-icon h-100 w-100 d-block mr-8 mr-sm-12 mr-md-16"></span>
                          <div class="accordion-content">
                          {{- block.settings.primary_content -}}</div>
                          </div>
                      </div>
                    {% endif %}
                    {%- if block.settings.secondary_heading != blank -%}
                      <div class="accordion__item js-accordion-item b-zero">
                        <div class="accordion__header">
                          <button class="btn-plain w-100 js-accordion-trigger d-flex middle-xs p-relative p-zero c-pointer" id="accordion-secondary-title-{{- block.id -}}" aria-expanded="false" aria-controls="accordion-secondary-content-{{- block.id -}}">
                            {{ custom_icon_second }}
                            <span class="card__heading m-zero flex-1 ml-8 ta-left fw-700">{{ block.settings.secondary_heading | escape }}</span>
                            <span class="accordion__toggle zi-1 d-flex">{{ accordion_icons }}</span>
                          </button>
                        </div>
                        <div class="accordion__content js-accordion-content d-grid text-block rte pac-secondary--{{ forloop.index }}-{{- block.id -}}" id="accordion-secondary-content-{{- block.id -}}" role="region" aria-describedby="accordion-secondary-title-{{ block.id }}" tabindex="-1" style="max-height: 0;">
                          <span class="custom-icon h-100 w-100 d-block mr-8 mr-sm-12 mr-md-16"></span>
                          <div class="accordion-content">
                            {{- block.settings.secondary_content -}}
                          </div>
                        </div>
                      </div>
                    {% endif %}
                    {%- if block.settings.tertiary_heading != blank -%}
                      <div class="accordion__item js-accordion-item b-zero">
                        <div class="accordion__header">
                          <button class="btn-plain w-100 js-accordion-trigger d-flex middle-xs p-relative p-zero c-pointer" id="accordion-tertiary-title-{{- block.id -}}" aria-expanded="false" aria-controls="accordion-tertiary-content-{{- block.id -}}">
                            {{ custom_icon_third }}
                            <span class="card__heading m-zero flex-1 ml-8 ta-left fw-700">{{ block.settings.tertiary_heading | escape }}</span>
                            <span class="accordion__toggle zi-1 d-flex">{{ accordion_icons }}</span>
                          </button>
                        </div>
                        <div class="accordion__content js-accordion-content d-grid text-block rte pac-tertiary--{{ forloop.index }}-{{- block.id -}}" id="accordion-tertiary-content-{{- block.id -}}" role="region" aria-describedby="accordion-tertiary-title-{{ block.id }}" tabindex="-1" style="max-height: 0;">
                          <span class="custom-icon h-100 w-100 d-block mr-8 mr-sm-12 mr-md-16"></span>
                          <div class="accordion-content">
                            {{- block.settings.tertiary_content -}}
                          </div>
                        </div>
                      </div>
                    {% endif %}
                    {%- if block.settings.quaternary_heading != blank -%}
                      <div class="accordion__item js-accordion-item b-zero">
                        <div class="accordion__header">
                          <button role="button" class="btn-plain w-100 js-accordion-trigger d-flex middle-xs p-relative p-zero c-pointer" id="accordion-quaternary-title{{- block.id -}}" aria-expanded="false" aria-controls="accordion-quaternary-content-{{- block.id -}}">
                            {{ custom_icon_fourth }}
                            <span class="card__heading m-zero flex-1 ml-8 ta-left fw-700">{{ block.settings.quaternary_heading | escape }}</span>
                            <span class="accordion__toggle zi-1 d-flex">{{ accordion_icons }}</span>
                          </button>
                        </div>
                        <div class="accordion__content js-accordion-content d-grid text-block rte pac-quaternary--{{ forloop.index }}-{{- block.id -}}" id="accordion-quaternary-content-{{- block.id -}}" role="region" aria-describedby="accordion-quaternary-content-{{ block.id }}" tabindex="-1" style="max-height: 0;">
                          <span class="custom-icon h-100 w-100 d-block mr-8 mr-sm-12 mr-md-16"></span>
                          <div class="accordion-content">
                            {{- block.settings.quaternary_content -}}
                          </div>
                        </div>
                      </div>
                    {% endif %}
                  </sht-accordion>
                {% else %}
                  <div class="d-flex rw r-gap-24 fw-wrap" style="--color-highlight-icon: {{ color_icon }}">
                    <div class="clm" style="--w-xs: 12; --w-sm: 6;">
                      {%- if block.settings.primary_heading != blank -%}
                        <div class="info-card__heading mb-12 d-grid gap-16">
                          {{ custom_icon_first }}
                          <span class="card__heading m-zero fw-700">{{- block.settings.primary_heading | escape -}}</span>
                        </div>
                      {%- endif -%}
                      <div class="hide-empty text-block">{{- block.settings.primary_content -}}</div>
                    </div>
                    <div class="clm" style="--w-xs: 12; --w-sm: 6;">
                      {%- if block.settings.secondary_heading != blank -%}
                        <div class="info-card__heading mb-12 d-grid gap-16">
                          {{ custom_icon_second }}
                          <span class="card__heading m-zero fw-700">{{- block.settings.secondary_heading | escape -}}</span>
                        </div>
                      {%- endif -%}
                      <div class="hide-empty text-block">{{- block.settings.secondary_content -}}</div>
                    </div>
                    <div class="clm" style="--w-xs: 12; --w-sm: 6;">
                      {% if block.settings.tertiary_heading != blank %}
                        <div class="info-card__heading mb-12 d-grid gap-16">
                          {{ custom_icon_third }}
                          <span class="card__heading m-zero fw-700">{{- block.settings.tertiary_heading | escape -}}</span>
                        </div>
                      {% endif %}
                      <div class="hide-empty text-block">{{- block.settings.tertiary_content -}}</div>
                    </div>
                    <div class="clm" style="--w-xs: 12; --w-sm: 6;">
                      {% if block.settings.quaternary_heading != blank %}
                        <div class="info-card__heading mb-12 d-grid gap-16">
                          {{ custom_icon_fourth }}
                          <span class="card__heading m-zero fw-700">{{- block.settings.quaternary_heading | escape -}}</span>
                        </div>
                      {% endif %}
                      <div class="hide-empty text-block">{{- block.settings.quaternary_content -}}</div>
                    </div>
                  </div>
                {% endif %}
              </div>
            {%- when 'pickup_availability' -%}
              {%- assign pick_up_availabilities = product.selected_or_first_available_variant.store_availabilities | where: 'pick_up_enabled', true -%}
              {% if product.selected_or_first_available_variant.available and pick_up_availabilities.size > 0 %}
                <div class="product__info ord-{{ forloop.index }} card--card card--border corner-radius-s mb-32 {{ block.settings.show_expected_pickup_time | default: '' | replace: 'true', 'pickup_availability--show-pickup-time' }} color-{{- block.settings.color_scheme }}" {{ block.shopify_attributes }}>
                  <sht-pickup-avail
                    class="pickup-availability card__content  d-block no-js-hidden p-relative background"
                    {% if product.selected_or_first_available_variant.available and pick_up_availabilities.size > 0 %}
                      available
                    {% endif %}
                    data-base-url="{{ shop.url }}{{ routes.root_url }}"
                    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                    data-has-only-default-variant="{{ product.has_only_default_variant }}"
                    data-show-expected-pickup-time="{{ block.settings.show_expected_pickup_time }}">
                    <template>
                      <sht-pickup-avail-prwv class="d-flex top-xs pickup-availability__preview">
                        {% render 'icon-check-mark' %}
                        <div class="pickup-availability__info">
                          <p>{{ 'products.product.pickup_availability.unavailable' | t }}</p>
                          <button class="btn btn-small btn-plain">{{ 'products.product.pickup_availability.refresh' | t }}</button>
                        </div>
                      </sht-pickup-avail-prwv>
                    </template>
                  </sht-pickup-avail>
                </div>
              {% endif %}
            {%- when 'product_cross_sell' -%}
              <div class="product__info ord-{{ forloop.index }}" {{ block.shopify_attributes }}>
                <h2 class="d-block h5  mb-24 mb-md-40">{{ block.settings.heading }}</h2>
                <div class="cross-sell__items gap-unequal rw">
                  {%- for cross_sell in block.settings.product_list -%}
                    <div class="clm" style="--w-xs: 6;--w-sm: 6;--w-md: 6;">{% render 'card-product', product: cross_sell, show_vendor: true, show_color_swatch: false, show_sale_badge: true, show_sold_out_badge: true, enable_quick_view: false, enable_quick_buy: false, show_product_attributes: false, item_per_row: 2, ratio: product_card_media, enable_product_card_desc: settings.enable_product_card_desc, section: section %}</div>
                  {%- endfor -%}
                </div>
              </div>
            {%- when 'custom_text' -%}
              <div class="product__info ord-{{ forloop.index }} product__info--spacing wb-break-word hide-empty {{ block.settings.text_style | replace: 'color-light', 'color-light' | replace: 'body', 'color-text-regular' }}" {{ block.shopify_attributes }}>
                {{- block.settings.text -}}</div>
            {%- when 'custom_liquid' -%}
              <div class="product__info ord-{{ forloop.index }} wb-break-word hide-empty" {{ block.shopify_attributes }}>{{- block.settings.liquid_code -}}

              </div>
            {%- when 'popup_content' -%}
              {%- liquid
                assign popup_content_dialog_id = block.id | append: section.id | md5 | truncate: 12, ""
                assign popup_content_block = block
                assign size_popup_content_cta = 'disabled'
                if block.settings.static_page != blank
                  assign size_popup_content_cta = ''
                endif
              %}
              <div class="product__info product__block-{{- block.type }} mb-32" {{ block.shopify_attributes }}>
                <button class="btn-popup_content btn btn-link fs-body ta-left" type="button" aria-haspopup="dialog" onclick="window.dialogPopupContent{{ popup_content_dialog_id }}.showModal(this, true)" {{ size_popup_content_cta }}>{{- block.settings.text -}}</button>
              </div>
              {% render 'product-popup-content', popup_content_dialog_id: popup_content_dialog_id, popup_content_block: popup_content_block %}

            {%- when 'complementary_products' -%}
              <sht-prd-recom class="complementary-products product__info hide-empty mb-32" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ block.settings.products_to_show }}&intent=complementary">
                {% if recommendations.products_count > 0 %}
                  <h2 class="h5 hide-empty mb-24 d-block"> {{- block.settings.heading -}} </h2>
                  <div class="rw">
                    {% for recommendation in recommendations.products limit: block.settings.products_to_show %}
                      <div class="clm" style="--w-xs: 6">
                        {% render 'card-product',
                          product: recommendation,
                          ratio: settings.product_card_image_ratio,
                          show_second_image: settings.show_second_image,
                          show_vendor: settings.show_product_vendor,
                          show_color_swatch: settings.show_color_swatches,
                          show_sale_badge: settings.show_sale_badge,
                          show_sold_out_badge: settings.show_sold_out_badge,
                          item_per_row: section.settings.item_per_row,
                          enable_quick_view: settings.enable_quick_view,
                          enable_product_card_desc: settings.enable_product_card_desc,
                          section: section %}
                      </div>
                    {% endfor %}
                  </div>
                {% endif %}
              </sht-prd-recom>
            {%- when 'custom_badges' -%}
              <div class="product__info product__info--spacing mb-16 ord-{{ forloop.index }} hide-empty color-{{ settings.color_scheme_product_attributes }}" {{ block.shopify_attributes }}>
                {%- render 'product-attributes', product: product, namespace_keys: settings.product_attributes_metafield_namespace, badge_style: 'product-attr--single-line-text', att_style: 'mb-0' -%}
                </div>
            {%- when 'product_specifications' -%}
              <div class="product__info ord-{{ forloop.index }} hide-empty mb-32" {{ block.shopify_attributes }}>
                {% if block.settings.show_collapsible_content %}
                  <sht-accordion class="d-block">
                    <div class="specification-item js-accordion-item">
                      <button class="btn-plain w-100 mb-24 p-zero js-accordion-trigger d-flex middle-xs between-xs p-relative zi-1 c-pointer gap-12 gap-md-16" id="acdnTgr-{{ forloop.index }}-{{ block.id }}" aria-expanded="false" aria-controls="acdnCtt-{{ forloop.index }}-{{ block.id }}">
                        <h5 class="wb-break-word m-zero ta-left">
                          {% if block.settings.heading != blank %}
                            {{- block.settings.heading -}}
                          {% else %}{{- 'sections.main_product.specifications' | t -}}
                          {% endif %}
                        </h5>
                        <span class="zi-1 btn btn-large btn-icon">{% render 'icon-chevron-down', class: 'icon-chevron-down' %}</span>
                      </button>
                      <div class="js-accordion-content accordion-content o-hidden ac-{{ forloop.index }}-{{ block.id }}" id="acdnCtt-{{ forloop.index }}-{{ block.id }}" role="region" aria-describedby="acdnTgr-{{ forloop.index }}-{{ block.id }}" tabindex="-1" style="max-height: 0px;">
                        {%- render 'detailed-specifications-table' product: product, metafield_keys: block.settings.metafield_keys, name_style: 'h6 pb-12', value_style: 'pt-20', item_style: 'pb-20 mb-24' -%}
                      </div>
                    </div>
                  </sht-accordion>
                {% else %}
                  <h5 class="wb-break-word mb-24">
                    {% if block.settings.heading != blank %}
                      {{- block.settings.heading -}}
                    {% else %}{{- 'sections.main_product.specifications' | t -}}
                    {% endif %}
                  </h5>
                  {%- render 'detailed-specifications-table' product: product, metafield_keys: block.settings.metafield_keys, name_style: 'h6 pb-12', value_style: 'pt-20', item_style: 'pb-20 mb-24' -%}
                {% endif %}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- render 'section-id', section: section -%}
</div>
{%- liquid
  render 'main-product-gallery-dialog', product: product, place_holder: place_holder, rand: section_id, ratio: ratio_thubnails, object_fit: object_fit, media_background: media_background
-%}
{%- liquid
  render 'js-loader', files: "component-add-to-cart.js" | split: ', '
  render 'product-google-snippet', product: product
-%}

