{{ 'main-product.css' | asset_url | stylesheet_tag }}

{%- liquid
	assign variant_label = settings.variant_swatches_option | downcase
  assign place_holder = 'product-1' | placeholder_svg_tag: 'placeholder js-image-lazy w-100 h-100 p-absolute'
  assign section_id = section.id | md5 | truncate: 12, ""
  assign is_first_image = false
  assign product_form_id = 'productForm-' | append: section.id
  assign product_form_installment_id = 'productFormInstallment-' | append: section.id
  assign first_3d_model = product.media | where: 'media_type', 'model' | first
  assign popup_content_block = nil
  assign popup_content_dialog_id = ''
  assign enable_thumb_mobile = 'd-none d-flex-md'
  if section.settings.enable_thumb_mobile
    assign enable_thumb_mobile = 'd-flex top-xs'
  endif
  assign product_card_media = settings.product_card_image_ratio
  assign thumb_index = 0
  assign ratio_thubnails = section.settings.thumbnails_ratio
  assign object_fit = 'of-cover'
  if ratio_thubnails contains 'fit'
    assign ratio_thubnails = ratio_thubnails | replace: 'fit', ''
    assign object_fit = 'of-contain'
  endif
  assign media_background = section.settings.media_background
%}
{%- if first_3d_model -%}
  <script type="application/json" id="ProductJSON-{{ product.id }}">
    {{ product.media | where: 'media_type', 'model' | json }}
  </script>
{%- endif -%}
<div class="main-product section section-index--{{section.index |  replace: '1', 'first' }} {% render 'sections-spacing' %} color-{{ section.settings.color_scheme }}" id="{{ section.id }}" data-ui-component="Main Product Section">
  <div class="product-details ctnr background d-grid c-gap-md top-xs  gap-36 p-relative zi-5" style="--gtc-equal:1; --gtc-equal-md:2">
    <div class="product__media-wrapper w-100 o-hidden {% if section.settings.enable_sticky %} product__media--sticky {% endif %}" role="region" aria-label="{{- 'accessibility.view_gallery' | t -}}">
      <a class="visually-hidden skip-to-content btn btn-primary d-block ta-center" href="#productInfo-{{ section.id }}">{{ 'accessibility.skip_to_product_information' | t }}</a>
      <div class="product__media-wrapper--single-with-thumbnails ">
          <sht-prd-slideshow role="status" class="product-slideshow d-flex fd-column gap-24 d-grid-md p-relative" data-hide-variant-image="true" data-section="{{ section.id }}">
            <div class="product-slideshow__thumbnail zi-2 no-js-hidden {{ enable_thumb_mobile }}">
              <sht-vert-carousel class="carousel--vertical w-100" data-section="{{ section.id }}">
                <div class="product-slideshow__thumbs {{ enable_thumb_mobile }} h-100 top-xs js-carousel-items vertical-carousel vertical-carousel__container fd-column-md p-zero m-zero oy-auto p-relative disable-scrollbars fw-nowrap scrollable scrollable-y scrl-bhvr-auto" role="list" aria-label="{{ 'accessibility.slider' | t }}">
                  {%- liquid
                    if product.selected_or_first_available_variant.featured_media != null
                      assign thumb_index = thumb_index | plus: 1
                      assign featured_media = product.selected_or_first_available_variant.featured_media
                      render 'product-slideshow-thumb', section: section, media: featured_media, product: product, place_holder: place_holder, thumb_index: thumb_index, ratio: ratio_thubnails, object_fit: object_fit, media_background: media_background
                    endif
                    for media in product.media
                      assign thumb_index = thumb_index | plus: 1
                      unless media.id == product.selected_or_first_available_variant.featured_media.id
                        render 'product-slideshow-thumb', section: section, media: media, product: product, place_holder: place_holder, thumb_index: thumb_index, ratio: ratio_thubnails, object_fit: object_fit, media_background: media_background
                      endunless
                    endfor
                  -%}
                </div>
                <div class="product-slideshow__pagination carousel-pagination carousel-controls--outside maw-100 center-xs no-js-hidden js-carousel-pagination">
                  <div class="carousel-btn carousel-btn-prev p-absolute">
                    <button type="button" data-step="5" class="btn btn-secondary btn-small btn-icon icon btn-prev p-absolute js-carousel-prev-btn" disabled aria-label="{{ 'accessibility.previous_slide' | t }}" name="previous">{% render 'icon-arrow-left' %}</button>
                  </div>
                  <div class="carousel-btn carousel-btn-next p-absolute">
                  <button type="button" data-step="5" class="btn btn-secondary btn-small btn-icon icon btn-next p-absolute js-carousel-next-btn" disabled aria-label="{{ 'accessibility.next_slide' | t }}" name="next">{% render 'icon-arrow-right' %}</button>
                  </div>
                </div>
              </sht-vert-carousel>
            </div>
            <div class="product-rating-badge js-product-rating-badge" role="note"></div>
            <sht-share-prd-btn class="zi-2 p-relative" data-product-url="{{ product.selected_variant.url | default: product.url | prepend: request.origin }}">
                      <div class="js-web-share-api-container" hidden><button class="btn btn-large ls-none btn-icon icon btn btn-secondary js-web-share-api-btn" aria-label="{{ 'accessibility.social_share' | t }}">{% render 'icon-share' %}</button></div>
                      <sht-dtl-exposal>
                        <details class="js-none-web-share-api-container p-relative zi-2" id="productShareDetails-{{ block.id }}-{{ section.id }}">
                          <summary aria-controls="productShare-{{ block.id }}-{{ section.id }}" aria-expanded="false" class="btn btn-large ls-none btn-icon icon btn js-none-web-share-api-btn">{% render 'icon-share', pros: 'aria-hidden="true" focusable="false"' %}</summary>
                          <div id="productShare-{{ block.id }}-{{ section.id }}" class="p-absolute social-share-list mt-8">{% render 'product-social-share', product: product %}</div>
                        </details>
                      </sht-dtl-exposal>
            </sht-share-prd-btn>
            <div class="product-slideshow__slider w-100 p-relative o-hidden corner-radius-s">
              {% render 'product-gallery-carousel', product: product, section: section, place_holder: place_holder, rand: section_id, hide_variant_image: true, is_first_image: is_first_image, open_zoom_modal: section.settings.enable_media_zoom, ratio: section.settings.media_ratio, media_background: media_background %}
            </div>
          </sht-prd-slideshow>
        </div>
    </div>
    <div class="product__info-wrapper d-flex center-xs">
      <div id="productInfo-{{ section.id }}" class="main-product-info-container product__info-container d-flex fd-column wb-break-word" role="region" aria-label="{{- 'accessibility.view_product_info' | t -}}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div class="product__info ord-{{ forloop.index }}">
                {% liquid
                  render block
                %}
              </div>
            {%- when 'title' -%}
              <div class="product__info ord-{{ forloop.index }} product__info--spacing product__title mb-16" {{ block.shopify_attributes }}>
                <div  class="product__info-stock" >
                {% assign countryMeta = product.metafields.custom.odoo_country %}
                    {% if countryMeta != blank %}
                      <div class="color-light subtext mb-4 product-country-flag" data-country="{{ countryMeta }}">
                        {% if countryMeta == 'United Arab Emirates' %}
                          UAE
                        {% else %}
                          <span>{{- countryMeta -}}</span>
                        {% endif %}
                      </div>
                    {% endif %}

                  <div class="hide-empty fw-700" id="inventoryTracking-{{ section.id }}" role="status">
                    {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
                      {%- liquid
                        assign stock_status = 'product--instock color-success'
                        if settings.product_information_low_stock_threshold > 0 and settings.product_information_low_stock_threshold >= product.selected_or_first_available_variant.inventory_quantity
                          assign stock_status = 'product--lowstock color-warning'
                        endif
                      -%}
                      <span class="product-inventory-tracking icon-dot-shadow {{ stock_status }} p-relative">
                        {%- if settings.product_information_low_stock_threshold > 0 and block.settings.show_stock_number -%}
                          {{ 'products.product.in_stock_html' | t: stock: product.selected_or_first_available_variant.inventory_quantity }}
                        {%- else -%}
                          {{ 'products.product.in_stock' | t }}
                        {%- endif -%}
                      </span>
                    {%- else -%}
                      {%- if product.selected_or_first_available_variant.inventory_policy != 'continue' and product.selected_or_first_available_variant.inventory_management != blank -%}
                        <span class="product-inventory-tracking icon-dot-shadow product--outstock p-relative color-error">{{ 'products.product.out_of_stock' | t }}</span>
                      {% else %}
                        <span class="product-inventory-tracking icon-dot-shadow product--instock color-success p-relative">
                        {{ 'products.product.in_stock' | t }}
                        </span>
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                </div>
                <div class="d-flex middle-xs between-xs"> 
                  <h1 class="{{ block.settings.heading_size }} product-title-size m-zero mr-12 wb-break-word">{{ product.title | escape }}</h1>
                </div>
                {%- if product.metafields.custom.product_quantity -%}
                     <div class="product-quantity">
                         {{ product.metafields.custom.product_quantity}}
                      </div>
               {%- endif -%}
              </div>
            {%- when 'vendor' -%}
              <div class="product__info ord-{{ forloop.index }} product__info--spacing product__vendor mb-16" {{ block.shopify_attributes }}>
                <div class="color-light subtext wb-break-word">
                  <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
                  <span>{{ product.vendor }}</span>
                </div>
              </div>
            {%- when 'price' -%}
              <div class="product__info ord-{{ forloop.index }} product__info--spacing product__prices d-grid gap-12 mb-16" {{ block.shopify_attributes }}>
                <div class="d-flex fw-wrap gap-8" id="productPrice-{{ section.id }}" role="status">
                  {% render 'product-price', product: product, target: product.selected_or_first_available_variant, price_class: 'price--large', price_style: 'mr-8' %}
                  {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price and block.settings.show_sale_badge %}
                    {%- liquid
                      assign discount_cost = product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price
                      assign discount_percent = discount_cost | times: 100.0 | divided_by: product.selected_or_first_available_variant.compare_at_price | round: 2
                    -%}
                    <div class="product__badge">
                      <span class="badge badge--sale subtext d-inline-block p-relative fw-700 color-{{ settings.color_scheme_sale_badge }}">
                        <span class="p-relative zi-1 tt-up">
                          {{- 'products.product.on_sale' | t }}
                            {{ discount_percent }}%
                          <span class="d-none-important">
                          {% if settings.currency_code_enabled %}
                            {{- discount_cost | money_with_currency -}}
                          {% else %}
                            {{- discount_cost | money -}}
                          {% endif %}
                            ({{ discount_percent }}%)
                          </span>
                        </span>
                      </span>
                    </div>
                  {% endif %}
                </div>
                {%- if block.settings.show_tax_and_shipping_policy -%}
                  <div class="color-light hide-empty subtext text-block">
                    {%- if cart.taxes_included -%}
                      {{- 'products.product.include_taxes' | t -}}
                    {%- endif -%}
                    {%- if shop.shipping_policy.body != blank -%}
                      {{- 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url -}}
                    {%- endif -%}
                  </div>
                {% endif %}


              <div class="dubai-time-display" style="font-size: 12px; color: #666; margin-bottom: 8px; padding: 4px 8px; background: #f5f5f5; border-radius: 4px; display: inline-block;">
                 <strong>Dubai Time:</strong> <span id="dubai-current-time">Loading...</span>
              </div>

              <div class="delivery-info">
                <div class="delivery-logo">
                  <svg width="22" height="20" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M21.9556 9.7744C21.9263 9.70161 21.884 9.63764 21.8308 9.58249L18.357 6.05414C18.2484 5.94384 18.1008 5.88207 17.9477 5.88207H16.7894C16.4692 5.88207 16.2108 6.14568 16.2108 6.46994V11.1763C16.2108 12.1491 16.9903 12.941 17.9477 12.941H20.8429V14.7058C20.8429 15.03 20.5835 15.2936 20.2643 15.2936H4.05246C3.73332 15.2936 3.47386 15.03 3.47386 14.7058C3.47386 14.3804 3.21442 14.1179 2.89527 14.1179C2.57612 14.1179 2.31667 14.3815 2.31667 14.7058C2.31667 15.6786 3.09611 16.4705 4.05358 16.4705H4.9546C4.75486 16.818 4.63217 17.2161 4.63217 17.6474C4.63217 18.9456 5.67107 20 6.94768 20C8.22429 20 9.26319 18.9445 9.26319 17.6474C9.26319 17.2172 9.14052 16.818 8.94076 16.4705H15.9534C15.7537 16.818 15.631 17.2161 15.631 17.6474C15.631 18.9456 16.6699 20 17.9465 20C19.2242 20 20.262 18.9445 20.262 17.6474C20.262 17.2172 20.1393 16.818 19.9396 16.4705H20.262C21.2195 16.4705 21.9989 15.6786 21.9989 14.7058L22 9.99943C22 9.92332 21.985 9.8472 21.9556 9.7744ZM8.10486 17.6463C8.10486 18.2948 7.58595 18.8231 6.94655 18.8231C6.30823 18.8231 5.78824 18.2948 5.78824 17.6463C5.78824 16.9977 6.30714 16.4694 6.94655 16.4694C7.58595 16.4694 8.10486 16.9977 8.10486 17.6463ZM19.106 17.6463C19.106 18.2948 18.586 18.8231 17.9477 18.8231C17.3094 18.8231 16.7894 18.2948 16.7894 17.6463C16.7894 16.9977 17.3094 16.4694 17.9477 16.4694C18.586 16.4694 19.106 16.9977 19.106 17.6463ZM17.9477 11.7642C17.6286 11.7642 17.3691 11.5006 17.3691 11.1763V7.05783H17.7089L20.8428 10.242V11.763L17.9477 11.7642ZM2.31553 12.9411C1.9953 12.9411 1.73694 12.6774 1.73694 12.3532C1.73694 12.0278 1.99638 11.7653 2.31553 11.7653H13.3156C13.6347 11.7653 13.8942 11.5017 13.8942 11.1774V1.76361C13.8942 1.43935 13.6347 1.17574 13.3156 1.17574H0.578626C0.258396 1.17574 2.78283e-05 0.912133 2.78283e-05 0.58787C2.78283e-05 0.26361 0.259477 0 0.578626 0H13.3156C14.273 0 15.0525 0.791931 15.0525 1.76474V11.1763C15.0525 12.1491 14.273 12.9411 13.3156 12.9411H2.31553ZM1.15722 7.05783C0.836995 7.05783 0.578626 6.79423 0.578626 6.46996C0.578626 6.1457 0.838076 5.88209 1.15722 5.88209H2.89413C3.21436 5.88209 3.47273 6.1457 3.47273 6.46996C3.47273 6.79423 3.21328 7.05783 2.89413 7.05783H1.15722ZM1.73691 9.99944C1.41668 9.99944 1.15831 9.73584 1.15831 9.41157C1.15831 9.08731 1.41776 8.8237 1.73691 8.8237H2.89522C3.21545 8.8237 3.47381 9.08731 3.47381 9.41157C3.47381 9.73584 3.21437 9.99944 2.89413 9.99944H1.73691ZM0.578599 4.11735C0.258368 4.11735 0 3.85374 0 3.52948C0 3.20412 0.258366 2.94051 0.578599 2.94051H2.8941C3.21433 2.94051 3.4727 3.20412 3.4727 3.52838C3.4727 3.85264 3.21325 4.11625 2.8941 4.11625H0.578599V4.11735ZM10.8839 3.88242L9.84173 5.29421H11C11.2497 5.29421 11.4701 5.45635 11.5494 5.6968C11.6286 5.93725 11.5472 6.20087 11.3474 6.35306L6.71531 9.88254C6.61218 9.96085 6.48951 9.99945 6.36901 9.99945C6.21703 9.99945 6.06504 9.93879 5.95324 9.82077C5.75024 9.6079 5.73504 9.27481 5.91742 9.04429L7.48063 7.05897H6.36901C6.16058 7.05897 5.96844 6.94536 5.86531 6.76006C5.76218 6.57587 5.76543 6.34977 5.87291 6.16776L7.60982 3.22615C7.71294 3.04857 7.90184 2.94049 8.10482 2.94049H10.4203C10.6396 2.94049 10.8404 3.06622 10.9381 3.26585C11.0369 3.46549 11.0163 3.70374 10.8839 3.88242Z" fill="#5D1239"/>
                  </svg>
                </div>
                 <div class="delivery-text">
                  {% if product.tags contains 'Pre-Order-Item' %}
                       <strong>This is a Pre-Order item:</strong> Estimated delivery within 2 business days.
                  {% else %} 
                    <div class="delivery-message" id="delivery-message">Loading...</div>
                    <div class="delivery-countdown" id="delivery-countdown">00:00:00</div>
                  {% endif %}
                 </div>
               </div>


                
                {%- if shop.payment_terms -%}
                  {%- form 'product', product, id: product_form_installment_id, class: 'installment installment-form caption-large' -%}
                    <div class="form__field d-none-important">
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    </div>
                    {{ form | payment_terms }}
                  {%- endform -%}
                {%- endif -%}
              </div>
              <div class="wk_cashback_product" product_id="{{ product.id }}"></div>
              
            {%- when 'SKU' -%}
                <div class="product__info product__sku product__info--spacing gap-24 d-flex fd-column hide-empty mb-16" id="sku-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
                  {%- if product.selected_or_first_available_variant.sku != blank -%}
                    <span class="variant-sku color-light">SKU: {{ product.selected_or_first_available_variant.sku }}</span>
                  {%- endif -%}
                </div>
            {%- when 'description' -%}
            
              <div class="product__info ord-{{ forloop.index }} product__tabbed-content mb-32" {{ block.shopify_attributes }}>
                <div class="product-tabs">
                  <div class="product-tabs__header">
                    <button class="product-tabs__tab product-tabs__tab--active" data-tab="description">
                      {{ 'products.product.description' | t }}
                    </button>
                    <button class="product-tabs__tab" data-tab="reviews">
                      {% if localization.language.iso_code == "ar" %}
                        تقييمات العملاء 
                      {% else %}
                        Reviews
                      {% endif %}
                    </button>
                  </div>
                  
                  <div class="product-tabs__content">
                    <div class="product-tabs__panel product-tabs__panel--active" data-panel="description">
                      <div class="product__description wb-break-word {% if product.description == blank%}d-none{% endif %}">
                        {% if block.settings.enable_more_btn %}
                          <sht-read-more>
                            <div class="expandable-content p-relative o-hidden js-expandable-content " data-expanded="false">
                              <div class="rte">{{ product.description }}</div>
                            </div>
                            <div class="expandable-content__btn w-100 ta-left p-relative">
                              <button type="button" class="btn btn-link js-expandable-content-btn" data-view-more="Read more" data-view-less="Read less">Read more</button>
                            </div>
                          </sht-read-more>
                        {% else %}
                          <div class="rte">{{ product.description }}</div>
                        {% endif %}
                      </div>
                    </div>
                    
                    <div class="product-tabs__panel" data-panel="reviews">
                      <div id="reviews-container"></div>
                    </div>
                  </div>
                </div>
              </div>

            
              {% if section.settings.custom_product_banner != blank %}
                <a href="{{ section.settings.custom_product_banner_link }}" target="_blank">
                <img src="{{ section.settings.custom_product_banner | img_url: 'master' }}" alt="{{ product.title }}">
                </a>
              {% endif %}

            {% if product.metafields.custom.product_quantity != blank %}
              <input type="hidden" name="properties[weight]" value="{{ product.metafields.custom.product_quantity.value }}" form="{{ product_form_id }}">
            {% endif %}
        
            {%- when 'variants' -%}
              <div class="product__info ord-{{ forloop.index }} product__info--spacing product__variants gap-16 d-flex fd-column mb-32" {{ block.shopify_attributes }}>
                {%- unless product.has_only_default_variant -%}
                  {%- if block.settings.variant_picker_type == 'button' -%}
                    <div class="" id="variantPicker-{{ section.id }}">
                      <sht-variant-radios class="product__variants--radios d-flex fd-column gap-16 no-js-hidden" data-section="{{ section.id }}" data-url="{{ product.url }}">
                        {%- for option in product.options_with_values -%}
                          {% assign index = forloop.index | minus: 1 %}
                          <fieldset class="form__fields product-option js-variant-radio-container d-flex fw-wrap p-zero m-zero b-zero wb-break-word">
                            <legend class="p-zero m-zero product-option__name">
                              <span class="fw-700 mr-8">{{ option.name }}</span>
                              <span class="js-variant-radio-option-name hide-empty" ata-option-index="{{ index }}" data-option-name="{{ option.name }}">
                                {{ product.selected_or_first_available_variant.options[index] }}
                              </span>
                            </legend>
                            {%- assign variant_name = option.name | downcase -%}
                            {%- if variant_label contains variant_name -%}
                              {% render 'main-product-color-swatch', product: product, option: option, section: section, product_form_id: product_form_id, index: index %}
                            {%- else -%}
                              <ul class="ls-none d-flex fw-wrap gap-12">
                                {%- for value in option.values -%}
                                  <li class="form__field js-variant-option-value product-option__value {% if product.selected_or_first_available_variant.available == false and option.selected_value == value %}product-option--sold-out{% endif %}" data-value="{{ value | escape }}-{{ index }}" data-option-index="{{ index }}">
                                    <input type="radio" class="form__control input--variant js-variant-radio-item js-variant-item visually-hidden" id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" name="{{ option.name }}" value="{{ value | escape }}" data-variant-value="{{ value | escape }}-{{ index }}" form="{{ product_form_id }}" {% if option.selected_value == value %} checked {% endif %}>
                                    <label class="form__label product-option__label d-block js-variant-option-label" for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}">{{ value }}</label>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </fieldset>
                        {%- endfor -%}
                        <script type="application/json">{{ product.variants | json }}</script>
                      </sht-variant-radios>
                    </div>
                  {%- else -%}
                    {% render 'main-product-variant-selects', section: section, product: product, variant_label: variant_label, block: block, product_form_id: product_form_id, enable_size_guide: block.settings.enable_size_guide, size_guide_dialog_id: size_guide_dialog_id %}
                  {%- endif -%}
                  <noscript>
                    <div class="form__fields {% if product.has_only_default_variant %} hidden{% endif %}">
                      <div class="form__field">
                        <label class="form__label" for="Variants-{{ section.id }}-{{ forloop.index0 }}">{{ 'products.product.product_variants' | t }}</label>
                        <select name="id" id="Variants-{{ section.id }}-{{ forloop.index0 }}" class="form__control w-100 h-100 field__text field--focus field--hover" form="{{ product_form_id }}">
                          {%- for variant in product.variants -%}
                            <option {% if variant == product.selected_or_first_available_variant %} selected="selected" {% endif %} {% if variant.available == false %} disabled {% endif %} value="{{ variant.id }}">
                              {{ variant.title }}
                              {%- if variant.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}- {{ variant.price | money | strip_html }}
                            </option>
                          {%- endfor -%}
                        </select>
                      </div>
                    </div>
                  </noscript>
                {%- endunless -%}
              
              </div>
            {%- when 'purchasing' -%}
