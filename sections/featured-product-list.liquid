{%- liquid
  assign items_per_row_on_desktop = section.settings.items_per_row_on_desktop | plus: 0
  assign items_per_row_on_mobile = section.settings.items_per_row_on_mobile | plus: 0
  assign column_desktop = 12.0 | divided_by: section.settings.items_per_row_on_desktop
-%}
<div class="section section-index--{{section.index |  replace: '1', 'first' }} {% render 'sections-spacing' %} color-{{- section.settings.color_scheme }}" data-ui-component="Featured Product List Section" role="region" aria-labelledby="sectionHeading-{{ section.id | md5 | truncate: 12, "" }}">
  <div class="ctnr background" >
      {%- render 'section-header',
        content_align: section.settings.content_align,
        subheading: section.settings.subheading,
        heading: section.settings.heading,
        heading_size: section.settings.heading_size,
        description: section.settings.description,
        section: section
      -%}
      <div class="s-content">
        <sht-carousel class="sht-carousel p-relative d-block m-auto">
          <div aria-atomic="true" class="o-hidden d-flex fw-nowrap carousel ox-auto p-relative scrollable scrollable-x disable-scrollbars js-carousel-items js-animate">
            {%- for product in section.settings.product_list -%}
              {% liquid assign total_items = forloop.length | plus: 0 %}
              <sht-carousel-itm tabindex="0" class="carousel__item clm anm anm-fadeInUpLarge js-carousel-item p-relative scrollable-aln-start d-flex fd-column middle-xs fg-1 fs-0 p-zero" role="group" aria-roledescription="Slide" aria-label="{{ 'accessibility.slide' | t }} {{ forloop.index }} {{ 'accessibility.of' | t }} {{ forloop.length }}" style="--w-xs:12;--w-sm:6;--w-md:{{ column_desktop }}; --delay: {{ forloop.index | plus: 2 | times: 0.05 -}}s; --duration: .7s" data-item-index="{{ forloop.index }}">

                    {%- liquid
                      capture product_specifications
                        render 'product-specifications', product: product, show_full_specifications: false, metafield_keys: section.settings.metafield_keys, show_specification_label: section.settings.show_specification_label
                      endcapture
                    -%}
                    {% capture view_details %}
                      <div class="buttons-group d-inline-flex gap-12 fw-wrap hide-empty w-100">
                        <a href="{{- product.url | within: collection | default: '#' -}}" class="btn btn-secondary btn-large btn-view-details ta-left w-100" aria-label="{{ "products.product.view_details" | t }}">
                          {{ 'products.product.view_details' | t }}
                        </a>
                      </div>
                    {% endcapture %}

                    {%-
                      render 'card-product',
                      product: product,
                      show_vendor: section.settings.show_vendor,
                      show_color_swatch: section.settings.show_color_swatch,
                      show_sale_badge: section.settings.show_sale_badge,
                      show_sold_out_badge: section.settings.show_sold_out_badge,
                      enable_quick_view: section.settings.enable_quick_view,
                      enable_quick_buy: section.settings.enable_quick_buy,
                      enable_product_card_desc: false,
                      show_product_attributes: false,
                      show_second_image: section.settings.secondary_image,
                      enable_product_card_desc: settings.enable_product_card_desc,
                      ratio: section.settings.image_ratio,
                      image_width: '750, 950',
                      featured_product_list_view_details: view_details,
                      product_specifications: product_specifications,
                      is_featured_product_list: true,
                      color_scheme_featured_product_list: section.settings.card_color_scheme,
                      featured_products_card_media_background: section.settings.product_card_media_background
                      section: section,
                    -%}

              </sht-carousel-itm>
            {%- else -%}
              {%- for i in (1..items_per_row_on_desktop) -%}
                {%- liquid assign total_items = items_per_row_on_desktop -%}
                <sht-carousel-itm tabindex="0" role="group" aria-roledescription="Slide" aria-label="{{ 'accessibility.slide' | t }} {{ forloop.index }} {{ 'accessibility.of' | t }} {{ forloop.length }}" class="carousel__item clm anm anm-fadeInUpLarge js-carousel-item p-relative scrollable-aln-start d-flex fd-column middle-xs fg-1 fs-0 p-zero" style="--w-xs:12;--w-sm:6;--w-md:{{ column_desktop }}; --delay: {{ forloop.index | plus: 2 | times: 0.05 -}}s; --duration: .7s" data-item-index="{{ forloop.index }}">
                  {%- render 'card-product-placeholder',
                            ratio: settings.product_card_image_ratio,
                            show_vendor: settings.show_product_vendor
                            -%}
                </sht-carousel-itm>
              {%- endfor -%}
            {%- endfor -%}
          </div>

          <div class="carousel-pagination carousel-pagination--position d-none d-block-md zi-1 middle-y w-100 p-absolute no-js-hidden {{ section.settings.show_navigation | default: 'd-none d-block-md' | replace: 'true', '' }}">
            <div class="p-absolute middle-y left-0">
              <button type="button" data-step="{{ items_per_row_on_desktop }}" class="js-carousel-prev-btn btn btn-secondary btn-icon icon btn-large" aria-label="{{ 'accessibility.previous_slide' | t }}" name="previous" disabled>{% render 'icon-arrow-left' %}</button>
            </div>
            <div class="p-absolute middle-y right-0">
              <button type="button" data-step="{{ items_per_row_on_desktop }}" class="js-carousel-next-btn btn btn-secondary btn-icon icon btn-large" aria-label="{{ 'accessibility.next_slide' | t }}" name="next" disabled>{% render 'icon-arrow-right' %}</button>
            </div>
          </div>

          {% if section.settings.show_progress_indicator == true %}
            <div class="slider-scrollbar {% if items_per_row_on_desktop < total_items %} d-flex-md {% else %} d-none-md {% endif %} {% if items_per_row_on_mobile < total_items %} d-flex {% else %} d-none {% endif %}">
              <div class="scrollbar-track js-scrollbar-track" data-thumb-mobile="1" data-thumb-desk="{{ items_per_row_on_desktop }}" data-thumb-total="{{ total_items }}" style="--width-thumb-desktop: {{ items_per_row_on_desktop | times: 100.0 | divided_by: total_items }}%; --width-thumb-mobile: {{ 1 | times: 100.0 | divided_by: total_items }}%">
                <div class="scrollbar-thumb js-scrollbar-thumb"></div>
              </div>
            </div>
          {% endif %}

        </sht-carousel>
      </div>

  </div>
  {%- render 'section-id', section: section -%}
</div>
{% schema %}
{
  "name": "t:sections.featured_product_list.name",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.headers.header_general.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.settings.color_scheme.label",
      "default": "scheme-3"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "t:general.settings.products.label"
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.header_layout.content"
    },
    {
      "type": "select",
      "id": "items_per_row_on_desktop",
      "label": "t:general.settings.items_per_row_on_desktop.label",
      "default": "4",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_progress_indicator",
      "label": "t:general.settings.show_progress_indicator.label",
      "default": false
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "t:general.settings.content_alignment.label",
      "default": "ta-center",
      "options": [
        {
          "value": "ta-left",
          "label": "t:general.settings.option_left.label"
        },
        {
          "value": "ta-center",
          "label": "t:general.settings.option_center.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.header_text.content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:general.settings.subheading.label",
      "default": "Add a tagline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:general.settings.heading.label",
      "default": "Featured products"
    },
    {
      "type": "select",
      "label": "t:general.settings.heading_size.label",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:general.settings.heading_size.options.h2.label"
        },
        {
          "value": "h3",
          "label": "t:general.settings.heading_size.options.h3.label"
        },
        {
          "value": "h4",
          "label": "t:general.settings.heading_size.options.h4.label"
        },
        {
          "value": "h5",
          "label": "t:general.settings.heading_size.options.h5.label"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:general.settings.description.label"
    },
    {
    "type": "header",
    "content": "t:sections.featured_product_list.settings.headers.header_product_items.content"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "t:general.settings.card_color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:general.settings.image_ratio.label",
      "default": "2/3",
      "options": [
        {
          "value": "1/1",
          "label": "t:general.settings.image_ratio.options.option_square.label"
        },
        {
          "value": "2/3",
          "label": "t:general.settings.image_ratio.options.option_portrait_1.label"
        },
        {
          "value": "3/2",
          "label": "t:general.settings.image_ratio.options.option_landscape_2.label"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "secondary_image",
      "label": "t:general.settings.show_second_image_on_hover.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:general.settings.show_vendor.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_color_swatch",
      "label": "t:general.settings.show_variant_swatches.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "t:general.settings.show_sale_badge.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sold_out_badge",
      "label": "t:general.settings.show_sold_out_badge.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_quick_view",
      "label": "t:general.settings.enable_quick_view.label",
      "info": "t:general.settings.enable_quick_view.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_quick_buy",
      "label": "t:general.settings.enable_quick_buy.label",
      "info": "t:general.settings.enable_quick_buy.info",
      "default": true
    },
    {
      "type": "color",
      "id": "product_card_media_background",
      "label": "t:general.settings.media_background.label",
      "info": "t:general.settings.media_background.info"
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.header_product_specifications.content",
      "info": "t:general.settings.headers.header_product_specifications.info"
    },
    {
      "type": "text",
      "id": "metafield_keys",
      "label": "t:sections.featured_product_list.settings.metafield_keys.label",
      "info": "t:sections.featured_product_list.settings.metafield_keys.info"
    },
    {
      "type": "checkbox",
      "id": "show_specification_label",
      "label": "t:sections.featured_product_list.settings.show_specification_label.label",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_product_list.name"
    }
  ]
}
{% endschema %}