{% liquid
  assign content_position = section.settings.content_alignment
%}
<div class="section section-index--{{section.index |  replace: '1', 'first' }} {% render 'sections-spacing' %} color-{{- section.settings.color_scheme }}">
  <div class="ctnr background" data-ui-component="Text Section" role="region" aria-labelledby="sectionHeading-{{ section.id | md5 | truncate: 12, "" }}">
    <div class="s-header__content d-flex fd-column {{ content_position }} anm-card" style="--duration: .7s;">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'subheading' -%}
          {%- if block.settings.subheading != blank -%}
            <span class="s-header__subheading d-inline-block fw-700 hide-empty">{{- block.settings.subheading -}}</span>
          {%- endif -%}
        {%- when 'heading' -%}
          {%- if block.settings.heading != blank -%}
            <h2 class="s-header__heading {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
              {{- block.settings.heading -}}
            </h2>
          {%- endif -%}
        {%- when 'description' -%}
          {%- if block.settings.description != blank -%}
            <div class="s-header__description" {{ block.shopify_attributes }}>
              {{- block.settings.description -}}
            </div>
          {%- endif -%}
        {%- when 'countdown' -%}
          <div class="s-header__countdown countdown-wrapper d-grid w-100" {{ block.shopify_attributes }}>
              {%- render 'countdown', block: block, class: content_position  -%}
          </div>
        {%- when 'buttons' -%}
          <div class="s-header__buttons d-flex gap-8 fw-wrap {{ content_position }}" {{ block.shopify_attributes }}>
            {%- if block.settings.button_1_label != blank -%}
              <a class="btn btn-large {{ block.settings.button_1_style }}" href="{{- block.settings.button_1_link | default: '#' -}}">{{- block.settings.button_1_label -}}</a>
            {%- endif -%}
            {%- if block.settings.button_2_label != blank -%}
              <a class="btn btn-large {{ block.settings.button_2_style }}" href="{{- block.settings.button_2_link | default: '#' -}}">{{- block.settings.button_2_label -}}</a>
            {%- endif -%}
          </div>
        {%- endcase -%}
    {%- endfor -%}
    </div>

  </div>
  {%- render 'section-id', section: section -%}
</div>
{% schema %}
{
  "name": "t:sections.text.name",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.headers.header_general.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.settings.color_scheme.label",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.header_layout.content"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:general.settings.content_alignment.label",
      "default": "start-xs ta-start",
      "options": [
        {
          "value": "start-xs ta-start",
          "label": "t:general.settings.option_left.label"
        },
        {
          "value": "middle-xs ta-center",
          "label": "t:general.settings.option_center.label"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "subheading",
      "name": "t:general.settings.subheading.label",
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "label": "t:general.settings.text.label",
          "default": "Add a tagline"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:general.settings.heading.label",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:general.settings.text.label",
          "default": "Section heading"
        },
        {
          "type": "select",
          "label": "t:general.settings.text_size.label",
          "id": "heading_size",
          "options": [
            {
              "value": "headline",
              "label": "t:general.settings.heading_size.options.headline.label"
            },
            {
              "value": "h1",
              "label": "t:general.settings.heading_size.options.h1.label"
            },
            {
              "value": "h2",
              "label": "t:general.settings.heading_size.options.h2.label"
            },
            {
              "value": "h3",
              "label": "t:general.settings.heading_size.options.h3.label"
            }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "description",
      "name": "t:general.settings.description.label",
      "settings": [
        {
          "type": "richtext",
          "id": "description",
          "label": "t:general.settings.text.label",
          "default": "<p>Use this text to share brand information with your customers. Introduce a new product, share an announcement or welcome customers.</p>"
        }
      ]
    },
    {
      "type": "countdown",
      "name": "t:general.settings.countdown_timer.label",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:general.settings.headers.countdown_timer.content"
        },
        {
          "type": "checkbox",
          "id": "hide_on_end",
          "label": "t:general.settings.countdown_timer.hide_countdown.label",
          "default": true
        },
        {
          "type": "text",
          "id": "end_date",
          "label": "t:general.settings.countdown_timer.end_date.label",
          "info": "t:general.settings.countdown_timer.date_format.info"
        },
        {
          "type": "text",
          "id": "end_time",
          "label": "t:general.settings.countdown_timer.end_time.label",
          "info": "t:general.settings.countdown_timer.end_time_format.label"
        },
        {
          "type": "richtext",
          "id": "end_text",
          "label": "t:general.settings.countdown_timer.end_text.label",
          "info": "t:general.settings.countdown_timer.end_text.info.label",
          "default": "<p>This event is finished</p>"
        },
        {
          "type": "header",
          "content": "t:general.settings.custom_color.label"
        },
        {
          "type": "color",
          "id": "countdown_background_color",
          "label": "t:general.settings.countdown_timer.countdown_background.label"
        },
        {
          "type": "color",
          "id": "countdown_number_color",
          "label": "t:general.settings.countdown_timer.countdown_number.label"
        },
        {
          "type": "color",
          "id": "countdown_end_text_color",
          "label": "t:general.settings.countdown_timer.endtext.label",
          "default": "#FF0000"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "t:general.settings.headers.header_buttons.content",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "t:general.settings.button_1.label"
        },
        {
          "type": "text",
          "id": "button_1_label",
          "label": "t:general.settings.button.text.label",
          "default": "Check now",
          "info": "t:general.settings.button_label.info"
        },
        {
          "type": "select",
          "id": "button_1_style",
          "default": "btn-primary",
          "options": [
            {
              "value": "btn-primary",
              "label": "t:general.settings.primary.label"
            },
            {
              "value": "btn-secondary",
              "label": "t:general.settings.secondary.label"
            },
            {
              "value": "btn-link",
              "label": "t:general.settings.tertiary.label"
            }
          ],
          "label": "t:general.settings.button.style.label"
        },
        {
          "type": "url",
          "id": "button_1_link",
          "label": "t:general.settings.button.link.label"
        },
        {
          "type": "header",
          "content": "t:general.settings.button_2.label"
        },
        {
          "type": "text",
          "id": "button_2_label",
          "label": "t:general.settings.button.text.label",
          "default": "View details",
          "info": "t:general.settings.button_label.info"
        },
        {
          "type": "select",
          "id": "button_2_style",
          "default": "btn-secondary",
          "options": [
            {
              "value": "btn-primary",
              "label": "t:general.settings.primary.label"
            },
            {
              "value": "btn-secondary",
              "label": "t:general.settings.secondary.label"
            },
            {
              "value": "btn-link",
              "label": "t:general.settings.tertiary.label"
            }
          ],
          "label": "t:general.settings.button.style.label"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "t:general.settings.button.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.text.name",
      "blocks": [
        {
          "type": "subheading"
        },
        {
          "type": "heading"
        },
        {
          "type": "description"
        },
        {
          "type": "buttons"
        }
      ]
    }
  ]
}
{% endschema %}
<style>
  .s-header__description{
    max-width:100% !important;
  }
</style>
