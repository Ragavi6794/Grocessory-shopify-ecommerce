{%- liquid
  assign content_align = section.settings.content_align
  assign placeholder = 'image' | placeholder_svg_tag: 'placeholder of-cover br-50p w-100 h-100'
  assign product_featured_placeholder = 'product-1' | placeholder_svg_tag: 'placeholder w-100 h-100 media'
  assign items_per_row_on_desktop = section.settings.items_per_row_on_desktop | plus: 0
  assign column_desktop = 12.0 | divided_by: section.settings.items_per_row_on_desktop
 -%}
 <div class="section section-index--{{section.index |  replace: '1', 'first' }} {% render 'sections-spacing' %} color-{{- section.settings.color_scheme }}">
<div class="ctnr background" data-ui-component="Testimonials Section" role="region" aria-labelledby="sectionHeading-{{ section.id | md5 | truncate: 12, "" }}">
  <div class="m-auto {{ content_align }}" style="--w-xs:12;">
    {%- render 'section-header',
      content_align: content_align,
      subheading: section.settings.subheading,
      heading: section.settings.heading,
      heading_size: section.settings.heading_size,
      description: section.settings.description,
      section: section
    -%}
    <div class="s-content">
      <sht-carousel class="sht-carousel p-relative d-block m-auto" data-enable="{{ section.settings.enable_carousel }}">
        <div aria-atomic="true" class="o-hidden rw js-animate {{ section.settings.enable_carousel | default: '' | replace: 'true', 'fw-nowrap carousel ox-auto p-relative scrollable scrollable-x disable-scrollbars js-carousel-items m-zero' }} ">
          {%- for block in section.blocks -%}
            {%- liquid
              assign product = block.settings.product
              assign cover = placeholder
              assign cover = block.settings.avatar | image_url: width: block.settings.avatar.width | image_tag: widths: '120', sizes: 'calc(100vw/1)', alt: block.settings.name, class: 'media of-cover ttmnl-avatar br-50p'
              assign total_items = forloop.length | plus: 0
            -%}
            <sht-carousel-itm class="clm anm anm-fadeInUpLarge {{ section.settings.enable_carousel | default: '' | replace: 'true', 'carousel__item js-carousel-item p-relative scrollable-aln-start d-flex fd-column middle-xs fg-1 fs-0 p-zero' }}" style="--w-xs:12;--w-sm:6;--w-md: {{ column_desktop }}; --delay: {{ forloop.index | plus: 2 | times: 0.05 -}}s; --duration: .7s" role="group" aria-roledescription="Slide" aria-label="{{ 'accessibility.slide' | t }} {{ forloop.index }} {{ 'accessibility.of' | t }} {{ forloop.length }}" data-item-index="{{ forloop.index }}">
              <div class="corner-radius-s w-100 color-{{ section.settings.card_color_scheme }} background card--card card--border" {{ block.shopify_attributes }} >
                <div class="ttmnl-content card__content">
                  <div class="{{ section.settings.show_rating | default: 'd-none' | replace: 'true', '' }} mb-12 mb-md-16">
                    <span role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: block.settings.star, rating_max: 5 }}" class="stars" style="--rating: {{ block.settings.star }} ;--rating-max: 5;--rating-decimal: 0;--rating-color: {{ section.settings.color_rating }}"></span>
                  </div>
                  <p class="m-zero hide-empty mb-12 mb-md-16">{{- block.settings.text | escape -}}</p>
                  <div class="d-flex middle-xs {{ content_align }}">
                    {% render 'image', image_item: cover, image_wrap_classes: 'ttmnl-avatar', image_classes: 'h-100 w-100' %}
                    <div class="ttmnl-info ml-8 flex-1">
                      <p class="fw-700 hide-empty mb-4">{{- block.settings.name | escape -}}</p>
                      <p class="m-zero subtext hide-empty">{{- block.settings.job_title | escape -}}</p>
                    </div>
                  </div>
                </div>
                {%- if product != blank -%}
                  {%- liquid
                    assign product_featured_image = product_featured_placeholder
                    assign product_featured_image = product.featured_image | image_url: width: product.featured_image.image.width | image_tag: widths: '750, 950, 1024', sizes: "(min-width: 361px) calc(100vw/2), calc(100vw/3)", alt: product.title, class: 'media of-cover w-100 h-100'
                  -%}
                  <div class="ttmnl-product card__content ta-left {{ section.settings.show_bought_products | default: 'd-none-important' | replace: 'true', '' }}">
                    <span class="ttmnl-badge d-inline-block tt-up corner-radius-s fw-700 color-{{ settings.color_scheme_sale_badge }} mb-8 mb-md-12">
                      <span>{{ 'sections.testimonials.bought_product' | t }}</span>
                    </span>
                    <div class="d-flex gap-1x top-xs">
                      <div class="p-relative ttmnl-media">
                        <a aria-label="{{ product.title | escape }}" href="{{ product.url }}" class="p-absolute w-100 h-100 zi-1"></a>
                        {% render 'image', ratio: product.featured_image.aspect_ratio , image_item: product_featured_image, image_wrap_classes: 'h-100', image_classes: 'w-100 h-100 corner-radius-xs' %}
                      </div>
                      <div class="wb-break-word flex-1">
                        <h3 class="fs-body m-zero mb-md-4 card__heading"><a href="{{ product.url }}">{{ product.title }}</a></h3>
                        {% render 'product-price' product: product, target: product, regular_price: 'd-none-important' %}
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </sht-carousel-itm>
          {% endfor %}
        </div>

        <div class="carousel-pagination carousel-pagination--position w-100 p-absolute no-js-hidden d-none {{ section.settings.enable_carousel | replace: 'true', 'd-block-md' }}">
          <div class="p-absolute zi-1 left-0">
            <button type="button" data-step="{{ items_per_row_on_desktop }}" class="js-carousel-prev-btn btn btn-secondary btn-icon icon btn-large " aria-label="{{ 'accessibility.previous_slide' | t }}" name="previous" disabled>{% render 'icon-arrow-left' %}</button>
          </div>
          <div class="p-absolute zi-1 right-0">
            <button type="button" data-step="{{ items_per_row_on_desktop }}" class="js-carousel-next-btn btn btn-secondary btn-icon icon btn-large" aria-label="{{ 'accessibility.next_slide' | t }}" name="next" disabled>{% render 'icon-arrow-right' %}</button>
          </div>
        </div>

        {% if section.settings.show_progress_indicator == true and section.settings.enable_carousel == true %}
          <div class="slider-scrollbar {% if items_per_row_on_desktop < total_items %} d-flex-md {% else %} d-none-md {% endif %} {% if 1 < total_items %} d-flex {% else %} d-none {% endif %}">
            <div class="scrollbar-track js-scrollbar-track" data-thumb-mobile="1" data-thumb-desk="{{ items_per_row_on_desktop }}" data-thumb-total="{{ total_items }}" style="--width-thumb-desktop: {{ items_per_row_on_desktop | times: 100.0 | divided_by: total_items }}%; --width-thumb-mobile: {{ 1 | times: 100.0 | divided_by: total_items }}%">
              <div class="scrollbar-thumb js-scrollbar-thumb"></div>
            </div>
          </div>
        {% endif %}

      </sht-carousel>
    </div>
  </div>

</div>
{%- render 'section-id', section: section -%}
</div>
{% schema %}
{
  "name": "t:sections.testimonials.name",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.headers.header_general.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.settings.color_scheme.label",
      "default": "scheme-3"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:general.settings.section_subheading.label",
      "default": "Add a tagline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:general.settings.section_heading.label",
      "default": "Testimonials"
    },
    {
      "type": "select",
      "label": "t:general.settings.heading_size.label",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:general.settings.heading_size.options.h2.label"
        },
        {
          "value": "h3",
          "label": "t:general.settings.heading_size.options.h3.label"
        },
        {
          "value": "h4",
          "label": "t:general.settings.heading_size.options.h4.label"
        },
        {
          "value": "h5",
          "label": "t:general.settings.heading_size.options.h5.label"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:general.settings.description.label"
    },
    {
      "type": "checkbox",
      "id": "show_bought_products",
      "label": "t:sections.testimonials.settings.show_bought_products.label",
      "info": "t:sections.testimonials.settings.show_bought_products.info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.testimonial_items.content"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "t:general.settings.card_color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:sections.testimonials.settings.show_rating.label",
      "default": true
    },
    {
      "type": "color",
      "id": "color_rating",
      "label": "t:general.settings.rating.label",
      "default": "#F8CC46"
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.header_layout.content"
    },
    {
      "type": "select",
      "id": "items_per_row_on_desktop",
      "label": "t:general.settings.items_per_row_on_desktop.label",
      "default": "4",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "t:general.settings.content_alignment.label",
      "default": "ta-left",
      "options": [
        {
          "value": "ta-left",
          "label": "t:general.settings.option_left.label"
        },
        {
          "value": "ta-center",
          "label": "t:general.settings.option_center.label"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_carousel",
      "label": "t:general.settings.enable_carousel.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_progress_indicator",
      "label": "t:general.settings.show_progress_indicator.label",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:sections.testimonials.blocks.item.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "t:sections.testimonials.blocks.item.settings.avatar.label"
        },
        {
          "type": "range",
          "id": "star",
          "label": "t:general.settings.rating.label",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 4
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.testimonials.blocks.item.settings.name.label",
          "default": "Author's Name"
        },
        {
          "type": "text",
          "id": "job_title",
          "label": "t:sections.testimonials.blocks.item.settings.job_title.label",
          "default": "Happy customer"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.testimonials.blocks.item.settings.testimonial_content.label",
          "default": "Add customer reviews and testimonials to showcase your store's happy customers."
        },
        {
          "type": "header",
          "content": "t:sections.testimonials.blocks.item.settings.header_bought_product.content",
          "info": "t:sections.testimonials.blocks.item.settings.header_bought_product.info"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:general.settings.product.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.testimonials.name",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}