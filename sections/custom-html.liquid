<div class="section section-index--{{section.index |  replace: '1', 'first' }} {% render 'sections-spacing' %} color-{{- section.settings.color_scheme }}">
  <div class="ctnr color-{{ section.settings.color_scheme }} background" data-ui-component="Custom HTML Section" role="region" aria-labelledby="sectionHeading-{{ section.id | md5 | truncate: 12, "" }}">
    <div class="m-auto" style="--w-xs:12;">
      {% render 'section-header'
        content_align: section.settings.content_alignment,
        subheading: section.settings.subheading,
        heading: section.settings.heading,
        heading_size: section.settings.heading_size,
        section: section
      %}
    </div>
    <div class="s-content hide-empty m-auto" style="--w-xs:12;">{{- section.settings.html_code -}}</div>

  </div>
  {%- render 'section-id', section: section -%}
</div>
{% schema %}
{
  "name": "t:sections.custom_html.name",
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.headers.header_general.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.settings.color_scheme.label",
      "default": "scheme-3"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:general.settings.subheading.label",
      "default": "Add a tagline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:general.settings.heading.label",
      "default": "Custom HTML"
    },
    {
      "type": "select",
      "label": "t:general.settings.heading_size.label",
      "id": "heading_size",
      "options": [
        {
          "value": "headline",
          "label": "t:general.settings.heading_size.options.headline.label"
        },
        {
          "value": "h1",
          "label": "t:general.settings.heading_size.options.h1.label"
        },
        {
          "value": "h2",
          "label": "t:general.settings.heading_size.options.h2.label"
        },
        {
          "value": "h3",
          "label": "t:general.settings.heading_size.options.h3.label"
        }
      ],
      "default": "h2"
    },
    {
      "type": "html",
      "id": "html_code",
      "label": "t:sections.custom_html.settings.html_code.label"
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.header_layout.content"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:general.settings.content_alignment.label",
      "default": "ta-left",
      "options": [
        {
          "value": "ta-left",
          "label": "t:general.settings.option_left.label"
        },
        {
          "value": "ta-center",
          "label": "t:general.settings.option_center.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom_html.name"
    }
  ]
}
{% endschema %}